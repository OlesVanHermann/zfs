index 0000000000000000000000000000000000000000..aea395ae2cdb007b7b1891c733799be6ecff3d9f
--- /dev/null
+++ b/tests/qos-gates/host/run_g10.sh
@@ -0,0 +1,63 @@
+#!/bin/bash
+# SPDX-License-Identifier: CDDL-1.0
+#
+# run_g10.sh — gate G10 (compatibility) on one test VM: a pool carrying
+# qos:* properties goes from the fork to the unmodified OpenZFS and back,
+# then from the unmodified OpenZFS to the fork and back.
+#
+#   run_g10.sh <lnx|bsd> <fork-label> <upstream-label> <evidence-root> [pool]
+#
+# Both labels are trees built by build.sh on the VM. For each direction the
+# three phases of g10_compat.sh run with the module changed in between
+# (vm_module.sh: a reboot on FreeBSD). [pool] is the pool of the VM that
+# holds the files of the test pool (default: scratch).
+#
+# The VM is left on the fork module. On Linux the pools other than scratch
+# are not imported again (vm_module.sh): do it before using the bench.
+#
+# Exit 0 = the six phases passed.
+
+set -uo pipefail
+HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
+[ $# -eq 4 ] || [ $# -eq 5 ] ||
+    { echo "usage: $0 <lnx|bsd> <fork-label> <upstream-label> <evidence-root> [pool]" >&2; exit 2; }
+VM=$1; FORK=$2; UP=$3; EVROOT=$4; POOL=${5:-scratch}
+case "$VM" in lnx|bsd) ;; *) echo "first argument must be lnx or bsd" >&2; exit 2 ;; esac
+mono() { cut -d' ' -f1 /proc/uptime; }
+T0=$(mono)
+STAMP=$(date -u +%Y%m%dT%H%M%SZ)
+SUM=$EVROOT/g10-$VM-$FORK-$STAMP.txt
+mkdir -p "$EVROOT" || exit 2
+: > "$SUM"
+FAILED=0
+
+phase() { # phase <direction> <phase> <label of the module to load>
+	local out rc
+	if ! "$HERE/vm_module.sh" "$VM" "tree:$3" >> "$SUM" 2>&1; then
+		echo "$1 $2 module=$3 RESULT=NO_MODULE" | tee -a "$SUM"
+		FAILED=1
+		return 1
+	fi
+	out=$("$HERE/run_gate.sh" "$VM" "$3-$1" "$EVROOT" g10_compat.sh --phase "$2" --pool "$POOL" 2>&1)
+	rc=$?
+	echo "$1 $2 module=$3 rc=$rc $(echo "$out" | tail -1)" | tee -a "$SUM"
+	[ $rc -eq 0 ] || FAILED=1
+	return $rc
+}
+
+# direction <name> <module A> <module B>: stop a direction at its first
+# failed phase, the next phase would only report the same thing
+direction() {
+	phase "$1" create "$2" && phase "$1" other "$3" && phase "$1" back "$2"
+}
+direction fork-first "$FORK" "$UP"
+direction upstream-first "$UP" "$FORK"
+
+"$HERE/vm_module.sh" "$VM" "tree:$FORK" >> "$SUM" 2>&1 || { echo "the fork module could not be put back" | tee -a "$SUM"; FAILED=1; }
+echo "host_seconds=$(echo "$(mono) - $T0" | bc)" >> "$SUM"
+if [ $FAILED -eq 0 ]; then
+	echo "RESULT=PASS vm=$VM fork=$FORK upstream=$UP summary=$SUM" | tee -a "$SUM"
+	exit 0
+fi
+echo "RESULT=FAIL vm=$VM fork=$FORK upstream=$UP summary=$SUM" | tee -a "$SUM"
+exit 1
diff --git a/tests/qos-gates/host/run_g2.sh b/tests/qos-gates/host/run_g2.sh
new file mode 100755
index 0000000000000000000000000000000000000000..5f7870306962b7a04ca890c2e79c251bebd9a689
--- /dev/null
+++ b/tests/qos-gates/host/run_g2.sh
@@ -0,0 +1,182 @@
+#!/bin/bash
+# SPDX-License-Identifier: CDDL-1.0
+#
+# run_g2.sh — run gate G2 (g2_noqos.sh) on a test VM against whatever module
+# is loaded there, and bring the evidence back to the host.
+#
+#   run_g2.sh <lnx|bsd> <label> <evidence-root> [--ztest PATH] [--tmp]
+#             [-- extra g2_noqos.sh options]
+#
+#   <label>        names the module under test (e.g. stock, v2.2, fork-2.4.4)
+#   --ztest PATH   ztest binary on the VM (default: on FreeBSD the one in
+#                  PATH, on Linux the one of the tree upstream-<version>,
+#                  <version> being the Version: line of this tree's META)
+#   --tmp          exact reported shape: ztest in /tmp, import by cachefile
+#
+# Work area: a dataset created for this run on the VM's scratch pool, removed
+# when the run passes, kept when it fails. Evidence: <evidence-root>/
+# g2-<vm>-<label>-<UTC stamp>/ with a SHA256SUMS file.
+# A lost SSH session is reported as a failure of its own (panic or freeze).
+#
+# Void pass. On a machine without a hostid (the Linux test VM) the unmodified
+# ztest now and then stops when it opens its pool again: "pool 'ztest' system
+# hostid not set, aborted import during open", then an assertion in
+# ztest_run(). It happens in user land, with the unmodified module too, and
+# says nothing about the module under test. When that message is the only
+# failure of the run (one ztest pass ended on it, the kernel logged nothing,
+# the VM stayed up), the run is reported as RESULT=VOID, its work dataset is
+# removed, and the gate is played again by itself: three runs at most, each
+# with its own evidence directory. Any other stop of ztest stays a failure.
+# Exit 0 = PASS, 3 = three void runs, anything else = failure.
+
+set -uo pipefail
+QOS_ENV=${QOS_ENV:-/home/ubuntu/qos-tests/0-setup/qos_env.sh}
+# shellcheck disable=SC1090
+source "$QOS_ENV" >/dev/null 2>&1
+
+[ $# -ge 3 ] || { echo "usage: $0 <lnx|bsd> <label> <evidence-root> [--ztest PATH] [--tmp] [-- opts]" >&2; exit 2; }
+ARGS=("$@")
+VM=$1; LABEL=$2; EVROOT=$3; shift 3
+ZTEST=; TMPMODE=no; ARCMAX=; EXTRA=()
+while [ $# -gt 0 ]; do
+	case "$1" in
+	--ztest) ZTEST=$2; shift 2 ;;
+	--tmp) TMPMODE=yes; shift ;;
+	--arc-max) ARCMAX=$2; shift 2 ;;	# bytes: memory pressure on the ARC
+	--) shift; EXTRA=("$@"); break ;;
+	*) echo "unknown argument $1" >&2; exit 2 ;;
+	esac
+done
+
+case "$VM" in
+lnx) SSH=$LNX_SSH; BASE=/home/ubuntu/qos-build; VUSER=ubuntu ;;
+bsd) SSH=$BSD_SSH; BASE=/scratch/build; VUSER=freebsd ;;
+*) echo "first argument must be lnx or bsd" >&2; exit 2 ;;
+esac
+mono() { cut -d' ' -f1 /proc/uptime; }
+T0=$(mono)
+RUN=$LABEL-$(date -u +%Y%m%dT%H%M%SZ)
+EV=$EVROOT/g2-$VM-$RUN
+mkdir -p "$EV"
+
+# Linux: the ztest found in PATH on the test VM belongs to an older userland
+# (2.4.1, debug build) whose zdb stops on an assertion of its own now and
+# then: a run with it says nothing about the module. Without --ztest, take
+# the one of the unmodified tree built on the VM, the same for every module.
+# That tree is named after the OpenZFS version this tree is based on.
+if [ -z "$ZTEST" ] && [ "$VM" = lnx ]; then
+	UPVER=$(sed -n 's/^Version:[[:space:]]*//p' \
+	    "$(dirname "${BASH_SOURCE[0]}")/../../../META" 2>/dev/null | head -1)
+	[ -n "$UPVER" ] ||
+	    { echo "FAIL: no --ztest given and no Version: line in the tree's META" | tee "$EV/host.txt"; exit 1; }
+	ZTEST=$BASE/upstream-$UPVER/ztest
+	$SSH "test -x $ZTEST" ||
+	    { echo "FAIL: no --ztest given and $ZTEST is missing on $VM" | tee "$EV/host.txt"; exit 1; }
+fi
+
+# Scratch pool: on both VMs it lives on a dedicated virtual disk, never on a
+# file. The ztest pool is made of files: if the pool that holds them were
+# file-backed too, both would share the module's single "z_vdev_file" taskq
+# (16 threads) and deadlock as soon as 16 flushes of the inner pool wait on
+# one write of the outer pool (seen on 2026-11-17, unrelated to QoS).
+$SSH "sudo zpool list -H -o name scratch >/dev/null 2>&1 || sudo zpool import scratch" ||
+    { echo "FAIL: no scratch pool on $VM (create it on the dedicated disk)" | tee "$EV/host.txt"; exit 1; }
+$SSH "sudo zpool status scratch | grep -q -E '^[[:space:]]+/'" &&
+    { echo "FAIL: scratch pool on $VM is file-backed" | tee "$EV/host.txt"; exit 1; }
+DS=scratch/g2/$RUN
+$SSH "sudo zfs create -p $DS && sudo chown $VUSER /scratch/g2/$RUN" ||
+    { echo "FAIL: cannot create $DS" | tee "$EV/host.txt"; exit 1; }
+
+# A small ARC forces dbuf and dataset eviction, which is where a lifetime bug
+# shows. The kernel refuses a maximum below the minimum (silently on a quick
+# look: "Invalid argument"), so lower the minimum first and check the result.
+ARCNOTE="arc_max=default"
+if [ -n "$ARCMAX" ]; then
+	if [ "$VM" = bsd ]; then
+		$SSH "sudo sysctl vfs.zfs.arc.min=67108864 vfs.zfs.arc.max=$ARCMAX >/dev/null 2>&1"
+		GOTARC=$($SSH "sysctl -n kstat.zfs.misc.arcstats.c_max")
+	else
+		$SSH "echo 67108864 | sudo tee /sys/module/zfs/parameters/zfs_arc_min >/dev/null;
+		    echo $ARCMAX | sudo tee /sys/module/zfs/parameters/zfs_arc_max >/dev/null"
+		GOTARC=$($SSH "awk '\$1 == \"c_max\" {print \$3}' /proc/spl/kstat/zfs/arcstats")
+	fi
+	[ "$GOTARC" = "$ARCMAX" ] ||
+	    { echo "FAIL: ARC limit not applied on $VM (c_max=$GOTARC, wanted $ARCMAX)" | tee "$EV/host.txt"; exit 1; }
+	ARCNOTE="arc_max=$GOTARC"
+fi
+
+if [ "$TMPMODE" = yes ]; then
+	DIRARGS="--dir /tmp --import-by cachefile"
+	# Vdev files of an earlier pass still carry pool labels: a fallback scan
+	# of /tmp would then see two pools named ztest. Empty them (ztest's own
+	# scratch files only) unless the run is about leftovers.
+	if [ "${QG_KEEP_LEFTOVERS:-no}" != yes ]; then
+		$SSH "find /tmp -maxdepth 1 -type f \( -name 'ztest.*' -o -name 'ztest_upgrade.*' -o -name zpool.cache \) -exec truncate -s 0 {} +"
+	fi
+else
+	DIRARGS="--dir /scratch/g2/$RUN"
+fi
+ZARG=
+[ -n "$ZTEST" ] && ZARG="--ztest $ZTEST"
+
+timeout -k 15 "${QG_HOST_TIMEOUT:-3600}" $SSH "sh $BASE/qos-gates/g2_noqos.sh $DIRARGS --out /scratch/g2/$RUN/out --label $LABEL $ZARG ${EXTRA[*]:-}" \
+    > "$EV/g2.stdout" 2>&1
+RC=$?
+{
+	echo "vm=$VM label=$LABEL run=$RUN tmp_mode=$TMPMODE ztest=${ZTEST:-<PATH default>} $ARCNOTE"
+	echo "ssh_rc=$RC"
+} > "$EV/host.txt"
+
+if [ $RC -eq 255 ] || [ $RC -eq 124 ] || [ $RC -eq 137 ]; then
+	# The VM dropped the session: panic, reboot or freeze. Wait for it once.
+	echo "vm_lost=yes" >> "$EV/host.txt"
+	ssh -i "$SSH_KEY" $SSH_OPTS -o ConnectTimeout=5 -o ConnectionAttempts=120 \
+	    "$VUSER@$( [ "$VM" = lnx ] && echo "$LNX_VM_IP" || echo "$BSD_VM_IP")" true 2>/dev/null &&
+	    echo "vm_back=yes" >> "$EV/host.txt" || echo "vm_back=no" >> "$EV/host.txt"
+	if [ "$VM" = bsd ]; then
+		$SSH "ls -t /var/crash/core.txt.* 2>/dev/null | head -1" > "$EV/latest-core.name" 2>/dev/null
+		C=$(cat "$EV/latest-core.name" 2>/dev/null)
+		[ -n "$C" ] && $SSH "sudo head -c 400000 $C" > "$EV/$(basename "$C")" 2>/dev/null
+		$SSH "grep -B40 -m1 -e '---<<BOOT>>---' /var/log/messages | tail -60" > "$EV/messages-before-boot.txt" 2>/dev/null
+	fi
+fi
+
+# Bring back what the gate wrote (may be partial after a crash).
+$SSH "cd /scratch/g2/$RUN && tar -cf - out 2>/dev/null" | tar -xf - -C "$EV" 2>/dev/null
+sums() { ( cd "$EV" && find . -type f ! -name SHA256SUMS | sort | xargs sha256sum > SHA256SUMS ); }
+
+RESULT=$(grep -h '^RESULT=' "$EV/out/RESULT" 2>/dev/null | tail -1)
+[ -n "$RESULT" ] || RESULT="RESULT=FAIL (no verdict: ssh_rc=$RC)"
+
+# Void pass (see the header): exactly one failure, it is a ztest pass, that
+# pass printed the hostid message, the kernel log is clean, the VM answered.
+VOIDPASS=
+if [ "$RESULT" = "RESULT=FAIL (1)" ] && [ $RC -ne 255 ] && [ $RC -ne 124 ] && [ $RC -ne 137 ] &&
+    grep -q 'dmesg_bad=0' "$EV/out/RESULT" 2>/dev/null; then
+	P=
+	grep -q '^ztest_p1_rc=[1-9]' "$EV/out/RESULT" 2>/dev/null && P=1
+	[ -z "$P" ] && grep -q '^ztest_p2_rc=[1-9]' "$EV/out/RESULT" 2>/dev/null && P=2
+	[ -n "$P" ] && grep -q 'system hostid not set' "$EV/out/ztest-p$P.out" 2>/dev/null && VOIDPASS=$P
+fi
+if [ -n "$VOIDPASS" ]; then
+	ATT=${QG_G2_ATTEMPT:-1}
+	echo "void=ztest pass $VOIDPASS stopped on 'system hostid not set', attempt $ATT of 3" >> "$EV/host.txt"
+	$SSH "sudo zfs destroy -r $DS" && echo "work_dataset=destroyed (void run)" >> "$EV/host.txt"
+	echo "host_seconds=$(echo "$(mono) - $T0" | bc)" >> "$EV/host.txt"
+	sums
+	echo "RESULT=VOID (ztest pass $VOIDPASS stopped on 'system hostid not set', attempt $ATT of 3) vm=$VM label=$LABEL evidence=$EV host_seconds=$(tail -1 "$EV/host.txt" | cut -d= -f2)"
+	if [ "$ATT" -lt 3 ]; then
+		QG_G2_ATTEMPT=$((ATT + 1)) exec "$0" "${ARGS[@]}"
+	fi
+	exit 3
+fi
+
+if [ "$RESULT" = "RESULT=PASS" ] && [ $RC -eq 0 ]; then
+	$SSH "sudo zfs destroy -r $DS" && echo "work_dataset=destroyed" >> "$EV/host.txt"
+else
+	echo "work_dataset=kept:$DS" >> "$EV/host.txt"
+fi
+echo "host_seconds=$(echo "$(mono) - $T0" | bc)" >> "$EV/host.txt"
+sums
+echo "$RESULT vm=$VM label=$LABEL evidence=$EV $(grep -h -E '^(module_loaded|ztest_p1_rc|cycles_ok|ztest_p2_rc|dmesg_new)' "$EV/out/RESULT" 2>/dev/null | tr '\n' ' ') host_seconds=$(grep -h '^host_seconds=' "$EV/host.txt" | tail -1 | cut -d= -f2)"
+[ "$RESULT" = "RESULT=PASS" ] && [ $RC -eq 0 ]
diff --git a/tests/qos-gates/host/run_g4.sh b/tests/qos-gates/host/run_g4.sh
new file mode 100755
index 0000000000000000000000000000000000000000..a68bba8d2aee066f08cdb90211a801ce56058257
--- /dev/null
+++ b/tests/qos-gates/host/run_g4.sh
@@ -0,0 +1,216 @@
+#!/bin/bash
+# SPDX-License-Identifier: CDDL-1.0
+#
+# run_g4.sh — gate G4: the five-protocol campaign (local, NFS, CIFS, iSCSI,
+# NVMe-oF, on Linux and on FreeBSD) against the modules that are in service
+# on the two VMs.
+#
+#   run_g4.sh <label> <evidence-root> [--known KEY:N[,KEY:N]]
+#       [--min-combinations 8] [--reboot] [--skip-setup] [--s1s2s3]
+#   run_g4.sh <label> <evidence-root> --rejudge <evidence of a past run>
+#       [--known ...] [--min-combinations 8]
+#
+# The campaign itself is the fixture's chain (qos-tests/0-setup/chain_full.sh:
+# setup, consistency check, then scenario S1 on the ten combinations; the
+# options are passed to it as they are). This script only frames it: it
+# records which module each VM runs before and after, keeps the chain's logs
+# with checksums, and takes the verdict from the chain's final table.
+# <label> names the evidence; it does not select a module — put the module in
+# service first with host/vm_module.sh (after a reboot each VM loads the
+# module that was installed last).
+#
+# --known KEY:N tolerates up to N failures in one combination, named as the
+# chain names it. It does not say why a check fails: read the log of the step
+# before using it. Its one use so far was NVMe-LNX-s1_v2:2, after the
+# limitation documented for the published v2.2 (direct writes over NVMe-oF on
+# Linux at the two smallest limits). Measured on 2026-11-18, that limitation
+# was the fixture, not the module: a leftover file filled the two test
+# filesystems, fio stopped on "No space left on device" and the scenario
+# reported a rate that meant nothing. With the filesystems emptied the two
+# checks pass. Do not pass that key any more.
+#
+# PASS = the chain ended with status 0, at least --min-combinations network
+# combinations gave a result, none has more failures than what is known, and
+# no asserted check had a fio error.
+# INVALID (exit 3) = fio reported an error during an asserted check of at
+# least one combination ("fio_write ERROR", "fio_read ERROR" in the log of the
+# step): the rate the scenario computed there means nothing, whether the check
+# was counted as passed or failed. The combination has to be run again
+# (host/run_g4_step.sh). An error on a check that only informs — in S1 the
+# buffered write (d) and the parallel one (e) — voids nothing; all of them are
+# listed in fio-errors.txt.
+# The local combinations are not counted by the chain: gate G3 judges them.
+# About 4 h 25 for S1 alone (15 857 s on 2026-11-18).
+#
+# --rejudge takes the verdict again from the evidence of a past run, with the
+# rules above, without running anything and without touching the VMs or that
+# evidence: the result goes to a new directory.
+
+set -uo pipefail
+QOS_ENV=${QOS_ENV:-/home/ubuntu/qos-tests/0-setup/qos_env.sh}
+QOS_TESTS=${QOS_TESTS:-/home/ubuntu/qos-tests}
+# shellcheck disable=SC1090
+source "$QOS_ENV" >/dev/null 2>&1
+
+[ $# -ge 2 ] || { echo "usage: $0 <label> <evidence-root> [chain options]" >&2; exit 2; }
+LABEL=$1; EVROOT=$2; shift 2
+KNOWN=; MINCOMB=8; REJUDGE=; CHAINOPTS=()
+while [ $# -gt 0 ]; do
+	case "$1" in
+	--known) KNOWN=$2; shift 2 ;;
+	--min-combinations) MINCOMB=$2; shift 2 ;;
+	--rejudge) REJUDGE=${2%/}; shift 2 ;;
+	*) CHAINOPTS+=("$1"); shift ;;
+	esac
+done
+STAMP=$(date -u +%Y%m%dT%H%M%SZ)
+if [ -n "$REJUDGE" ]; then
+	[ -f "$REJUDGE/chain.stdout" ] || { echo "no chain.stdout in $REJUDGE" >&2; exit 2; }
+	[ ${#CHAINOPTS[@]} -eq 0 ] || { echo "--rejudge runs nothing: ${CHAINOPTS[*]} not expected" >&2; exit 2; }
+	EV=$EVROOT/g4_rejudge-$LABEL-$STAMP
+else
+	EV=$EVROOT/g4_chain-both-$LABEL-$STAMP
+fi
+mkdir -p "$EV" || exit 2
+T0=$(cut -d' ' -f1 /proc/uptime)
+
+modid() { # modid <lnx|bsd>
+	case "$1" in
+	lnx) $LNX_SSH "sh -c '. /home/ubuntu/qos-build/qos-gates/lib.sh >/dev/null 2>&1; qg_loaded_module_id'" 2>/dev/null ;;
+	bsd) $BSD_SSH "sh -c '. /scratch/build/qos-gates/lib.sh >/dev/null 2>&1; qg_loaded_module_id'" 2>/dev/null ;;
+	esac
+}
+logdev() { # logdev <lnx|bsd>: the dedicated log device of the test pool, "none", or "unknown"
+	local st
+	case "$1" in
+	lnx) st=$($LNX_SSH "sudo zpool status testqos" 2>/dev/null) ;;
+	bsd) st=$($BSD_SSH "zpool status testqos" 2>/dev/null) ;;
+	esac
+	echo "$st" | grep -q 'state:' || { echo unknown; return; }
+	echo "$st" | awk '/^[[:space:]]*logs/ {getline; print $1; f = 1; exit} END {if (!f) print "none"}'
+}
+if [ -n "$REJUDGE" ]; then
+	# SRC: where the chain's output and the logs of its steps are read
+	SRC=$REJUDGE
+	RC=$(grep '^chain_rc=' "$SRC/host.txt" 2>/dev/null | tail -1 | cut -d= -f2)
+	RC=${RC:-1}
+	{
+		echo "label=$LABEL rejudge_of=$SRC known=${KNOWN:-none} min_combinations=$MINCOMB"
+		echo "start=$STAMP"
+		echo "original: $(cat "$SRC/RESULT" 2>/dev/null)"
+	} > "$EV/host.txt"
+else
+	SRC=$EV
+	{
+		echo "label=$LABEL chain_options=${CHAINOPTS[*]:-none} known=${KNOWN:-none} min_combinations=$MINCOMB"
+		echo "start=$STAMP"
+		echo "module_before_lnx=$(modid lnx)"
+		echo "module_before_bsd=$(modid bsd)"
+	} > "$EV/host.txt"
+
+	bash "$QOS_TESTS/0-setup/chain_full.sh" "${CHAINOPTS[@]}" > "$EV/chain.stdout" 2>&1
+	RC=$?
+
+	# the chain's own log, and the logs of its steps: every log of that
+	# directory written since this run started (a step that starts late has
+	# its own time stamp in its name, and one chain runs at a time)
+	CLOG=$(sed 's/\x1b\[[0-9;]*m//g' "$EV/chain.stdout" | grep -a -o 'Log: [^ ]*' | tail -1 | cut -d' ' -f2)
+	if [ -n "$CLOG" ] && [ -f "$CLOG" ]; then
+		find "$(dirname "$CLOG")" -maxdepth 1 -type f -name '*.log' -newer "$EV/host.txt" \
+		    -exec cp -p {} "$EV/" \; 2>/dev/null
+	fi
+fi
+sed 's/\x1b\[[0-9;]*m//g' "$SRC/chain.stdout" | grep -a -A40 'RÉSUMÉ FINAL' > "$EV/summary.txt"
+TOTAL=$(sed 's/\x1b\[[0-9;]*m//g' "$SRC/chain.stdout" | grep -a 'TOTAL:' | tail -1)
+NPASS=$(echo "$TOTAL" | grep -o '[0-9]* PASS' | cut -d' ' -f1)
+NFAIL=$(echo "$TOTAL" | grep -o '[0-9]* FAIL' | cut -d' ' -f1)
+NORES=$(grep -c 'NO_RESULT' "$EV/summary.txt")
+# fio errors in the logs of the steps, with the check they belong to (the
+# title of the check is the line above): log, check, error. The chain's own
+# log repeats them and is left out.
+: > "$EV/fio-errors.txt"
+for f in "$SRC"/*.log; do
+	[ -f "$f" ] || continue
+	case "$(basename "$f")" in
+	chain_full_*) continue ;;
+	esac
+	sed 's/\x1b\[[0-9;]*m//g' "$f" |
+	    awk -v l="$(basename "$f")" '/^\[S[0-9]+\./ {t = $0}
+	    /fio_(write|read) ERROR/ {sub(/^[ \t]+/, ""); print l "\t" t "\t" $0}' >> "$EV/fio-errors.txt"
+done
+# an error on a check that only informs voids nothing
+asserted() { awk -F'\t' '$2 !~ /^\[S1\.[0-9]+\.[de]\]/' "$EV/fio-errors.txt"; }
+NERR=$(asserted | wc -l)
+# One line per combination: failures against the failures that are a
+# documented limitation (--known), and fio errors on its asserted checks. The
+# local combinations are not counted by the chain (their scripts give a table
+# of rates, judged by gate G3).
+BAD=0; NCOMB=0; KNOWNHIT=0; NINVALID=0
+: > "$EV/combinations.tsv"
+while read -r key res; do
+	case "$res" in
+	*P/*F) ;;
+	*) continue ;;
+	esac
+	p=${res%%P/*}; f=${res##*/}; f=${f%F}
+	case "$key" in
+	LOCAL-*) verdict="not counted (see G3)" ;;
+	*)
+		NCOMB=$((NCOMB + 1))
+		allowed=0
+		for k in $(echo "$KNOWN" | tr ',' ' '); do
+			[ "${k%%:*}" = "$key" ] && allowed=${k##*:}
+		done
+		# NVMe-LNX-s1_v2 -> nvmeof_lnx_s1_v2_<stamp>.log
+		pre=$(echo "$key" | tr 'A-Z-' 'a-z_' | sed 's/^nvme_/nvmeof_/')
+		e=$(asserted | awk -F'\t' -v p="${pre}_" 'index($1, p) == 1' | wc -l)
+		if [ "$e" -gt 0 ]; then
+			verdict="INVALID ($e fio error(s) on asserted checks)"; NINVALID=$((NINVALID + 1))
+		elif [ "$f" -le "$allowed" ]; then
+			if [ "$f" -gt 0 ]; then verdict="ok ($f known)"; KNOWNHIT=$((KNOWNHIT + f)); else verdict=ok; fi
+		else
+			verdict="FAIL ($f failures, $allowed known)"; BAD=$((BAD + 1))
+		fi
+		;;
+	esac
+	printf '%s\t%s\t%s\t%s\n' "$key" "$p" "$f" "$verdict" >> "$EV/combinations.tsv"
+done < "$EV/summary.txt"
+{
+	echo "chain_rc=$RC"
+	if [ -z "$REJUDGE" ]; then
+		echo "module_after_lnx=$(modid lnx)"
+		echo "module_after_bsd=$(modid bsd)"
+		# The bench is defined with a RAM-backed log device on both pools.
+		# The chain reboots the VMs: a pool that came back without its log
+		# was measured in other conditions than the other one (2026-11-19:
+		# the Linux pool had none during two chains, which hid a defect).
+		LOG_LNX=$(logdev lnx); LOG_BSD=$(logdev bsd)
+		echo "dedicated_log_after_lnx=$LOG_LNX"
+		echo "dedicated_log_after_bsd=$LOG_BSD"
+	else
+		LOG_LNX=$(sed -n 's/^dedicated_log_after_lnx=//p' "$SRC/host.txt" 2>/dev/null | tail -1)
+		LOG_BSD=$(sed -n 's/^dedicated_log_after_bsd=//p' "$SRC/host.txt" 2>/dev/null | tail -1)
+		echo "dedicated_log_after_lnx=${LOG_LNX:-not recorded} dedicated_log_after_bsd=${LOG_BSD:-not recorded}"
+	fi
+	echo "total_pass=${NPASS:-NA} total_fail=${NFAIL:-NA} combinations=$NCOMB without_result=$NORES known_failures=$KNOWNHIT"
+	echo "fio_errors_on_asserted_checks=$NERR fio_errors_total=$(wc -l < "$EV/fio-errors.txt") combinations_invalid=$NINVALID"
+	echo "host_seconds=$(echo "$(cut -d' ' -f1 /proc/uptime) - $T0" | bc)"
+} >> "$EV/host.txt"
+if [ "$NERR" -gt 0 ]; then
+	echo "RESULT=INVALID ($NERR fio error(s) on asserted checks, $NINVALID combination(s) to run again; counts ${NPASS:-NA} pass / ${NFAIL:-NA} fail)" > "$EV/RESULT"
+elif [ "${LOG_LNX:-}" = none ] || [ "${LOG_BSD:-}" = none ]; then
+	echo "RESULT=INVALID (test pool without its dedicated log device: lnx=${LOG_LNX:-?} bsd=${LOG_BSD:-?}; the bench was not in its defined state; counts ${NPASS:-NA} pass / ${NFAIL:-NA} fail)" > "$EV/RESULT"
+elif [ "$RC" -eq 0 ] && [ "$NCOMB" -ge "$MINCOMB" ] && [ $BAD -eq 0 ] && [ "$NORES" -eq 0 ]; then
+	echo "RESULT=PASS ($NCOMB combinations, ${NPASS:-NA} checks passed, $KNOWNHIT known failures)" > "$EV/RESULT"
+else
+	echo "RESULT=FAIL (chain_rc=$RC combinations=$NCOMB/$MINCOMB failing=$BAD no_result=$NORES)" > "$EV/RESULT"
+fi
+( cd "$EV" && find . -type f ! -name SHA256SUMS | sort | xargs sha256sum > SHA256SUMS )
+cat "$EV/summary.txt" | cut -c1-100
+cut -c1-170 "$EV/fio-errors.txt"
+echo "$(cat "$EV/RESULT") evidence=$EV host_seconds=$(grep '^host_seconds=' "$EV/host.txt" | cut -d= -f2)"
+case "$(cat "$EV/RESULT")" in
+RESULT=PASS*) exit 0 ;;
+RESULT=INVALID*) exit 3 ;;
+*) exit 1 ;;
+esac
diff --git a/tests/qos-gates/host/run_g4_mixed.sh b/tests/qos-gates/host/run_g4_mixed.sh
new file mode 100755
index 0000000000000000000000000000000000000000..113b473155c8ed2e1efe28b4f2db6fc40e0b2e10
--- /dev/null
+++ b/tests/qos-gates/host/run_g4_mixed.sh
@@ -0,0 +1,213 @@
+#!/bin/bash
+# SPDX-License-Identifier: CDDL-1.0
+#
+# run_g4_mixed.sh — the parallel measurement of scenario S1 (its axis "e": a
+# direct read, a buffered read, a direct write and a buffered write at once on
+# one dataset that has the same limit for reads and for writes), repeated on
+# one dataset of one combination with the fixture's own functions, and with
+# what the module charged beside what the client read.
+#
+#   run_g4_mixed.sh <label> <evidence-root> <proto>-<lnx|bsd> <index 1..4> <repeats> [phases]
+#
+# The chain must have set the fixture up already. A measurement, no verdict.
+# The scenario prints that axis without judging it, so nothing else tells
+# whether reads keep their limit while writes run on the same dataset.
+# Each repeat runs the phases asked for ("solo mixed" when none is given):
+#   solo       one direct read alone, as axis "a" — the reference: the limit
+#              is reached and each byte is charged once;
+#   wdirect    one direct write alone, as axis "c";
+#   wbuffered  one buffered write alone, confirmed at its end, as axis "d";
+#   mixed      the four processes together, as axis "e".
+# In the two write-only phases nothing reads: what the read limit is charged
+# there comes from the writes. The last columns give what the intent log of
+# the dataset copied (and so read back), what it logged by pointer, and its
+# commits.
+# For each phase <evidence>/mixed.tsv gives the rates fio reports (MiB/s, as
+# the scenario prints them under the name MB/s), the bytes the client's block
+# device read and wrote (iSCSI and NVMe-oF; NA over NFS and CIFS), the bytes
+# the QoS kstat of the dataset counted as charged, and their ratio. A ratio
+# near 1 with reads under the limit means the reads were not offered to the
+# bucket; a ratio well over 1 means something else than the client's reads
+# drew on the read bucket. The whole kstat is kept before and after each
+# phase (kstat.<repeat>.<phase>.{before,after}).
+
+set -uo pipefail
+QOS_ENV=${QOS_ENV:-/home/ubuntu/qos-tests/0-setup/qos_env.sh}
+QOS_TESTS=${QOS_TESTS:-/home/ubuntu/qos-tests}
+# shellcheck disable=SC1090
+source "$QOS_ENV" >/dev/null 2>&1
+
+[ $# -eq 5 ] || [ $# -eq 6 ] || { echo "usage: $0 <label> <evidence-root> <proto>-<lnx|bsd> <index> <repeats> [phases]" >&2; exit 2; }
+LABEL=$1; EVROOT=$2; COMBO=$3; IDX=$4; REP=$5; PHASES=${6:-solo mixed}
+for _p in $PHASES; do
+	case "$_p" in solo|wdirect|wbuffered|mixed) ;; *) echo "unknown phase $_p" >&2; exit 2 ;; esac
+done
+PROTO=${COMBO%-*}; VM=${COMBO#*-}
+case "$VM" in
+lnx) SSH_STR="ssh -i $SSH_KEY $SSH_OPTS ubuntu@$LNX_VM_IP"; GATES=/home/ubuntu/qos-build/qos-gates; ZFS="sudo zfs"; ZPOOL="sudo zpool" ;;
+bsd) SSH_STR="ssh -i $SSH_KEY $SSH_OPTS freebsd@$BSD_VM_IP"; GATES=/scratch/build/qos-gates; ZFS=zfs; ZPOOL=zpool ;;
+*) echo "unknown VM in $COMBO" >&2; exit 2 ;;
+esac
+FIO_SIZE_STEP=
+case "$COMBO" in
+nfs-lnx) BASE=$MNT_NFS_LNX; DS="testqos/bench1 testqos/bench2 testqos/bench3 testqos/bench4" ;;
+nfs-bsd) BASE=$MNT_NFS_BSD; DS="testqos/bench1 testqos/bench2 testqos/bench3 testqos/bench4" ;;
+cifs-lnx) BASE=$MNT_CIFS_LNX; DS="testqos/bench1 testqos/bench2 testqos/bench3 testqos/bench4" ;;
+cifs-bsd) BASE=$MNT_CIFS_BSD; DS="testqos/bench1 testqos/bench2 testqos/bench3 testqos/bench4" ;;
+iscsi-lnx) BASE=$MNT_ISCSI_LNX; DS="testqos/iscsi1 testqos/iscsi2 testqos/iscsi3 testqos/iscsi4 testqos/iscsi5" ;;
+iscsi-bsd) BASE=$MNT_ISCSI_BSD; DS="testqos/iscsi1 testqos/iscsi2 testqos/iscsi3 testqos/iscsi4 testqos/iscsi5" ;;
+nvmeof-lnx) BASE=$MNT_NVME_LNX; DS="testqos/nvme1 testqos/nvme2 testqos/nvme3 testqos/nvme4 testqos/nvme5"; FIO_SIZE_STEP=96M ;;
+nvmeof-bsd) BASE=$MNT_NVME_BSD; DS="testqos/nvmeof1 testqos/nvmeof2 testqos/nvmeof3 testqos/nvmeof4 testqos/nvmeof5"; FIO_SIZE_STEP=96M ;;
+*) echo "unknown combination $COMBO" >&2; exit 2 ;;
+esac
+MNTS="$BASE/1 $BASE/2 $BASE/3 $BASE/4 $BASE/5"
+
+STAMP=$(date -u +%Y%m%dT%H%M%SZ)
+EV=$EVROOT/g4_mixed-$COMBO-b$IDX-$LABEL-$STAMP
+mkdir -p "$EV" || exit 2
+mono() { cut -d' ' -f1 /proc/uptime; }
+T0=$(mono)
+MODID=$($SSH_STR "sh -c '. $GATES/lib.sh >/dev/null 2>&1; qg_loaded_module_id'" 2>/dev/null)
+
+# the fixture's libraries read these from the environment, as in the chain
+export SSH="$SSH_STR" LOG="$EV/mixed.log" COUNTS_FILE="$EV/counts.txt"
+export OVERRIDE_MNT="$MNTS" OVERRIDE_DS="$DS"
+[ -n "$FIO_SIZE_STEP" ] && export FIO_SIZE=$FIO_SIZE_STEP
+# shellcheck disable=SC1091
+source "$QOS_TESTS/lib.sh"
+# shellcheck disable=SC1091
+source "$QOS_TESTS/lib_nfs.sh"
+
+ds=${NFS_DS[$IDX]}; mnt=${NFS_MNT[$IDX]}; cap=${CAPS_BW[$IDX]}
+POOLNAME=${ds%%/*}
+OBJ=$(printf '%x' "$($SSH_STR "$ZFS get -H -p -o value objsetid $ds" 2>/dev/null)")
+# the client's block device behind the mount, if there is one
+SRC=$(findmnt -n -o SOURCE "$mnt" 2>/dev/null); BLK=
+case "$SRC" in /dev/*) BLK=$(basename "$(readlink -f "$SRC")") ;; esac
+{
+	echo "label=$LABEL combination=$COMBO dataset_index=$IDX dataset=$ds repeats=$REP"
+	echo "start=$STAMP"
+	echo "module=$MODID"
+	echo "mount=$mnt source=$SRC block_device=${BLK:-none} objset=0x$OBJ limit_mib_s=$cap duration_s=$DUR fio_size=$FIO_SIZE"
+	# With a dedicated log device the intent log copies every logged write;
+	# without one, only the small ones. judge_g4_mixed.sh needs to know.
+	PSTAT=$($SSH_STR "$ZPOOL status $POOLNAME" 2>/dev/null)
+	LOGDEV=$(echo "$PSTAT" | awk '/^[[:space:]]*logs/ {getline; print $1; exit}')
+	if ! echo "$PSTAT" | grep -q 'state:'; then
+		echo "dedicated_log=unknown (the pool status could not be read)"
+	elif [ -n "$LOGDEV" ]; then
+		echo "dedicated_log=yes ($LOGDEV)"
+	else
+		echo "dedicated_log=no"
+	fi
+} > "$EV/host.txt"
+
+kstat_dump() { # kstat_dump <file>: "field value" lines of the QoS kstat of the
+	# dataset (empty if it has none) and of its dataset kstat, which holds
+	# what its intent log copied (zil_itx_copied_bytes, zil_itx_needcopy_bytes)
+	# or logged by pointer (zil_itx_indirect_bytes)
+	case "$VM" in
+	bsd) $SSH_STR "sysctl kstat.zfs.$POOLNAME.qos.qos-0x$OBJ kstat.zfs.$POOLNAME.dataset.objset-0x$OBJ" 2>/dev/null |
+	    sed -e 's/^.*\.\([a-z_0-9]*\): /\1 /' ;;
+	lnx) $SSH_STR "cat /proc/spl/kstat/zfs/$POOLNAME/qos-0x$OBJ; cat /proc/spl/kstat/zfs/$POOLNAME/objset-0x$OBJ" 2>/dev/null |
+	    awk '$2 ~ /^[0-9]+$/ && NF == 3 {print $1, $3}' ;;
+	esac > "$1"
+}
+kv() { awk -v k="$2" '$1 == k {print $2; f = 1} END {if (!f) print "NA"}' "$1"; }
+txg_now() { # a transaction group number of the pool (last synced on FreeBSD,
+	# open on Linux): only its difference over a phase is used
+	case "$VM" in
+	bsd) $SSH_STR "sudo zdb -u $POOLNAME 2>/dev/null" | awk '/txg =/ {print $3; f = 1; exit} END {if (!f) print "NA"}' ;;
+	lnx) $SSH_STR "tail -1 /proc/spl/kstat/zfs/$POOLNAME/txgs" 2>/dev/null | awk '{print $1; f = 1} END {if (!f) print "NA"}' ;;
+	esac
+}
+blk_stat() { # bytes read and written by the client's block device so far
+	if [ -n "$BLK" ] && [ -r "/sys/class/block/$BLK/stat" ]; then
+		awk '{printf "%.0f %.0f\n", $3 * 512, $7 * 512}' "/sys/class/block/$BLK/stat"
+	else
+		echo "NA NA"
+	fi
+}
+field() { echo "$1" | awk -v p="$2:" '{for (k = 1; k <= NF; k++) if (index($k, p) == 1) print substr($k, length(p) + 1)}'; }
+
+printf 'repeat\tphase\tlimit_mib_s\tra\trb\twc\twd\tr_sum\tw_sum\twall_s\tclient_read_mib\tclient_write_mib\tcharged_read_mib\tcharged_write_mib\tcharged_per_client_read\tthrottled_reads\tlog_copied_mib\tlog_indirect_mib\tlog_commits\tpool_txgs\tfio_errors\trpc_retrans\n' > "$EV/mixed.tsv"
+# errors the fixture's fio functions logged so far (a soft NFS mount returns
+# an I/O error to the client when the server holds a request too long)
+fio_errs() { sed 's/\x1b\[[0-9;]*m//g' "$LOG" 2>/dev/null | grep -c 'ERROR'; }
+# retransmissions of the NFS client of this host so far (all mounts): a
+# request the server holds longer than the mount's timeout is sent again
+rpc_retrans() { awk '$1 == "rpc" {print $3; f = 1} END {if (!f) print "NA"}' /proc/net/rpc/nfs 2>/dev/null || echo NA; }
+
+measure() { # measure <repeat> <solo|mixed>
+	local r=$1 ph=$2 line ra rb wc wd t0 t1 cr0 cw0 cr1 cw1 b a x0 x1 e0 e1 n0 n1
+	b=$EV/kstat.$r.$ph.before; a=$EV/kstat.$r.$ph.after
+	x0=$(txg_now); e0=$(fio_errs); n0=$(rpc_retrans)
+	kstat_dump "$b"; read -r cr0 cw0 <<< "$(blk_stat)"; t0=$(mono)
+	case "$ph" in
+	solo) ra=$(fio_read "$mnt" direct "$DUR"); rb=-; wc=-; wd=- ;;
+	# writes alone, as axes "c" and "d": nothing reads, so whatever the read
+	# limit is charged here comes from the writes
+	wdirect) ra=-; rb=-; wc=$(fio_write "$mnt" direct wc "$DUR"); wd=- ;;
+	wbuffered) ra=-; rb=-; wc=-; wd=$(fio_write "$mnt" indirect wd "$DUR") ;;
+	mixed)
+		line=$(fio_axe_e "$mnt" "$DUR")
+		ra=$(field "$line" ra); rb=$(field "$line" rb)
+		wc=$(field "$line" wc); wd=$(field "$line" wd) ;;
+	esac
+	t1=$(mono); read -r cr1 cw1 <<< "$(blk_stat)"; kstat_dump "$a"
+	x1=$(txg_now); e1=$(fio_errs); n1=$(rpc_retrans)
+	awk -v r="$r" -v ph="$ph" -v cap="$cap" -v ra="$ra" -v rb="$rb" -v wc="$wc" -v wd="$wd" \
+	    -v x0="${x0:-NA}" -v x1="${x1:-NA}" -v ferr="$((${e1:-0} - ${e0:-0}))" -v n0="${n0:-NA}" -v n1="${n1:-NA}" \
+	    -v t0="$t0" -v t1="$t1" -v cr0="$cr0" -v cr1="$cr1" -v cw0="$cw0" -v cw1="$cw1" \
+	    -v kr0="$(kv "$b" stat_total_bytes_read)" -v kr1="$(kv "$a" stat_total_bytes_read)" \
+	    -v kw0="$(kv "$b" stat_total_bytes_write)" -v kw1="$(kv "$a" stat_total_bytes_write)" \
+	    -v th0="$(kv "$b" stat_throttle_count_read)" -v th1="$(kv "$a" stat_throttle_count_read)" \
+	    -v lc0="$(kv "$b" zil_itx_copied_bytes)" -v lc1="$(kv "$a" zil_itx_copied_bytes)" \
+	    -v ln0="$(kv "$b" zil_itx_needcopy_bytes)" -v ln1="$(kv "$a" zil_itx_needcopy_bytes)" \
+	    -v li0="$(kv "$b" zil_itx_indirect_bytes)" -v li1="$(kv "$a" zil_itx_indirect_bytes)" \
+	    -v lm0="$(kv "$b" zil_commit_count)" -v lm1="$(kv "$a" zil_commit_count)" '
+	function mib(x0, x1) { return (x0 == "NA" || x1 == "NA") ? "NA" : sprintf("%.1f", (x1 - x0) / 1048576) }
+	function num(x) { return (x == "-") ? 0 : x }
+	BEGIN {
+		rs = (ra == "-" && rb == "-") ? "-" : sprintf("%.1f", num(ra) + num(rb))
+		ws = (wc == "-" && wd == "-") ? "-" : sprintf("%.1f", num(wc) + num(wd))
+		clr = mib(cr0, cr1); clw = mib(cw0, cw1); chr = mib(kr0, kr1); chw = mib(kw0, kw1)
+		ratio = (clr == "NA" || chr == "NA" || clr + 0 == 0) ? "NA" : sprintf("%.2f", chr / clr)
+		th = (th0 == "NA" || th1 == "NA") ? "NA" : th1 - th0
+		lcp = (lc0 == "NA" || lc1 == "NA" || ln0 == "NA" || ln1 == "NA") ? "NA" : \
+		    sprintf("%.1f", (lc1 - lc0 + ln1 - ln0) / 1048576)
+		lin = mib(li0, li1)
+		lcm = (lm0 == "NA" || lm1 == "NA") ? "NA" : lm1 - lm0
+		txg = (x0 == "NA" || x1 == "NA") ? "NA" : x1 - x0
+		printf "%d\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%.1f\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n",
+		    r, ph, cap, ra, rb, wc, wd, rs, ws, t1 - t0, clr, clw, chr, chw, ratio, th, lcp, lin, lcm, txg, ferr, (n0 == "NA" || n1 == "NA") ? "NA" : n1 - n0
+	}' | tee -a "$EV/mixed.tsv"
+}
+
+qos_unset "$ds"
+clean_bench "$mnt"
+seed_read_file "$mnt"
+qos_set "$ds" "$cap" 0 0 1
+$SSH_STR "$ZFS get -H -o property,value,source all $ds" 2>/dev/null | grep -E '^(qos:|vol|sync|primarycache)' > "$EV/dataset-props.txt"
+# What the module made of the limit just set: the pool-wide total of the write
+# limits and the share of the dirty data it leaves to this dataset. A dataset
+# over that share makes its writers wait for the pool to sync, and a pool that
+# syncs all the time leaves the intent log little to copy.
+case "$VM" in
+bsd) DQ=$($SSH_STR "sysctl -n kstat.zfs.misc.dbgmsg | grep 'QoS dirty quota' | tail -1" 2>/dev/null) ;;
+lnx) DQ=$($SSH_STR "sudo tail -n 2000 /proc/spl/kstat/zfs/dbgmsg | grep 'QoS dirty quota' | tail -1" 2>/dev/null) ;;
+esac
+echo "dirty_quota_message=${DQ:-none}" >> "$EV/host.txt"
+for r in $(seq 1 "$REP"); do
+	for _p in $PHASES; do
+		measure "$r" "$_p"
+	done
+done
+qos_unset "$ds"
+clean_bench "$mnt"
+{
+	echo "module_after=$($SSH_STR "sh -c '. $GATES/lib.sh >/dev/null 2>&1; qg_loaded_module_id'" 2>/dev/null)"
+	echo "host_seconds=$(echo "$(mono) - $T0" | bc)"
+} >> "$EV/host.txt"
+echo "RESULT=MEASURED ($REP repeats) evidence=$EV" | tee "$EV/RESULT"
+( cd "$EV" && find . -type f ! -name SHA256SUMS | sort | xargs sha256sum > SHA256SUMS )
diff --git a/tests/qos-gates/host/run_g4_reads.sh b/tests/qos-gates/host/run_g4_reads.sh
new file mode 100755
index 0000000000000000000000000000000000000000..6c4a64aca89e3aab2bef2b65ee22e1cc01ffe071
--- /dev/null
+++ b/tests/qos-gates/host/run_g4_reads.sh
@@ -0,0 +1,82 @@
+#!/bin/bash
+# SPDX-License-Identifier: CDDL-1.0
+#
+# run_g4_reads.sh — the two read checks of scenario S1 (direct, then buffered
+# after dropping the client's cache) repeated on one dataset of one
+# combination, with the fixture's own functions and settings. Tells whether
+# a read check that failed once is unstable or really off.
+#
+#   run_g4_reads.sh <label> <evidence-root> <proto>-<lnx|bsd> <index 1..4> <repeats>
+#
+# The chain must have set the fixture up already. A measurement, no verdict:
+# <evidence>/reads.tsv has one line per repeat (direct MB/s, indirect MB/s,
+# limit, and the tolerance band of the scenario for the buffered check).
+
+set -uo pipefail
+QOS_ENV=${QOS_ENV:-/home/ubuntu/qos-tests/0-setup/qos_env.sh}
+QOS_TESTS=${QOS_TESTS:-/home/ubuntu/qos-tests}
+# shellcheck disable=SC1090
+source "$QOS_ENV" >/dev/null 2>&1
+
+[ $# -eq 5 ] || { echo "usage: $0 <label> <evidence-root> <proto>-<lnx|bsd> <index> <repeats>" >&2; exit 2; }
+LABEL=$1; EVROOT=$2; COMBO=$3; IDX=$4; REP=$5
+PROTO=${COMBO%-*}; VM=${COMBO#*-}
+case "$VM" in
+lnx) SSH_STR="ssh -i $SSH_KEY $SSH_OPTS ubuntu@$LNX_VM_IP"; GATES=/home/ubuntu/qos-build/qos-gates ;;
+bsd) SSH_STR="ssh -i $SSH_KEY $SSH_OPTS freebsd@$BSD_VM_IP"; GATES=/scratch/build/qos-gates ;;
+*) echo "unknown VM in $COMBO" >&2; exit 2 ;;
+esac
+FIO_SIZE_STEP=
+case "$COMBO" in
+nfs-lnx) BASE=$MNT_NFS_LNX; DS="testqos/bench1 testqos/bench2 testqos/bench3 testqos/bench4" ;;
+nfs-bsd) BASE=$MNT_NFS_BSD; DS="testqos/bench1 testqos/bench2 testqos/bench3 testqos/bench4" ;;
+cifs-lnx) BASE=$MNT_CIFS_LNX; DS="testqos/bench1 testqos/bench2 testqos/bench3 testqos/bench4" ;;
+cifs-bsd) BASE=$MNT_CIFS_BSD; DS="testqos/bench1 testqos/bench2 testqos/bench3 testqos/bench4" ;;
+iscsi-lnx) BASE=$MNT_ISCSI_LNX; DS="testqos/iscsi1 testqos/iscsi2 testqos/iscsi3 testqos/iscsi4 testqos/iscsi5" ;;
+iscsi-bsd) BASE=$MNT_ISCSI_BSD; DS="testqos/iscsi1 testqos/iscsi2 testqos/iscsi3 testqos/iscsi4 testqos/iscsi5" ;;
+nvmeof-lnx) BASE=$MNT_NVME_LNX; DS="testqos/nvme1 testqos/nvme2 testqos/nvme3 testqos/nvme4 testqos/nvme5"; FIO_SIZE_STEP=96M ;;
+nvmeof-bsd) BASE=$MNT_NVME_BSD; DS="testqos/nvmeof1 testqos/nvmeof2 testqos/nvmeof3 testqos/nvmeof4 testqos/nvmeof5"; FIO_SIZE_STEP=96M ;;
+*) echo "unknown combination $COMBO" >&2; exit 2 ;;
+esac
+MNTS="$BASE/1 $BASE/2 $BASE/3 $BASE/4 $BASE/5"
+
+STAMP=$(date -u +%Y%m%dT%H%M%SZ)
+EV=$EVROOT/g4_reads-$COMBO-b$IDX-$LABEL-$STAMP
+mkdir -p "$EV" || exit 2
+T0=$(cut -d' ' -f1 /proc/uptime)
+MODID=$($SSH_STR "sh -c '. $GATES/lib.sh >/dev/null 2>&1; qg_loaded_module_id'" 2>/dev/null)
+{
+	echo "label=$LABEL combination=$COMBO dataset_index=$IDX repeats=$REP"
+	echo "start=$STAMP"
+	echo "module=$MODID"
+} > "$EV/host.txt"
+
+# the fixture's libraries read these from the environment, as in the chain
+export SSH="$SSH_STR" LOG="$EV/reads.log" COUNTS_FILE="$EV/counts.txt"
+export OVERRIDE_MNT="$MNTS" OVERRIDE_DS="$DS"
+[ -n "$FIO_SIZE_STEP" ] && export FIO_SIZE=$FIO_SIZE_STEP
+# shellcheck disable=SC1091
+source "$QOS_TESTS/lib.sh"
+# shellcheck disable=SC1091
+source "$QOS_TESTS/lib_nfs.sh"
+
+ds=${NFS_DS[$IDX]}; mnt=${NFS_MNT[$IDX]}; cap=${CAPS_BW[$IDX]}
+printf 'repeat\tdirect_mb_s\tindirect_mb_s\tlimit_mib_s\tband_low\tband_high\n' > "$EV/reads.tsv"
+qos_unset "$ds"
+clean_bench "$mnt"
+seed_read_file "$mnt"
+qos_set "$ds" "$cap" 0 0 1
+for r in $(seq 1 "$REP"); do
+	a=$(fio_read "$mnt" direct "$DUR")
+	b=$(fio_read "$mnt" indirect "$DUR")
+	awk -v r="$r" -v a="$a" -v b="$b" -v c="$cap" -v t="$TOL_CACHE" 'BEGIN {
+		printf "%d\t%s\t%s\t%s\t%.2f\t%.2f\n", r, a, b, c, c * (1 - t / 100), c * (1 + t / 100) }' |
+	    tee -a "$EV/reads.tsv"
+done
+qos_unset "$ds"
+clean_bench "$mnt"
+{
+	echo "host_seconds=$(echo "$(cut -d' ' -f1 /proc/uptime) - $T0" | bc)"
+} >> "$EV/host.txt"
+echo "RESULT=MEASURED ($REP repeats) evidence=$EV" | tee "$EV/RESULT"
+( cd "$EV" && find . -type f ! -name SHA256SUMS | sort | xargs sha256sum > SHA256SUMS )
diff --git a/tests/qos-gates/host/run_g4_step.sh b/tests/qos-gates/host/run_g4_step.sh
new file mode 100755
index 0000000000000000000000000000000000000000..30afc87b8524be6358d6e003d4c03ef5f0b979e9
--- /dev/null
+++ b/tests/qos-gates/host/run_g4_step.sh
@@ -0,0 +1,101 @@
+#!/bin/bash
+# SPDX-License-Identifier: CDDL-1.0
+#
+# run_g4_step.sh — one combination of gate G4 again, invoked exactly as the
+# fixture's chain invokes it (qos-tests/0-setup/chain_full.sh, scenario S1).
+#
+#   run_g4_step.sh <label> <evidence-root> <nfs|cifs|iscsi|nvmeof>-<lnx|bsd>
+#
+# The chain must have set the fixture up already (mounts, canonical limits):
+# this script sets nothing up. It adds two things the chain does not do:
+#   - before the run, it refuses a test filesystem that has less free space
+#     than the three files the scenario writes on it: a full filesystem makes
+#     fio stop early and the scenario then reports a rate that means nothing;
+#   - after the run, a step whose log shows a fio error on an asserted check
+#     is INVALID, whatever the count says.
+# PASS = no failure, no fio error on a direct-write or read check.
+
+set -uo pipefail
+QOS_ENV=${QOS_ENV:-/home/ubuntu/qos-tests/0-setup/qos_env.sh}
+QOS_TESTS=${QOS_TESTS:-/home/ubuntu/qos-tests}
+# shellcheck disable=SC1090
+source "$QOS_ENV" >/dev/null 2>&1
+
+[ $# -eq 3 ] || { echo "usage: $0 <label> <evidence-root> <proto>-<lnx|bsd>" >&2; exit 2; }
+LABEL=$1; EVROOT=$2; COMBO=$3
+PROTO=${COMBO%-*}; VM=${COMBO#*-}
+case "$VM" in
+lnx) SSH_STR="ssh -i $SSH_KEY $SSH_OPTS ubuntu@$LNX_VM_IP"; GATES=/home/ubuntu/qos-build/qos-gates ;;
+bsd) SSH_STR="ssh -i $SSH_KEY $SSH_OPTS freebsd@$BSD_VM_IP"; GATES=/scratch/build/qos-gates ;;
+*) echo "unknown VM in $COMBO" >&2; exit 2 ;;
+esac
+# the same lists as chain_full.sh
+FIO_SIZE_STEP=
+case "$COMBO" in
+nfs-lnx) BASE=$MNT_NFS_LNX; DS="testqos/bench1 testqos/bench2 testqos/bench3 testqos/bench4" ;;
+nfs-bsd) BASE=$MNT_NFS_BSD; DS="testqos/bench1 testqos/bench2 testqos/bench3 testqos/bench4" ;;
+cifs-lnx) BASE=$MNT_CIFS_LNX; DS="testqos/bench1 testqos/bench2 testqos/bench3 testqos/bench4" ;;
+cifs-bsd) BASE=$MNT_CIFS_BSD; DS="testqos/bench1 testqos/bench2 testqos/bench3 testqos/bench4" ;;
+iscsi-lnx) BASE=$MNT_ISCSI_LNX; DS="testqos/iscsi1 testqos/iscsi2 testqos/iscsi3 testqos/iscsi4 testqos/iscsi5" ;;
+iscsi-bsd) BASE=$MNT_ISCSI_BSD; DS="testqos/iscsi1 testqos/iscsi2 testqos/iscsi3 testqos/iscsi4 testqos/iscsi5" ;;
+nvmeof-lnx) BASE=$MNT_NVME_LNX; DS="testqos/nvme1 testqos/nvme2 testqos/nvme3 testqos/nvme4 testqos/nvme5"; FIO_SIZE_STEP=96M ;;
+nvmeof-bsd) BASE=$MNT_NVME_BSD; DS="testqos/nvmeof1 testqos/nvmeof2 testqos/nvmeof3 testqos/nvmeof4 testqos/nvmeof5"; FIO_SIZE_STEP=96M ;;
+*) echo "unknown combination $COMBO" >&2; exit 2 ;;
+esac
+MNTS="$BASE/1 $BASE/2 $BASE/3 $BASE/4 $BASE/5"
+
+STAMP=$(date -u +%Y%m%dT%H%M%SZ)
+EV=$EVROOT/g4_step-$COMBO-$LABEL-$STAMP
+mkdir -p "$EV" || exit 2
+T0=$(cut -d' ' -f1 /proc/uptime)
+modid() { $SSH_STR "sh -c '. $GATES/lib.sh >/dev/null 2>&1; qg_loaded_module_id'" 2>/dev/null; }
+{
+	echo "label=$LABEL combination=$COMBO"
+	echo "start=$STAMP"
+	echo "module_before=$(modid)"
+} > "$EV/host.txt"
+df -m $MNTS > "$EV/df.before" 2>&1
+
+# room for the three files of the scenario (seed, direct write, buffered write)
+if [ -n "$FIO_SIZE_STEP" ]; then
+	NEED=$(( ${FIO_SIZE_STEP%M} * 3 ))
+	SHORT=$(df -m --output=avail,target $BASE/1 $BASE/2 $BASE/3 $BASE/4 2>/dev/null |
+	    awk -v n="$NEED" 'NR > 1 && $1 < n {printf "%s (%d MiB free) ", $2, $1}')
+	if [ -n "$SHORT" ]; then
+		echo "RESULT=INVALID (not enough room for 3 x $FIO_SIZE_STEP on: $SHORT)" | tee "$EV/RESULT"
+		exit 3
+	fi
+fi
+
+LOG=$EV/${PROTO}_${VM}_s1_v2.log
+COUNTS=$EV/counts.txt
+env SSH="$SSH_STR" LOG="$LOG" COUNTS_FILE="$COUNTS" OVERRIDE_MNT="$MNTS" OVERRIDE_DS="$DS" \
+    ${FIO_SIZE_STEP:+FIO_SIZE=$FIO_SIZE_STEP} \
+    bash "$QOS_TESTS/2-nfs/s1_v2.sh" > "$EV/stdout.txt" 2>&1
+RC=$?
+df -m $MNTS > "$EV/df.after" 2>&1
+P=NA; F=NA
+[ -f "$COUNTS" ] && read -r P F < "$COUNTS"
+# fio errors, with the check they belong to (the check title is the line above)
+sed 's/\x1b\[[0-9;]*m//g' "$LOG" 2>/dev/null |
+    awk '/^\[S1\./ {t = $0} /fio_(write|read) ERROR/ {print t " :: " $0}' > "$EV/fio-errors.txt"
+# an error on the buffered-write check (d) or on the parallel one (e) does not
+# void an assertion: those two only inform
+NERR=$(grep -c -E '^\[S1\.[0-9]+\.[abc]\]' "$EV/fio-errors.txt")
+{
+	echo "script_rc=$RC pass=$P fail=$F fio_errors_on_asserted_checks=$NERR fio_errors_total=$(wc -l < "$EV/fio-errors.txt")"
+	echo "module_after=$(modid)"
+	echo "host_seconds=$(echo "$(cut -d' ' -f1 /proc/uptime) - $T0" | bc)"
+} >> "$EV/host.txt"
+if [ "$NERR" -gt 0 ]; then
+	echo "RESULT=INVALID ($NERR fio error(s) on asserted checks; counts $P pass / $F fail)" > "$EV/RESULT"
+elif [ $RC -eq 0 ] && [ "$F" = 0 ] && [ "$P" != NA ] && [ "$P" -gt 0 ]; then
+	echo "RESULT=PASS ($P checks)" > "$EV/RESULT"
+else
+	echo "RESULT=FAIL (script_rc=$RC pass=$P fail=$F)" > "$EV/RESULT"
+fi
+( cd "$EV" && find . -type f ! -name SHA256SUMS | sort | xargs sha256sum > SHA256SUMS )
+sed 's/\x1b\[[0-9;]*m//g' "$LOG" 2>/dev/null | grep -a -E 'PASS|FAIL|terminée' | cut -c1-110
+cat "$EV/fio-errors.txt" | cut -c1-170
+echo "$(cat "$EV/RESULT") evidence=$EV host_seconds=$(grep '^host_seconds=' "$EV/host.txt" | cut -d= -f2)"
+grep -q '^RESULT=PASS' "$EV/RESULT"
diff --git a/tests/qos-gates/host/run_g8.sh b/tests/qos-gates/host/run_g8.sh
new file mode 100755
index 0000000000000000000000000000000000000000..e9393cafe0ba99f1af41267589b9c4008064b30f
--- /dev/null
+++ b/tests/qos-gates/host/run_g8.sh
@@ -0,0 +1,102 @@
+#!/bin/bash
+# SPDX-License-Identifier: CDDL-1.0
+#
+# run_g8.sh — gate G8 on one VM: runs of g8_noqos_perf.sh with the control
+# module and with the build under test, taken alternately (control, fork,
+# control, fork, ...), then the verdict of host/compare_perf.sh.
+#
+#   run_g8.sh <lnx|bsd> <control-label> <fork-label> <evidence-root>
+#       [--pairs 5] [--threshold 3] [--pool scratch] [--no-warmup]
+#       [-- <g8 options>]
+#
+# Both labels are trees already built on the VM (host/deploy_tree.sh and
+# build.sh). The module is switched before every run, so each run starts
+# from a freshly loaded module (a reboot on FreeBSD). A first run of each
+# module is made and not counted, the order inside a pair alternates, and
+# the verdict is made on the ratio inside each pair (host/compare_perf.sh).
+# Nothing else may run on the two VMs or on the host meanwhile.
+# Exit status: the one of compare_perf.sh (0 PASS, 1 FAIL, 3 INCONCLUSIVE).
+
+set -uo pipefail
+HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
+
+usage() {
+	echo "usage: $0 <lnx|bsd> <control-label> <fork-label> <evidence-root>" \
+	    "[--pairs N] [--threshold PCT] [--pool POOL] [-- <g8 options>]" >&2
+	exit 2
+}
+[ $# -ge 4 ] || usage
+VM=$1; CTL=$2; FORK=$3; EVROOT=$4; shift 4
+PAIRS=5; T=3; POOL=scratch; G8OPTS=(); WARMUP=yes; WARM=
+while [ $# -gt 0 ]; do
+	case "$1" in
+	--pairs) PAIRS=$2; shift 2 ;;
+	--no-warmup) WARMUP=no; shift ;;
+	--threshold) T=$2; shift 2 ;;
+	--pool) POOL=$2; shift 2 ;;
+	--) shift; G8OPTS=("$@"); break ;;
+	*) usage ;;
+	esac
+done
+mkdir -p "$EVROOT" || exit 2
+T0=$(cut -d' ' -f1 /proc/uptime)
+STAMP=$(date -u +%Y%m%dT%H%M%SZ)
+
+# one <label> -> the evidence directory of the run on stdout, progress on stderr
+one() {
+	"$HERE/vm_module.sh" "$VM" "tree:$1" 2>&1 | grep -E '^vm=|FAIL|refus' | cut -c1-150 >&2
+	local out
+	out=$(QG_HOST_TIMEOUT=${QG_HOST_TIMEOUT:-1800} "$HERE/run_gate.sh" "$VM" "$1" "$EVROOT" \
+	    g8_noqos_perf.sh --pool "$POOL" "${G8OPTS[@]}")
+	echo "$out" | cut -c1-200 >&2
+	case "$out" in
+	RESULT=PASS*) echo "$out" | grep -o 'evidence=[^ ]*' | tail -1 | cut -d= -f2 ;;
+	esac
+}
+
+CDIRS=(); FDIRS=(); LOST=0
+# One run of each module that is not counted: the first run of a module is
+# not like the following ones (host cache, space maps of the pool).
+if [ "$WARMUP" = yes ]; then
+	echo "== warm-up runs (not counted)" >&2
+	WARM="$(one "$CTL") $(one "$FORK")"
+fi
+# A pair is two runs taken one right after the other; the order alternates
+# from one pair to the next, so that neither side is always the first. A
+# pair is kept only when both of its runs succeeded: the verdict is made on
+# the ratio inside each pair.
+for i in $(seq 1 "$PAIRS"); do
+	echo "== pair $i/$PAIRS" >&2
+	if [ $((i % 2)) -eq 1 ]; then
+		dc=$(one "$CTL"); df=$(one "$FORK")
+	else
+		df=$(one "$FORK"); dc=$(one "$CTL")
+	fi
+	if [ -n "$dc" ] && [ -n "$df" ]; then
+		CDIRS+=("$dc"); FDIRS+=("$df")
+	else
+		LOST=$((LOST + 1))
+	fi
+done
+
+REPORT=$EVROOT/G8-$VM-$FORK-vs-$CTL-$STAMP.txt
+{
+	echo "vm=$VM control=$CTL fork=$FORK pairs=$PAIRS pool=$POOL options=${G8OPTS[*]:-none}"
+	echo "pairs kept: ${#CDIRS[@]} of $PAIRS (pairs dropped because a run failed: $LOST)"
+	echo "warm-up (not counted): ${WARM:-none}"
+	printf 'control: %s\n' "${CDIRS[@]:-none}"
+	printf 'fork:    %s\n' "${FDIRS[@]:-none}"
+} > "$REPORT"
+if [ ${#CDIRS[@]} -eq 0 ] || [ ${#FDIRS[@]} -eq 0 ]; then
+	echo "RESULT=FAIL (no usable run on one side)" | tee -a "$REPORT"
+	exit 1
+fi
+"$HERE/compare_perf.sh" --threshold "$T" "${CDIRS[@]}" -- "${FDIRS[@]}" | tee -a "$REPORT"
+RC=${PIPESTATUS[0]}
+# a run that failed on one side weakens the comparison: never a plain PASS
+if [ $LOST -gt 0 ] && [ $RC -eq 0 ]; then
+	echo "RESULT=INCONCLUSIVE ($LOST pair(s) dropped because a run failed)" | tee -a "$REPORT"
+	RC=3
+fi
+echo "host_seconds=$(echo "$(cut -d' ' -f1 /proc/uptime) - $T0" | bc) report=$REPORT" | tee -a "$REPORT"
+exit $RC
diff --git a/tests/qos-gates/host/run_gate.sh b/tests/qos-gates/host/run_gate.sh
new file mode 100755
index 0000000000000000000000000000000000000000..2de2b7180ba9b413376f1bf1295c77d14512f9d3
--- /dev/null
+++ b/tests/qos-gates/host/run_gate.sh
@@ -0,0 +1,62 @@
+#!/bin/bash
+# SPDX-License-Identifier: CDDL-1.0
+#
+# run_gate.sh — run one gate script on a test VM against the module loaded
+# there, and bring the evidence back to the host with checksums.
+#
+#   run_gate.sh <lnx|bsd> <label> <evidence-root> <script> [script options]
+#
+# The script is one of tests/qos-gates/*.sh that takes --out DIR; --out and
+# --label are added here. A lost SSH session (panic, reboot, freeze) is
+# reported as such, and the FreeBSD crash summary is collected.
+
+set -uo pipefail
+QOS_ENV=${QOS_ENV:-/home/ubuntu/qos-tests/0-setup/qos_env.sh}
+# shellcheck disable=SC1090
+source "$QOS_ENV" >/dev/null 2>&1
+
+[ $# -ge 4 ] || { echo "usage: $0 <lnx|bsd> <label> <evidence-root> <script> [options]" >&2; exit 2; }
+VM=$1; LABEL=$2; EVROOT=$3; SCRIPT=$4; shift 4
+
+case "$VM" in
+lnx) SSH=$LNX_SSH; BASE=/home/ubuntu/qos-build; ADDR=ubuntu@$LNX_VM_IP; WORK=/home/ubuntu/qos-gate-out ;;
+bsd) SSH=$BSD_SSH; BASE=/scratch/build; ADDR=freebsd@$BSD_VM_IP; WORK=/home/freebsd/qos-gate-out ;;
+*) echo "first argument must be lnx or bsd" >&2; exit 2 ;;
+esac
+mono() { cut -d' ' -f1 /proc/uptime; }
+T0=$(mono)
+NAME=$(basename "$SCRIPT" .sh)
+RUN=$NAME-$VM-$LABEL-$(date -u +%Y%m%dT%H%M%SZ)
+EV=$EVROOT/$RUN
+mkdir -p "$EV"
+
+timeout -k 15 "${QG_HOST_TIMEOUT:-3600}" $SSH "mkdir -p $WORK/$RUN && sh $BASE/qos-gates/$NAME.sh --out $WORK/$RUN --label $LABEL $*" \
+    > "$EV/stdout.txt" 2>&1
+RC=$?
+{
+	echo "vm=$VM label=$LABEL run=$RUN script=$NAME args=$*"
+	echo "ssh_rc=$RC"
+} > "$EV/host.txt"
+
+if [ $RC -eq 255 ] || [ $RC -eq 124 ] || [ $RC -eq 137 ]; then
+	echo "vm_lost=yes" >> "$EV/host.txt"
+	ssh -i "$SSH_KEY" $SSH_OPTS -o ConnectTimeout=5 -o ConnectionAttempts=150 "$ADDR" true 2>/dev/null &&
+	    echo "vm_back=yes" >> "$EV/host.txt" || echo "vm_back=no" >> "$EV/host.txt"
+	if [ "$VM" = bsd ]; then
+		C=$($SSH "ls -t /var/crash/core.txt.* 2>/dev/null | head -1" 2>/dev/null)
+		[ -n "$C" ] && $SSH "sudo head -c 600000 $C" > "$EV/$(basename "$C")" 2>/dev/null
+		$SSH "sudo cat /var/crash/info.last 2>/dev/null" > "$EV/crash-info.last" 2>/dev/null
+	fi
+fi
+# The serial console is logged on the host: keep its tail in every case.
+D=$( [ "$VM" = lnx ] && echo "$LNX_VM_NAME" || echo "$BSD_VM_NAME")
+sudo -n tail -c 60000 "/var/log/libvirt/qemu/$D-serial-console.log" > "$EV/serial-console.tail" 2>/dev/null
+
+$SSH "cd $WORK && tar -cf - $RUN 2>/dev/null" | tar -xf - -C "$EV" --strip-components=1 2>/dev/null
+( cd "$EV" && find . -type f ! -name SHA256SUMS | sort | xargs sha256sum > SHA256SUMS )
+
+RESULT=$(grep -h '^RESULT=' "$EV/RESULT" 2>/dev/null | tail -1)
+[ -n "$RESULT" ] || RESULT="RESULT=FAIL (no verdict: ssh_rc=$RC)"
+echo "host_seconds=$(echo "$(mono) - $T0" | bc)" >> "$EV/host.txt"
+echo "$RESULT vm=$VM label=$LABEL gate=$NAME evidence=$EV host_seconds=$(tail -1 "$EV/host.txt" | cut -d= -f2)"
+[ "$RESULT" = "RESULT=PASS" ] && [ $RC -eq 0 ]
