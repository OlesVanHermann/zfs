+	int64_t		tb_snap_bw_rate;
+	int64_t		tb_snap_iops_rate;
+} qos_token_bucket_t;
+
+typedef struct qos_bucket {
+	kmutex_t		qb_lock;
+	kcondvar_t		qb_read_cv;	/* wakes readers waiting for tokens */
