+/*
+ * QoS: recalculate the per-dataset dirty data quota.
+ * quota = bw_rate * zfs_dirty_data_max / dp_qos_total_bw
+ * Called from qos_prop_apply() after bucket configuration changes.
+ *
+ * Scale down numerator and denominator equally so the product
+ * bw * dirty_max stays within uint64_t.  This avoids 128-bit
+ * division (__udivti3) which is not available in kernel space.
+ */
+void
+dsl_pool_qos_dirty_update(dsl_dataset_t *ds)
+{
+	dsl_pool_t *dp = ds->ds_dir->dd_pool;
+	/* QoS R/W split: use write BW rate for dirty quota (Q-patch10) */
+	int64_t bw_rate = ds->ds_qos.qb_write.tb_bw_rate;
+	uint64_t total_bw;
+
+	mutex_enter(&dp->dp_lock);
+	total_bw = dp->dp_qos_total_bw;
+	if (total_bw > 0 && bw_rate > 0) {
+		uint64_t bw = (uint64_t)bw_rate;
+		uint64_t dm = zfs_dirty_data_max;
+		uint64_t tb = total_bw;
+		/*
+		 * Shift bw and tb by equal amounts until bw * dm
+		 * fits in 64 bits.  The ratio bw/tb is preserved.
+		 */
+		while (bw != 0 && dm != 0 && bw > UINT64_MAX / dm) {
+			bw >>= 1;
+			tb >>= 1;
+		}
+		if (tb == 0)
+			tb = 1;
+		ds->ds_dirty_quota = (bw * dm) / tb;
+	} else {
+		ds->ds_dirty_quota = 0;
+	}
+	mutex_exit(&dp->dp_lock);
+
+	zfs_dbgmsg("QoS dirty quota ds %llu: bw=%lld total_bw=%llu "
+	    "dirty_max=%llu quota=%llu",
+	    (u_longlong_t)ds->ds_object,
+	    (longlong_t)bw_rate,
+	    (u_longlong_t)total_bw,
+	    (u_longlong_t)zfs_dirty_data_max,
+	    (u_longlong_t)ds->ds_dirty_quota);
+}
