+		    "dirty_max=%llu quota=%llu total_bw_read=%llu",
+		    (u_longlong_t)ds->ds_object,
+		    (longlong_t)bw_rate,
+		    (u_longlong_t)total_bw,
+		    (u_longlong_t)zfs_dirty_data_max,
+		    (u_longlong_t)ds->ds_dirty_quota,
+		    (u_longlong_t)total_bw_read);
+	}
