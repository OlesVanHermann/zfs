+/*
+ * QoS: read qos:* user properties and configure the token bucket.
+ * Called at dataset load and on dynamic property change.
+ * Properties are stored as strings in ZAP; read via dsl_prop_get_ds.
+ */
+void
+qos_prop_apply(dsl_dataset_t *ds)
+{
+	char buf[32];
+	unsigned long long tmp = 0;
+	uint32_t io_size_max = 0;
+
+	if (dsl_prop_get_ds(ds, "qos:max_iosize", 1, sizeof (buf),
+	    buf, NULL) == 0) {
+		if (ddi_strtoull(buf, NULL, 10, &tmp) != 0) {
+			zfs_dbgmsg("ds %llu: invalid qos:max_iosize '%s'",
+			    (unsigned long long)ds->ds_object, buf);
+			tmp = 0;
+		}
+		if (tmp > UINT32_MAX) {
+			zfs_dbgmsg("ds %llu: qos:max_iosize %llu exceeds "
+			    "UINT32_MAX, clamping",
+			    (unsigned long long)ds->ds_object, tmp);
+			tmp = UINT32_MAX;
+		}
+		io_size_max = (uint32_t)tmp;
+	}
+
+	/* QoS Boost: read qos:boost and qos:boost_pool (patch08) */
+	uint32_t boost_factor = 0;
+	uint32_t boost_pool_val = 1;	/* default: contributes */
+
+	if (dsl_prop_get_ds(ds, "qos:boost", 1, sizeof (buf),
+	    buf, NULL) == 0) {
+		if (ddi_strtoull(buf, NULL, 10, &tmp) == 0 &&
+		    tmp <= UINT32_MAX)
+			boost_factor = (uint32_t)tmp;
+	}
+
+	if (dsl_prop_get_ds(ds, "qos:boost_pool", 1, sizeof (buf),
+	    buf, NULL) == 0) {
+		if (ddi_strtoull(buf, NULL, 10, &tmp) == 0)
+			boost_pool_val = (tmp != 0) ? 1 : 0;
+	}
+
+	/* qos:count_arc_hits — default: B_TRUE (count all reads) */
+	boolean_t count_arc_hits = B_TRUE;
+	if (dsl_prop_get_ds(ds, "qos:count_arc_hits", 1, sizeof (buf),
+	    buf, NULL) == 0) {
+		if (strcmp(buf, "off") == 0 || strcmp(buf, "0") == 0)
+			count_arc_hits = B_FALSE;
+	}
+
+	/* QoS R/W split: read per-direction properties (Q-patch10) */
+	int64_t bw_read_rate = 0, bw_write_rate = 0;
+	int64_t iops_read_rate = 0, iops_write_rate = 0;
+
+	if (dsl_prop_get_ds(ds, "qos:max_bw_read", 1, sizeof (buf),
+	    buf, NULL) == 0) {
+		if (ddi_strtoull(buf, NULL, 10, &tmp) != 0) {
+			zfs_dbgmsg("ds %llu: invalid qos:max_bw_read '%s'",
+			    (unsigned long long)ds->ds_object, buf);
+			tmp = 0;
+		}
+		bw_read_rate = (int64_t)tmp;
+	}
+	if (dsl_prop_get_ds(ds, "qos:max_bw_write", 1, sizeof (buf),
+	    buf, NULL) == 0) {
+		if (ddi_strtoull(buf, NULL, 10, &tmp) != 0) {
+			zfs_dbgmsg("ds %llu: invalid qos:max_bw_write '%s'",
+			    (unsigned long long)ds->ds_object, buf);
+			tmp = 0;
+		}
+		bw_write_rate = (int64_t)tmp;
+	}
+	if (dsl_prop_get_ds(ds, "qos:max_iops_read", 1, sizeof (buf),
+	    buf, NULL) == 0) {
+		if (ddi_strtoull(buf, NULL, 10, &tmp) != 0) {
+			zfs_dbgmsg("ds %llu: invalid qos:max_iops_read '%s'",
+			    (unsigned long long)ds->ds_object, buf);
+			tmp = 0;
+		}
+		iops_read_rate = (int64_t)tmp;
+	}
+	if (dsl_prop_get_ds(ds, "qos:max_iops_write", 1, sizeof (buf),
+	    buf, NULL) == 0) {
+		if (ddi_strtoull(buf, NULL, 10, &tmp) != 0) {
+			zfs_dbgmsg("ds %llu: invalid qos:max_iops_write '%s'",
+			    (unsigned long long)ds->ds_object, buf);
+			tmp = 0;
+		}
+		iops_write_rate = (int64_t)tmp;
+	}
+
+	/* Track old BW rate for pool-wide total update */
+	int64_t old_bw = ds->ds_qos.qb_enabled ?
+	    ds->ds_qos.qb_write.tb_bw_rate : 0;
+
+	if (iops_read_rate > 0 || iops_write_rate > 0 ||
+	    bw_read_rate > 0 || bw_write_rate > 0) {
+		qos_bucket_configure_split(&ds->ds_qos,
+		    iops_read_rate, bw_read_rate,
+		    iops_write_rate, bw_write_rate,
+		    io_size_max);
+		qos_bucket_enable(&ds->ds_qos);
+		/* Create kstat on first enable; idempotent if exists. */
+		qos_kstat_create(ds);
+	} else {
+		qos_kstat_destroy(ds);
+		qos_bucket_disable(&ds->ds_qos);
+	}
+
+	/* QoS Boost: apply boost config per direction (patch08 + Q-patch10) */
+	ds->ds_qos.qb_boost_factor = boost_factor;
+	ds->ds_qos.qb_boost_pool =
+	    (boost_pool_val != 0) ? B_TRUE : B_FALSE;
+	/*
+	 * QoS Boost caps — token storage limit (P-patch08).
+	 *
+	 * The cap limits how many boost tokens can be stored at any instant.
+	 * Set to boost_factor × rate (one second of boost throughput).
+	 * Must be large enough for a single I/O so try_consume() can
+	 * combine normal + boost tokens (see qos_bucket.c).
+	 *
+	 * Throughput is self-regulated: donors donate in bursts (~1×/sec),
+	 * and try_consume() only uses boost for the shortfall after
+	 * normal tokens are exhausted, preventing drain+refill cycling.
+	 */
+	ds->ds_qos.qb_read.tb_boost_bw_cap =
+	    (boost_factor > 0 &&
+	    bw_read_rate > INT64_MAX / (int64_t)boost_factor) ?
+	    INT64_MAX : (int64_t)boost_factor * bw_read_rate;
+	ds->ds_qos.qb_read.tb_boost_iops_cap =
+	    (boost_factor > 0 &&
+	    iops_read_rate > INT64_MAX / (int64_t)boost_factor) ?
+	    INT64_MAX : (int64_t)boost_factor * iops_read_rate;
+	ds->ds_qos.qb_write.tb_boost_bw_cap =
+	    (boost_factor > 0 &&
+	    bw_write_rate > INT64_MAX / (int64_t)boost_factor) ?
+	    INT64_MAX : (int64_t)boost_factor * bw_write_rate;
+	ds->ds_qos.qb_write.tb_boost_iops_cap =
+	    (boost_factor > 0 &&
+	    iops_write_rate > INT64_MAX / (int64_t)boost_factor) ?
+	    INT64_MAX : (int64_t)boost_factor * iops_write_rate;
+	ds->ds_qos.qb_pool = ds->ds_dir->dd_pool;
+
+	/* QoS Unify: apply count_arc_hits config (O-patch09) */
+	mutex_enter(&ds->ds_qos.qb_lock);
+	ds->ds_qos.qb_count_arc_hits = count_arc_hits;
+	mutex_exit(&ds->ds_qos.qb_lock);
+
+	/*
+	 * If boost_pool=1 is set on an enabled bucket, add it to the
+	 * pool's active bucket list so the wake thread can collect its
+	 * surplus even if it never gets throttled (pure idle donor).
+	 * Lock order: qos_active_pools_lock -> dp_qos_active_lock -> qb_lock.
+	 */
+	if (ds->ds_qos.qb_enabled && ds->ds_qos.qb_boost_pool &&
+	    (ds->ds_qos.qb_read.tb_bw_rate > 0 ||
+	    ds->ds_qos.qb_write.tb_bw_rate > 0)) {
+		dsl_pool_t *pool = ds->ds_dir->dd_pool;
+		ds->ds_qos.qb_last_consume_time = gethrtime();
+		mutex_enter(&qos_active_pools_lock);
+		mutex_enter(&pool->dp_qos_active_lock);
+		mutex_enter(&ds->ds_qos.qb_lock);
+		if (!ds->ds_qos.qb_on_active_list) {
+			list_insert_tail(&pool->dp_qos_active_buckets,
+			    &ds->ds_qos);
+			ds->ds_qos.qb_on_active_list = B_TRUE;
+		}
+		if (!pool->dp_qos_on_active_pools) {
+			list_insert_tail(&qos_active_pools, pool);
+			pool->dp_qos_on_active_pools = B_TRUE;
+		}
+		mutex_exit(&ds->ds_qos.qb_lock);
+		mutex_exit(&pool->dp_qos_active_lock);
+		mutex_exit(&qos_active_pools_lock);
+	}
+
+	/* QoS: update pool-wide dirty quota (F-patch05 + Q-patch10) */
+	{
+		int64_t new_bw = (iops_read_rate > 0 || iops_write_rate > 0 ||
+		    bw_read_rate > 0 || bw_write_rate > 0) ?
+		    bw_write_rate : 0;
+		dsl_pool_t *dp = ds->ds_dir->dd_pool;
+		mutex_enter(&dp->dp_lock);
+		dp->dp_qos_total_bw =
+		    dp->dp_qos_total_bw - (uint64_t)old_bw +
+		    (uint64_t)new_bw;
+		mutex_exit(&dp->dp_lock);
+	}
+	dsl_pool_qos_dirty_update(ds);
+}
