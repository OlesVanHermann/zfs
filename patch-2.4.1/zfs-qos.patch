index 0000000000000000000000000000000000000000..5f09d2ea80f7b0412831dfc73c0960e64fbfa425
--- /dev/null
+++ b/tests/qos-gates/diag_other_ops.sh
@@ -0,0 +1,150 @@
+#!/bin/sh
+# SPDX-License-Identifier: CDDL-1.0
+#
+# diag_other_ops.sh — what the limits of a dataset are charged for the
+# operations that are not plain reads and writes: a copy by block cloning,
+# the removal and the truncation of a large file, a send, a receive, a
+# rollback.
+#
+# The write limit is charged what a transaction announces it may write. For a
+# write that is the data; for the other operations it is an estimate of the
+# metadata they touch, so a large file can be cloned or removed for the price
+# of a few hundred kilobytes. A send does not read through the functions where
+# reads are charged; a receive writes through transactions of the dataset it
+# creates.
+#
+# Not a gate: it gives figures.
+#
+#   diag_other_ops.sh --pool POOL --out OUTDIR [--label NAME]
+#
+# Files of 64 MiB, both limits out of reach. OUTDIR/other_ops.tsv, one line
+# per operation: bytes concerned, bytes charged to the write limit and in how
+# many charges, bytes charged to the read limit, seconds, a note.
+#   copy_read_write  reference: the file copied by read(2) and write(2)
+#   copy_clone       the file copied by copy_file_range(2) (cfr_tool.c, built
+#                    on the spot); the note gives what the pool counts as
+#                    cloned (bcloneused) after the copy
+#   remove           a 64 MiB file removed
+#   truncate         a 64 MiB file truncated to nothing
+#   send             a snapshot of the dataset sent to /dev/null
+#   receive          that stream received into a new dataset that is limited
+#                    from its first byte (charge read in the kstat of that
+#                    dataset)
+#   rollback         64 MiB written after the snapshot, then a rollback
+
+set -u
+QG_DIR=$(cd "$(dirname "$0")" && pwd)
+. "$QG_DIR/lib.sh"
+
+POOL=; OUT=; LABEL=diag-other-ops
+while [ $# -gt 0 ]; do
+	case "$1" in
+	--pool) POOL=$2; shift 2 ;;
+	--out) OUT=$2; shift 2 ;;
+	--label) LABEL=$2; shift 2 ;;
+	*) qg_die "unknown argument $1" ;;
+	esac
+done
+[ -n "$POOL" ] && [ -n "$OUT" ] || qg_die "--pool and --out are mandatory"
+case "$(date +%s%N)" in
+*[!0-9]*) qg_die "date +%s%N gives no nanoseconds on this system" ;;
+esac
+mkdir -p "$OUT" || qg_die "cannot create $OUT"
+RES=$OUT/RESULT
+: > "$RES"
+say() { printf '%s\n' "$*" | tee -a "$RES"; }
+
+say "label=$LABEL date=$(qg_now)"
+say "os=$(uname -sr) ncpu=$(qg_ncpu)"
+say "module_loaded=$(qg_loaded_module_id)"
+case "$QG_OS" in
+FreeBSD) say "bclone_enabled=$(sysctl -n vfs.zfs.bclone_enabled 2>/dev/null)" ;;
+*) say "bclone_enabled=$(cat /sys/module/zfs/parameters/zfs_bclone_enabled 2>/dev/null)" ;;
+esac
+TOOL=$OUT/cfr_tool
+cc -O2 -o "$TOOL" "$QG_DIR/cfr_tool.c" > "$OUT/cc.out" 2>&1 ||
+    qg_die "cannot build cfr_tool (see $OUT/cc.out)"
+
+DS=$POOL/qg-ops
+RDS=$POOL/qg-ops-recv
+MNT=$(zfs get -H -o value mountpoint "$POOL")/qg-ops
+sudo zfs destroy -r "$RDS" > /dev/null 2>&1
+sudo zfs destroy -r "$DS" > /dev/null 2>&1
+sudo zfs create -o compression=off -o recordsize=128K "$DS" || qg_die "cannot create $DS"
+sudo chown "$(id -u)" "$MNT"
+FAR=1099511627776	# 1 TiB/s: far above what the test can do
+M64=67108864
+sudo zfs set qos:enabled=on qos:max_bw_read=$FAR qos:max_bw_write=$FAR "$DS" ||
+    qg_die "cannot set the limits"
+OBJ=$(printf '%x' "$(zfs get -H -p -o value objsetid "$DS")")
+
+kv() { # kv <objset in hexadecimal> <field of its QoS kstat>
+	case "$QG_OS" in
+	FreeBSD) sysctl -n "kstat.zfs.$POOL.qos.qos-0x$1.$2" 2>/dev/null ;;
+	*) awk -v k="$2" '$1 == k {print $3}' "/proc/spl/kstat/zfs/$POOL/qos-0x$1" 2>/dev/null ;;
+	esac
+}
+[ -n "$(kv "$OBJ" stat_total_bytes_write)" ] || qg_die "no QoS kstat for $DS"
+
+for _f in src rm-me trunc-me; do
+	dd if=/dev/urandom of="$MNT/$_f" bs=1048576 count=64 2>/dev/null || qg_die "cannot write $_f"
+done
+sudo zpool sync "$POOL"
+
+FAIL=0
+NOTE=
+printf 'operation\tbytes\tcharged_write\twrite_charges\tcharged_read\tseconds\tnote\n' > "$OUT/other_ops.tsv"
+# op <name> <bytes concerned> <shell command, run in $MNT>
+op() {
+	_w0=$(kv "$OBJ" stat_total_bytes_write); _n0=$(kv "$OBJ" stat_total_ios_write)
+	_r0=$(kv "$OBJ" stat_total_bytes_read)
+	_t0=$(date +%s%N)
+	( cd "$MNT" && eval "$3" ) > "$OUT/op-$1.out" 2>&1 ||
+	    { say "FAIL $1: the operation failed"; FAIL=1; }
+	_t1=$(date +%s%N)
+	sudo zpool sync "$POOL"
+	_w1=$(kv "$OBJ" stat_total_bytes_write); _n1=$(kv "$OBJ" stat_total_ios_write)
+	_r1=$(kv "$OBJ" stat_total_bytes_read)
+	printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$1" "$2" "$((_w1 - _w0))" "$((_n1 - _n0))" \
+	    "$((_r1 - _r0))" "$(awk -v a="$_t0" -v b="$_t1" 'BEGIN {printf "%.2f", (b - a) / 1e9}')" \
+	    "${NOTE:--}" | tee -a "$OUT/other_ops.tsv"
+	NOTE=
+}
+op copy_read_write $M64 'dd if=src of=copy-rw bs=1048576'
+_b0=$(zpool get -H -p -o value bcloneused "$POOL" 2>/dev/null)
+( cd "$MNT" && "$TOOL" src copy-clone ) > "$OUT/clone-probe.out" 2>&1
+sudo zpool sync "$POOL"
+_b1=$(zpool get -H -p -o value bcloneused "$POOL" 2>/dev/null)
+# the probe told whether this pool clones; the measured copy is a second one
+NOTE="bcloneused +$(( ${_b1:-0} - ${_b0:-0} )) on a first copy"
+op copy_clone $M64 '"$TOOL" src copy-clone2'
+op remove $M64 'unlink rm-me'
+op truncate $M64 'truncate -s 0 trunc-me'
+sudo zfs snapshot "$DS@s1" || qg_die "cannot snapshot"
+op send "$(zfs get -H -p -o value referenced "$DS@s1")" "sudo zfs send '$DS@s1' > /dev/null"
+
+# receive: the charge goes to the dataset being received
+_t0=$(date +%s%N)
+sh -c "sudo zfs send '$DS@s1' | sudo zfs recv -o qos:enabled=on -o qos:max_bw_write=$FAR -o qos:max_bw_read=$FAR '$RDS'" \
+    > "$OUT/op-receive.out" 2>&1 || { say "FAIL receive: the operation failed"; FAIL=1; }
+_t1=$(date +%s%N)
+sudo zpool sync "$POOL"
+ROBJ=$(printf '%x' "$(zfs get -H -p -o value objsetid "$RDS" 2>/dev/null)")
+_rw=$(kv "$ROBJ" stat_total_bytes_write); _rn=$(kv "$ROBJ" stat_total_ios_write)
+_rr=$(kv "$ROBJ" stat_total_bytes_read)
+printf 'receive\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(zfs get -H -p -o value referenced "$RDS" 2>/dev/null)" \
+    "${_rw:-NA}" "${_rn:-NA}" "${_rr:-NA}" \
+    "$(awk -v a="$_t0" -v b="$_t1" 'BEGIN {printf "%.2f", (b - a) / 1e9}')" \
+    "kstat of the received dataset" | tee -a "$OUT/other_ops.tsv"
+
+dd if=/dev/urandom of="$MNT/after-snap" bs=1048576 count=64 2>/dev/null
+sudo zpool sync "$POOL"
+op rollback $M64 "sudo zfs rollback '$DS@s1'"
+
+sudo zfs destroy -r "$RDS" > /dev/null 2>&1
+sudo zfs destroy -r "$DS" > /dev/null 2>&1
+if [ "$FAIL" -ne 0 ]; then
+	say "RESULT=INCOMPLETE"
+	exit 1
+fi
+say "RESULT=MEASURED"
diff --git a/tests/qos-gates/diag_read_charge.sh b/tests/qos-gates/diag_read_charge.sh
new file mode 100755
index 0000000000000000000000000000000000000000..431e3ee52552bcda6a678cce88eb8503112d99f7
--- /dev/null
+++ b/tests/qos-gates/diag_read_charge.sh
@@ -0,0 +1,286 @@
+#!/bin/sh
+# SPDX-License-Identifier: CDDL-1.0
+#
+# diag_read_charge.sh — how many bytes of the read limit a read is charged,
+# and how much of its reserve a dataset holds when its first read comes.
+#
+# A read is charged when it enters the DMU, for the size of the request,
+# before the data is copied to the caller. Two questions follow.
+#   - Is a request charged once? A request that has to be started again
+#     (the pages of the destination buffer are not in memory yet) would be
+#     charged each time it is started.
+#   - The documentation says a bucket holds at most two seconds of its rate.
+#     How much does it hold when the first read comes, with the pool boost
+#     (qos:boost_pool) at its default and without it?
+#
+# Not a gate: it gives figures.
+#
+#   diag_read_charge.sh --pool POOL --out OUTDIR [--label NAME]
+#
+# OUTDIR/read_charge.tsv: pattern, bytes read, bytes charged, charges, bytes
+# charged per byte read (1.00 = every byte is charged once). The limit is set
+# far above what the test can reach, nothing is throttled, and the figures
+# come from the QoS kstat of the dataset.
+# More lines when the system allows them: direct_1m (the file read with
+# O_DIRECT) and a volume of the same size read in requests of 1 MiB (zvol_1m
+# on Linux; zvol_dev_1m and zvol_geom_1m on FreeBSD, one for each volmode).
+# OUTDIR/read_path.tsv: for each pattern, the bytes that direct reads took
+# from the disks and the bytes read from the disks into the cache: tells
+# whether direct_1m was served directly (6 MiB in the first column) or
+# through the cache.
+# OUTDIR/reserve.tsv: for qos:boost_pool at its default and at 0, the tokens
+# the kstat shows once a limit of 1 MiB/s is set, and the time dd reports for
+# 6 MiB read at once after that (4 s with a full bucket of 2 MiB, 5 s with
+# 1 MiB, 6 s with none).
+# OUTDIR/timed.tsv: the same 6 MiB under 1 MiB/s read by six processes, one
+# request each, with a full bucket: seconds and bytes charged.
+
+set -u
+QG_DIR=$(cd "$(dirname "$0")" && pwd)
+. "$QG_DIR/lib.sh"
+
+POOL=; OUT=; LABEL=diag-read-charge
+while [ $# -gt 0 ]; do
+	case "$1" in
+	--pool) POOL=$2; shift 2 ;;
+	--out) OUT=$2; shift 2 ;;
+	--label) LABEL=$2; shift 2 ;;
+	*) qg_die "unknown argument $1" ;;
+	esac
+done
+[ -n "$POOL" ] && [ -n "$OUT" ] || qg_die "--pool and --out are mandatory"
+case "$(date +%s%N)" in
+*[!0-9]*) qg_die "date +%s%N gives no nanoseconds on this system" ;;
+esac
+mkdir -p "$OUT" || qg_die "cannot create $OUT"
+RES=$OUT/RESULT
+: > "$RES"
+say() { printf '%s\n' "$*" | tee -a "$RES"; }
+
+say "label=$LABEL date=$(qg_now)"
+say "os=$(uname -sr) ncpu=$(qg_ncpu)"
+say "module_loaded=$(qg_loaded_module_id)"
+# FreeBSD: with this at 1 the kernel brings the pages of the buffer in before
+# the read, so the request is not started twice
+[ "$QG_OS" = FreeBSD ] &&
+    say "vn_io_fault_prefault=$(sysctl -n debug.vn_io_fault_prefault 2>/dev/null)"
+# Direct I/O of OpenZFS: on by default on Linux, off by default on FreeBSD,
+# where a file opened with O_DIRECT is then read through the cache like any
+# other. direct_1m only reads "directly" when this is 1.
+case "$QG_OS" in
+FreeBSD) say "dio_enabled=$(sysctl -n vfs.zfs.dio_enabled 2>/dev/null)" ;;
+*) say "dio_enabled=$(cat /sys/module/zfs/parameters/zfs_dio_enabled 2>/dev/null)" ;;
+esac
+
+DS=$POOL/qg-rdc
+MNT=$(zfs get -H -o value mountpoint "$POOL")/qg-rdc
+FILE_MIB=6
+SZ=$((FILE_MIB * 1048576))
+sudo zfs destroy -r "$DS" > /dev/null 2>&1
+sudo zfs create -o compression=off "$DS" || qg_die "cannot create $DS"
+sudo chown "$(id -u)" "$MNT"
+dd if=/dev/urandom of="$MNT/f" bs=1048576 count=$FILE_MIB 2>/dev/null ||
+    qg_die "cannot write the test file of $DS"
+sudo zpool sync "$POOL"
+OBJ=$(printf '%x' "$(zfs get -H -p -o value objsetid "$DS")")
+# 1 TiB/s: far above what the test can do
+sudo zfs set qos:enabled=on qos:max_bw_read=1099511627776 "$DS" ||
+    qg_die "cannot set the limit"
+
+kstat_val() { # kstat_val <field>
+	case "$QG_OS" in
+	FreeBSD) sysctl -n "kstat.zfs.$POOL.qos.qos-0x$OBJ.$1" 2>/dev/null ;;
+	*) awk -v k="$1" '$1 == k {print $3}' "/proc/spl/kstat/zfs/$POOL/qos-0x$OBJ" 2>/dev/null ;;
+	esac
+}
+[ -n "$(kstat_val stat_total_bytes_read)" ] || qg_die "no QoS kstat for $DS"
+
+# Which way a read was served: two counters of the pool's "iostats" kstat.
+# direct_read_bytes counts what direct reads took from the disks,
+# arc_read_bytes what was read from the disks into the cache. Data that is
+# already in memory is copied from there by both paths and moves neither.
+pool_io() { # pool_io <field>
+	case "$QG_OS" in
+	FreeBSD) sysctl -n "kstat.zfs.$POOL.misc.iostats.$1" 2>/dev/null ;;
+	*) awk -v k="$1" '$1 == k {print $3}' "/proc/spl/kstat/zfs/$POOL/iostats" 2>/dev/null ;;
+	esac
+}
+[ -n "$(pool_io direct_read_bytes)" ] || say "note: no direct_read_bytes counter for the pool $POOL"
+
+FAIL=0
+printf 'pattern\tbytes_read\tbytes_charged\tcharges\tcharged_per_byte_read\n' > "$OUT/read_charge.tsv"
+printf 'pattern\tdirect_bytes_from_disk\tcache_bytes_from_disk\n' > "$OUT/read_path.tsv"
+# pat <name> <shell command reading the whole file once, run in $MNT>
+pat() {
+	_d0=$(pool_io direct_read_bytes); _c0=$(pool_io arc_read_bytes)
+	_b0=$(kstat_val stat_total_bytes_read); _i0=$(kstat_val stat_total_ios_read)
+	( cd "$MNT" && eval "$2" ) > "$OUT/pat-$1.out" 2>&1 ||
+	    { say "FAIL $1: the read failed"; FAIL=1; return; }
+	_b1=$(kstat_val stat_total_bytes_read); _i1=$(kstat_val stat_total_ios_read)
+	_d1=$(pool_io direct_read_bytes); _c1=$(pool_io arc_read_bytes)
+	printf '%s\t%s\t%s\t%s\t%s\n' "$1" "$SZ" "$((_b1 - _b0))" "$((_i1 - _i0))" \
+	    "$(awk -v c="$((_b1 - _b0))" -v r="$SZ" 'BEGIN {printf "%.2f", c / r}')" |
+	    tee -a "$OUT/read_charge.tsv"
+	printf '%s\t%s\t%s\n' "$1" "$((${_d1:-0} - ${_d0:-0}))" "$((${_c1:-0} - ${_c0:-0}))" \
+	    >> "$OUT/read_path.tsv"
+}
+# one process: the buffer of the first request is new, the next ones reuse it
+pat one_process_1m 'dd if=f of=/dev/null bs=1048576'
+# one process for each request: the buffer is new every time
+pat six_processes_1m 'i=0; while [ $i -lt 6 ]; do
+    dd if=f of=/dev/null bs=1048576 count=1 skip=$i || exit 1; i=$((i + 1)); done'
+pat one_request_6m 'dd if=f of=/dev/null bs=6291456 count=1'
+pat one_process_64k 'dd if=f of=/dev/null bs=65536'
+pat one_process_4k 'dd if=f of=/dev/null bs=4096'
+pat cat 'cat f > /dev/null'
+# A direct read (O_DIRECT) takes another branch of the read function, but
+# only for data that is not in memory already: the dataset is mounted again
+# first, which drops its buffers. read_path.tsv then tells whether the
+# 6 MiB came from the disks by direct reads.
+if ( cd "$MNT" && dd if=f of=/dev/null bs=1048576 count=1 iflag=direct ) > "$OUT/direct-probe.out" 2>&1; then
+	say "direct=$(zfs get -H -o value direct "$DS" 2>/dev/null)"
+	sudo zfs unmount "$DS" && sudo zfs mount "$DS" ||
+	    say "note: cannot mount $DS again before direct_1m"
+	pat direct_1m 'dd if=f of=/dev/null bs=1048576 iflag=direct'
+else
+	say "note: dd cannot read with O_DIRECT here ($(tail -1 "$OUT/direct-probe.out" | cut -c1-80))"
+fi
+
+# A volume: another kind of object behind the same limit. A dataset that
+# nothing holds is not kept in memory, so the QoS kstat of a volume exists
+# only while the volume is open: this shell keeps it open, read-only
+# (descriptor 3), around the measurement.
+# FreeBSD: as a character device (volmode=dev), whose reads go through the
+# function that serves a file read, and as a GEOM provider (volmode=geom),
+# whose reads come as requests of the kernel.
+# Linux: read with O_DIRECT, so that the block layer asks for what dd asks
+# and nothing more.
+#
+# One name for each volume, and on FreeBSD the pending GEOM events are waited
+# for before a volume is destroyed (reading the GEOM configuration does
+# that): destroying a volume that GEOM is still tasting can bring FreeBSD
+# down, with the unmodified module too (see diag_zvol_taste.sh).
+case "$QG_OS" in
+FreeBSD) VMODES="dev geom"; VFLAG= ;;
+*) VMODES=default; VFLAG="iflag=direct" ;;
+esac
+geom_settle() {
+	[ "$QG_OS" = FreeBSD ] && sysctl -n kern.geom.conftxt > /dev/null 2>&1
+	return 0
+}
+for _vm in $VMODES; do
+	VOL=$POOL/qg-rdc-vol-$_vm
+	VDEV=/dev/zvol/$VOL
+	geom_settle
+	sudo zfs destroy "$VOL" > /dev/null 2>&1
+	case "$_vm" in
+	default) _pn=zvol_1m ;;
+	*) _pn=zvol_${_vm}_1m ;;
+	esac
+	# FreeBSD: the wanted mode is made the default while the volume
+	# exists, instead of "zfs create -o volmode=". That option sets the
+	# property after the volume has appeared in the default mode (geom),
+	# and the change of mode removes a provider that GEOM is tasting: with
+	# OpenZFS 2.4.4 this brings FreeBSD down in a few tries (FreeBSD bug
+	# 292645, reproduced with the unmodified module by
+	# diag_zvol_taste.sh).
+	_oldmode=
+	if [ "$QG_OS" = FreeBSD ]; then
+		_oldmode=$(sysctl -n vfs.zfs.vol.mode)
+		case "$_vm" in
+		dev) sudo sysctl vfs.zfs.vol.mode=2 > /dev/null ;;
+		*) sudo sysctl vfs.zfs.vol.mode=1 > /dev/null ;;
+		esac
+	fi
+	if ! sudo zfs create -V 8M -o compression=off "$VOL" 2> "$OUT/zvol-$_vm.err"; then
+		say "note: cannot create the volume $VOL ($(head -1 "$OUT/zvol-$_vm.err" | cut -c1-80))"
+		[ -n "$_oldmode" ] && sudo sysctl vfs.zfs.vol.mode="$_oldmode" > /dev/null
+		continue
+	fi
+	[ "$QG_OS" = FreeBSD ] || sudo udevadm settle > /dev/null 2>&1
+	if sudo dd if=/dev/urandom of="$VDEV" bs=1048576 count=$FILE_MIB > "$OUT/zvol-$_vm-fill.out" 2>&1; then
+		sudo zpool sync "$POOL"
+		sudo zfs set qos:enabled=on qos:max_bw_read=1099511627776 "$VOL"
+		# Linux: udev opens a volume that was just written; wait for it
+		[ "$QG_OS" = FreeBSD ] || sudo udevadm settle > /dev/null 2>&1
+		sudo chmod o+r "$VDEV"
+		if [ -r "$VDEV" ]; then
+			exec 3< "$VDEV"
+			_fobj=$OBJ
+			OBJ=$(printf '%x' "$(zfs get -H -p -o value objsetid "$VOL")")
+			if [ -n "$(kstat_val stat_total_bytes_read)" ]; then
+				pat "$_pn" "dd if=$VDEV of=/dev/null bs=1048576 count=$FILE_MIB $VFLAG"
+			else
+				say "note: no QoS kstat for the volume $VOL ($_vm), even while it is open"
+			fi
+			OBJ=$_fobj
+			exec 3<&-
+		else
+			say "note: cannot read $VDEV as $(id -un)"
+		fi
+	else
+		say "note: cannot write to $VDEV ($(tail -1 "$OUT/zvol-$_vm-fill.out" | cut -c1-80))"
+	fi
+	[ "$QG_OS" = FreeBSD ] || sudo udevadm settle > /dev/null 2>&1
+	geom_settle
+	sudo zfs destroy "$VOL" > "$OUT/zvol-$_vm-destroy.out" 2>&1 ||
+	    say "note: the volume $VOL is left behind ($(tail -1 "$OUT/zvol-$_vm-destroy.out" | cut -c1-80))"
+	[ -n "$_oldmode" ] && sudo sysctl vfs.zfs.vol.mode="$_oldmode" > /dev/null
+done
+
+# seconds dd itself reports (GNU: "... copied, N s, ..."; FreeBSD:
+# "... transferred in N secs ...")
+dd_secs() {
+	awk '/copied,/ {print $(NF - 3)} /transferred in/ {print $5}' "$1" | tail -1
+}
+printf 'boost_pool\ttokens_after_set\tseconds_for_6MiB\tbytes_charged\n' > "$OUT/reserve.tsv"
+# reserve <default|0>: the rate is set again, which fills the bucket, and the
+# file is read at once
+reserve() {
+	sudo zfs set qos:max_bw_read=1048576 "$DS" || { say "FAIL reserve $1: cannot set the limit"; FAIL=1; return; }
+	_tok=$(kstat_val stat_bw_tokens_read)
+	_b0=$(kstat_val stat_total_bytes_read)
+	qg_run_bounded 60 "$OUT/reserve-$1.out" env LC_ALL=C dd if="$MNT/f" of=/dev/null bs=1048576
+	_rc=$?
+	_b1=$(kstat_val stat_total_bytes_read)
+	if [ $_rc -ne 0 ]; then
+		say "FAIL reserve $1: rc=$_rc"; FAIL=1; return
+	fi
+	printf '%s\t%s\t%s\t%s\n' "$1" "$_tok" "$(dd_secs "$OUT/reserve-$1.out")" "$((_b1 - _b0))" |
+	    tee -a "$OUT/reserve.tsv"
+}
+say "boost_pool: $(zfs get -H -o value,source qos:boost_pool "$DS" | tr '\t' ' ')"
+reserve default
+sudo zfs set qos:boost_pool=0 "$DS" || { say "FAIL cannot set qos:boost_pool=0"; FAIL=1; }
+reserve 0
+
+# What the charge costs in time: the same 6 MiB under 1 MiB/s, read by six
+# processes, one request of 1 MiB each (a new buffer every time). The bucket
+# is full (2 MiB, qos:boost_pool is 0 here): 4 s if each request is charged
+# once, 10 s if it is charged twice. Compare with the line "0" above, where
+# one process reads the six requests into one buffer.
+printf 'pattern\tseconds\tbytes_charged\n' > "$OUT/timed.tsv"
+sudo zfs set qos:max_bw_read=1048576 "$DS" || { say "FAIL timed: cannot set the limit"; FAIL=1; }
+_b0=$(kstat_val stat_total_bytes_read)
+qg_run_bounded 120 "$OUT/timed-six.out" sh -c "cd '$MNT' || exit 1; s=\$(date +%s%N); i=0
+    while [ \$i -lt 6 ]; do
+        dd if=f of=/dev/null bs=1048576 count=1 skip=\$i 2>/dev/null || exit 1; i=\$((i + 1)); done
+    e=\$(date +%s%N); echo elapsed_ns=\$((e - s))"
+_rc=$?
+_b1=$(kstat_val stat_total_bytes_read)
+_ns=$(sed -n 's/^elapsed_ns=//p' "$OUT/timed-six.out")
+if [ $_rc -eq 0 ] && [ -n "$_ns" ]; then
+	printf 'six_processes_1m\t%s\t%s\n' "$(awk -v n="$_ns" 'BEGIN {printf "%.2f", n / 1000000000}')" \
+	    "$((_b1 - _b0))" | tee -a "$OUT/timed.tsv"
+else
+	say "FAIL timed six_processes_1m: rc=$_rc"; FAIL=1
+fi
+
+sudo zfs destroy -r "$DS" > /dev/null 2>&1
+say "tables=$OUT/read_charge.tsv $OUT/reserve.tsv"
+if [ $FAIL -eq 0 ]; then
+	say "RESULT=PASS"
+	exit 0
+fi
+say "RESULT=FAIL (a measurement failed)"
+exit 1
diff --git a/tests/qos-gates/diag_total_bw.sh b/tests/qos-gates/diag_total_bw.sh
new file mode 100755
index 0000000000000000000000000000000000000000..7abdb0ddd61654a1619b2e097290227e62d129e2
--- /dev/null
+++ b/tests/qos-gates/diag_total_bw.sh
@@ -0,0 +1,126 @@
+#!/bin/sh
+# SPDX-License-Identifier: CDDL-1.0
+#
+# diag_total_bw.sh — does the pool-wide total of the write rates stay equal
+# to the sum of the rates of the datasets that are limited?
+#
+# That total sizes two things: the surplus store of the boost (ten seconds
+# of it per direction) and the share of dirty data each limited dataset may
+# hold. It must not move when nothing that is limited changes.
+#
+# The module only shows the total in its debug messages, so after each step
+# this script sets qos:boost_pool=1 again on a dataset that is limited (no
+# change of behaviour) and reads the line the module then logs.
+#
+#   diag_total_bw.sh --pool POOL --out OUTDIR [--label NAME] [--qos-debug]
+#
+# --qos-debug: builds that only log the total in debug mode (sets
+# zfs_qos_debug=1 for the duration of the run).
+# Steps, on new datasets of the pool, each limited to 5 MiB/s:
+#   clean_set          enabled first, then the rate          expected  5 MiB/s
+#   remount x3         unmount and mount the limited dataset expected  5
+#   rate_while_off     a second dataset: enabled=off, then a rate
+#                                                            expected  5
+#   more_sets_off      two more properties on that dataset   expected  5
+#   unmounted_off x3   a third dataset, not mounted, disabled, with a rate,
+#                      looked at three times                 expected  5
+# OUTDIR/total_bw.tsv: step, total_mib, expected_mib, verdict.
+# Exit 0 = the total is 5 MiB/s after every step.
+
+set -u
+QG_DIR=$(cd "$(dirname "$0")" && pwd)
+. "$QG_DIR/lib.sh"
+
+POOL=; OUT=; LABEL=diag-total-bw; QDEBUG=no
+while [ $# -gt 0 ]; do
+	case "$1" in
+	--pool) POOL=$2; shift 2 ;;
+	--out) OUT=$2; shift 2 ;;
+	--label) LABEL=$2; shift 2 ;;
+	--qos-debug) QDEBUG=yes; shift ;;
+	*) qg_die "unknown argument $1" ;;
+	esac
+done
+[ -n "$POOL" ] && [ -n "$OUT" ] || qg_die "--pool and --out are mandatory"
+mkdir -p "$OUT" || qg_die "cannot create $OUT"
+RES=$OUT/RESULT
+: > "$RES"
+say() { printf '%s\n' "$*" | tee -a "$RES"; }
+FAIL=0
+bad() { say "FAIL $*"; FAIL=$((FAIL + 1)); }
+
+say "label=$LABEL date=$(qg_now)"
+say "os=$(uname -sr) ncpu=$(qg_ncpu)"
+say "module_loaded=$(qg_loaded_module_id)"
+
+qdebug() { # qdebug <0|1>
+	case "$QG_OS" in
+	FreeBSD) sudo sysctl "vfs.zfs.qos_debug=$1" > /dev/null 2>&1 ;;
+	*) echo "$1" | sudo tee /sys/module/zfs/parameters/zfs_qos_debug > /dev/null 2>&1 ;;
+	esac
+}
+dbg() {
+	case "$QG_OS" in
+	FreeBSD) sysctl -n kstat.zfs.misc.dbgmsg 2>/dev/null ;;
+	*) sudo cat /proc/spl/kstat/zfs/dbgmsg 2>/dev/null ;;
+	esac
+}
+[ "$QDEBUG" = yes ] && { qdebug 1 || qg_die "cannot set zfs_qos_debug"; }
+
+DS=$POOL/qg-tbw
+RATE=5242880
+sudo zfs destroy -r "$DS" > /dev/null 2>&1
+sudo zfs create "$DS" || qg_die "cannot create $DS"
+sudo zfs create "$DS/a" || qg_die "cannot create $DS/a"
+sudo zfs create "$DS/b" || qg_die "cannot create $DS/b"
+sudo zfs create -o mountpoint=none "$DS/c" || qg_die "cannot create $DS/c"
+OBJA=$(zfs get -H -p -o value objsetid "$DS/a")
+
+# total, in MiB/s, as logged by the module for dataset a just now; NA when
+# the module logged nothing for it
+total() {
+	sudo zfs set qos:boost_pool=1 "$DS/a"
+	dbg | grep -a "ds $OBJA: " | grep -a -o 'total_bw=[0-9]*' | tail -1 |
+	    awk -F= '{printf "%.0f", $2 / 1048576; f = 1} END {if (!f) print "NA"}'
+}
+printf 'step\ttotal_mib\texpected_mib\tverdict\n' > "$OUT/total_bw.tsv"
+step() { # step <name>
+	_t=$(total)
+	if [ "$_t" = 5 ]; then
+		_v=ok
+	else
+		_v=DRIFT
+		bad "$1: total = $_t MiB/s, expected 5"
+	fi
+	printf '%s\t%s\t5\t%s\n' "$1" "$_t" "$_v" | tee -a "$OUT/total_bw.tsv"
+}
+
+sudo zfs set qos:enabled=on "$DS/a"
+sudo zfs set qos:max_bw_write=$RATE "$DS/a"
+step clean_set
+for i in 1 2 3; do
+	sudo zfs unmount "$DS/a" && sudo zfs mount "$DS/a" || bad "remount $i failed"
+	step "remount_$i"
+done
+sudo zfs set qos:enabled=off "$DS/b"
+sudo zfs set qos:max_bw_write=$RATE "$DS/b"
+step rate_while_off
+sudo zfs set qos:boost=1 "$DS/b"
+sudo zfs set qos:count_arc_hits=on "$DS/b"
+step more_sets_off
+sudo zfs set qos:enabled=off "$DS/c"
+sudo zfs set qos:max_bw_write=$RATE "$DS/c"
+for i in 1 2 3; do
+	zfs get -H -o value used "$DS/c" > /dev/null
+	step "unmounted_off_look_$i"
+done
+
+sudo zfs destroy -r "$DS" > /dev/null 2>&1
+[ "$QDEBUG" = yes ] && qdebug 0
+say "table=$OUT/total_bw.tsv"
+if [ $FAIL -eq 0 ]; then
+	say "RESULT=PASS"
+	exit 0
+fi
+say "RESULT=FAIL ($FAIL)"
+exit 1
diff --git a/tests/qos-gates/diag_zil_readback.sh b/tests/qos-gates/diag_zil_readback.sh
new file mode 100755
index 0000000000000000000000000000000000000000..826828658875fd25819a54b294f100e73ef3f962
--- /dev/null
+++ b/tests/qos-gates/diag_zil_readback.sh
@@ -0,0 +1,265 @@
+#!/bin/sh
+# SPDX-License-Identifier: CDDL-1.0
+#
+# diag_zil_readback.sh — what a write costs on the READ limit of its dataset.
+#
+# When the intent log stores the data of a write in its own record, it gets
+# that data by reading it back from the DMU (zfs_log_write() and
+# zfs_get_data() for files, zvol_log_write() and zvol_get_data() for
+# volumes). That read enters the DMU where the QoS code charges reads, so a
+# logged write is charged twice: once to the write limit, once to the read
+# limit, and it waits for read tokens. The log copies the data
+#   - of every logged write when the pool has a dedicated log device;
+#   - of the writes smaller than zfs_immediate_write_sz (32 KiB) otherwise.
+# A write the log only points to (indirect) is not read back.
+#
+# Not a gate: it gives figures.
+#
+#   diag_zil_readback.sh --pool POOL --out OUTDIR [--label NAME]
+#
+# OUTDIR/write_read_charge.tsv, one line per write pattern on a file, nothing
+# being read during the test and both limits set far above what it can reach:
+# bytes written, bytes charged to the write limit, bytes charged to the READ
+# limit and in how many charges, bytes the intent log copied (the "copied" and
+# "needcopy" counters of the dataset), bytes it logged by pointer, commits.
+# The read charge is expected to equal the bytes the log copied.
+# OUTDIR/timed.tsv: 8 MiB of synchronous 8 KiB writes timed twice, first with
+# both limits out of reach, then with a READ limit of 1 MiB/s and still no
+# reachable write limit: the second time tells what the read limit does to a
+# program that only writes.
+# OUTDIR/pool_hold.tsv: four synchronous writes with the read limit out of
+# reach, then with a read limit low enough to make each of them wait, while
+# "zpool sync" is issued in a loop: how long the writer takes, and the longest
+# time the pool took to sync meanwhile. Done with 16 KiB writes (copied when
+# the log is committed) and with 4 KiB writes (copied when they are logged,
+# transaction open: a wait there holds the transaction group of the whole
+# pool). OUTDIR/hold-<case>.stack: where the writer was waiting, in the
+# kernel.
+#
+# With a module of the published v2.1 or v2.2, the limits set here stay in the
+# pool-wide total of the write limits until the pool is imported again (those
+# versions over-count it, and the share of dirty data each limited dataset
+# may hold is divided by that total): do not run this on a pool that a
+# measurement is about to use.
+
+set -u
+QG_DIR=$(cd "$(dirname "$0")" && pwd)
+. "$QG_DIR/lib.sh"
+
+POOL=; OUT=; LABEL=diag-zil-readback
+while [ $# -gt 0 ]; do
+	case "$1" in
+	--pool) POOL=$2; shift 2 ;;
+	--out) OUT=$2; shift 2 ;;
+	--label) LABEL=$2; shift 2 ;;
+	*) qg_die "unknown argument $1" ;;
+	esac
+done
+[ -n "$POOL" ] && [ -n "$OUT" ] || qg_die "--pool and --out are mandatory"
+case "$(date +%s%N)" in
+*[!0-9]*) qg_die "date +%s%N gives no nanoseconds on this system" ;;
+esac
+mkdir -p "$OUT" || qg_die "cannot create $OUT"
+RES=$OUT/RESULT
+: > "$RES"
+say() { printf '%s\n' "$*" | tee -a "$RES"; }
+
+say "label=$LABEL date=$(qg_now)"
+say "os=$(uname -sr) ncpu=$(qg_ncpu)"
+say "module_loaded=$(qg_loaded_module_id)"
+# a dedicated log device changes what the intent log copies
+if zpool status "$POOL" | grep -q '^[[:space:]]*logs'; then
+	say "dedicated_log=yes ($(zpool status "$POOL" | awk '/^[[:space:]]*logs/ {getline; print $1}'))"
+else
+	say "dedicated_log=no"
+fi
+case "$QG_OS" in
+FreeBSD) say "immediate_write_sz=$(sysctl -n vfs.zfs.immediate_write_sz 2>/dev/null)" ;;
+*) say "immediate_write_sz=$(cat /sys/module/zfs/parameters/zfs_immediate_write_sz 2>/dev/null)" ;;
+esac
+
+DS=$POOL/qg-zrb
+MNT=$(zfs get -H -o value mountpoint "$POOL")/qg-zrb
+sudo zfs destroy -r "$DS" > /dev/null 2>&1
+sudo zfs create -o compression=off -o sync=standard -o recordsize=128K "$DS" ||
+    qg_die "cannot create $DS"
+sudo chown "$(id -u)" "$MNT"
+OBJ=$(printf '%x' "$(zfs get -H -p -o value objsetid "$DS")")
+FAR=1099511627776	# 1 TiB/s: far above what the test can do
+sudo zfs set qos:enabled=on qos:max_bw_read=$FAR qos:max_bw_write=$FAR "$DS" ||
+    qg_die "cannot set the limits"
+
+kstat_val() { # kstat_val <field of the QoS kstat>
+	case "$QG_OS" in
+	FreeBSD) sysctl -n "kstat.zfs.$POOL.qos.qos-0x$OBJ.$1" 2>/dev/null ;;
+	*) awk -v k="$1" '$1 == k {print $3}' "/proc/spl/kstat/zfs/$POOL/qos-0x$OBJ" 2>/dev/null ;;
+	esac
+}
+zil_val() { # zil_val <field of the dataset kstat>
+	case "$QG_OS" in
+	FreeBSD) sysctl -n "kstat.zfs.$POOL.dataset.objset-0x$OBJ.$1" 2>/dev/null ;;
+	*) awk -v k="$1" '$1 == k {print $3}' "/proc/spl/kstat/zfs/$POOL/objset-0x$OBJ" 2>/dev/null ;;
+	esac
+}
+[ -n "$(kstat_val stat_total_bytes_read)" ] || qg_die "no QoS kstat for $DS"
+[ -n "$(zil_val zil_itx_copied_bytes)" ] || say "note: no intent-log counters for $DS"
+
+FAIL=0
+printf 'pattern\tbytes_written\tcharged_write\tcharged_read\tread_charges\tlog_copied_bytes\tlog_indirect_bytes\tlog_commits\tseconds\n' \
+    > "$OUT/write_read_charge.tsv"
+# wpat <name> <bytes written> <shell command writing them, run in $MNT>
+wpat() {
+	_r0=$(kstat_val stat_total_bytes_read); _n0=$(kstat_val stat_total_ios_read)
+	_w0=$(kstat_val stat_total_bytes_write)
+	_c0=$(zil_val zil_itx_copied_bytes); _k0=$(zil_val zil_itx_needcopy_bytes)
+	_i0=$(zil_val zil_itx_indirect_bytes); _m0=$(zil_val zil_commit_count)
+	_t0=$(date +%s%N)
+	( cd "$MNT" && eval "$3" ) > "$OUT/wpat-$1.out" 2>&1 ||
+	    { say "FAIL $1: the write failed"; FAIL=1; return; }
+	_t1=$(date +%s%N)
+	# what was not committed by the log is written by the pool; nothing
+	# more can be charged for this pattern after that
+	sudo zpool sync "$POOL"
+	_r1=$(kstat_val stat_total_bytes_read); _n1=$(kstat_val stat_total_ios_read)
+	_w1=$(kstat_val stat_total_bytes_write)
+	_c1=$(zil_val zil_itx_copied_bytes); _k1=$(zil_val zil_itx_needcopy_bytes)
+	_i1=$(zil_val zil_itx_indirect_bytes); _m1=$(zil_val zil_commit_count)
+	printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$1" "$2" "$((_w1 - _w0))" \
+	    "$((_r1 - _r0))" "$((_n1 - _n0))" \
+	    "$((${_c1:-0} - ${_c0:-0} + ${_k1:-0} - ${_k0:-0}))" \
+	    "$((${_i1:-0} - ${_i0:-0}))" "$((${_m1:-0} - ${_m0:-0}))" \
+	    "$(awk -v a="$_t0" -v b="$_t1" 'BEGIN {printf "%.2f", (b - a) / 1e9}')" |
+	    tee -a "$OUT/write_read_charge.tsv"
+}
+M8=8388608
+# each write is committed before the next one: the log copies small writes
+wpat sync_8k $M8 'dd if=/dev/zero of=f-sync-8k bs=8192 count=1024 oflag=sync'
+# large committed writes: copied with a dedicated log, logged by pointer without
+wpat sync_1m $M8 'dd if=/dev/zero of=f-sync-1m bs=1048576 count=8 oflag=sync'
+# written without waiting, committed once at the end
+wpat fsync_8k $M8 'dd if=/dev/zero of=f-fsync-8k bs=8192 count=1024 conv=fsync'
+wpat fsync_1m $M8 'dd if=/dev/zero of=f-fsync-1m bs=1048576 count=8 conv=fsync'
+# never committed: the log has nothing to copy (expected: no read charge)
+wpat nosync_1m $M8 'dd if=/dev/zero of=f-nosync-1m bs=1048576 count=8'
+
+# The consequence for a program that only writes: the same synchronous 8 KiB
+# writes with a read limit of 1 MiB/s, the write limit staying out of reach.
+printf 'case\tread_limit\tseconds\tcharged_read\tcharged_write\n' > "$OUT/timed.tsv"
+tcase() { # tcase <name> <read limit in bytes/s> <file>
+	sudo zfs set qos:max_bw_read="$2" qos:max_bw_write=$FAR "$DS" || { FAIL=1; return; }
+	sudo zpool sync "$POOL"
+	_r0=$(kstat_val stat_total_bytes_read); _w0=$(kstat_val stat_total_bytes_write)
+	_t0=$(date +%s%N)
+	( cd "$MNT" && dd if=/dev/zero of="$3" bs=8192 count=1024 oflag=sync ) > "$OUT/timed-$1.out" 2>&1 ||
+	    { say "FAIL $1: the write failed"; FAIL=1; return; }
+	_t1=$(date +%s%N)
+	_r1=$(kstat_val stat_total_bytes_read); _w1=$(kstat_val stat_total_bytes_write)
+	printf '%s\t%s\t%s\t%s\t%s\n' "$1" "$2" \
+	    "$(awk -v a="$_t0" -v b="$_t1" 'BEGIN {printf "%.2f", (b - a) / 1e9}')" \
+	    "$((_r1 - _r0))" "$((_w1 - _w0))" | tee -a "$OUT/timed.tsv"
+}
+tcase read_limit_out_of_reach $FAR f-timed-far
+tcase read_limit_1mib 1048576 f-timed-1m
+
+# What the wait of such a writer does to the rest of the pool. A synchronous
+# write of at most zil_maxcopied bytes (7680) is copied into its log record
+# while its transaction is still open (zfs_log_write() runs before
+# dmu_tx_commit()); a larger one is copied when the log is committed, after
+# the transaction. Where reads are charged, the copy waits for read tokens,
+# for up to zfs_qos_read_timeout_ms. A transaction group cannot sync before
+# all its transactions are committed, so "zpool sync" issued meanwhile tells
+# whether, and how long, the whole pool is held: four synchronous writes with
+# the read limit out of reach, then with a read limit so low that each
+# write waits, for both sizes.
+printf 'case\tread_limit\twriter_seconds\tpool_syncs\tlongest_pool_sync_s\tcharged_read\n' > "$OUT/pool_hold.tsv"
+kstack() { # kernel stack of the dd run by the subshell <pid>
+	_c=$(pgrep -P "$1" | head -1)
+	[ -n "$_c" ] || _c=$1
+	echo "== pool sync $_n, pid $_c"
+	case "$QG_OS" in
+	FreeBSD) procstat -kk "$_c" ;;
+	*) sudo cat "/proc/$_c/stack" ;;
+	esac
+}
+hcase() { # hcase <name> <read limit in bytes/s> <size of each write>
+	sudo zfs set qos:max_bw_read="$2" qos:max_bw_write=$FAR "$DS" || { FAIL=1; return; }
+	sudo zpool sync "$POOL"
+	_r0=$(kstat_val stat_total_bytes_read)
+	_t0=$(date +%s%N)
+	( cd "$MNT" && dd if=/dev/zero of="f-hold-$1" bs="$3" count=4 oflag=sync ) > "$OUT/hold-$1.out" 2>&1 &
+	_wp=$!
+	_n=0; _max=0
+	while kill -0 "$_wp" 2> /dev/null; do
+		_s=$(date +%s%N)
+		sudo zpool sync "$POOL"
+		_e=$(date +%s%N)
+		_n=$((_n + 1))
+		[ $((_e - _s)) -gt "$_max" ] && _max=$((_e - _s))
+		# where the writer is waiting, in the kernel: looked at twice
+		if [ "$_n" -eq 5 ] || [ "$_n" -eq 60 ]; then
+			kstack "$_wp" >> "$OUT/hold-$1.stack" 2>&1
+		fi
+	done
+	wait "$_wp" || { say "FAIL $1: the write failed"; FAIL=1; }
+	_t1=$(date +%s%N)
+	_r1=$(kstat_val stat_total_bytes_read)
+	printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$1" "$2" \
+	    "$(awk -v a="$_t0" -v b="$_t1" 'BEGIN {printf "%.2f", (b - a) / 1e9}')" "$_n" \
+	    "$(awk -v m="$_max" 'BEGIN {printf "%.2f", m / 1e9}')" "$((_r1 - _r0))" |
+	    tee -a "$OUT/pool_hold.tsv"
+}
+# 16 KiB writes: larger than zil_maxcopied (7680 bytes), so their data is
+# read back when the log is committed, after the transaction is over
+hcase 16k_read_limit_out_of_reach $FAR 16384
+hcase 16k_read_limit_1kib 1024 16384
+# 4 KiB writes: read back when they are logged, with the transaction open
+hcase 4k_read_limit_out_of_reach $FAR 4096
+hcase 4k_read_limit_256 256 4096
+
+# The same with limits one would really set, and a reader: one process reads
+# 2 MiB of a file in a loop as fast as the read limit lets it, so the read
+# bucket is empty most of the time (with 256 KiB/s it is in debt: a request of
+# 1 MiB is larger than the bucket); another makes synchronous writes of 4 KiB,
+# as a database appending to its journal does (100 of them under 5 MiB/s, 10
+# under 256 KiB/s). OUTDIR/pool_hold_reader.tsv: how long the writer takes and
+# how long the pool takes to sync meanwhile.
+printf 'case\tread_limit\twrites\twriter_seconds\tpool_syncs\tlongest_pool_sync_s\n' > "$OUT/pool_hold_reader.tsv"
+rcase() { # rcase <name> <read limit in bytes/s> <number of writes>
+	sudo zfs set qos:max_bw_read="$2" qos:max_bw_write=$FAR "$DS" || { FAIL=1; return; }
+	sudo zpool sync "$POOL"
+	: > "$OUT/.reader-go"
+	( cd "$MNT" && while [ -e "$OUT/.reader-go" ]; do
+		dd if=f-nosync-1m of=/dev/null bs=1048576 count=2 2> /dev/null
+	done ) &
+	_rd=$!
+	# one request of our own goes through after the reserve of the bucket
+	# is gone: from here on the bucket is empty or in debt
+	( cd "$MNT" && dd if=f-nosync-1m of=/dev/null bs=1048576 count=1 2> /dev/null )
+	_t0=$(date +%s%N)
+	( cd "$MNT" && dd if=/dev/zero of="f-rhold-$1" bs=4096 count="$3" oflag=sync ) > "$OUT/rhold-$1.out" 2>&1 &
+	_wp=$!
+	_n=0; _max=0
+	while kill -0 "$_wp" 2> /dev/null; do
+		_s=$(date +%s%N)
+		sudo zpool sync "$POOL"
+		_e=$(date +%s%N)
+		_n=$((_n + 1))
+		[ $((_e - _s)) -gt "$_max" ] && _max=$((_e - _s))
+	done
+	wait "$_wp" || { say "FAIL $1: the write failed"; FAIL=1; }
+	_t1=$(date +%s%N)
+	unlink "$OUT/.reader-go"
+	wait "$_rd"
+	printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$1" "$2" "$3" \
+	    "$(awk -v a="$_t0" -v b="$_t1" 'BEGIN {printf "%.2f", (b - a) / 1e9}')" "$_n" \
+	    "$(awk -v m="$_max" 'BEGIN {printf "%.2f", m / 1e9}')" | tee -a "$OUT/pool_hold_reader.tsv"
+}
+rcase reader_5mib 5242880 100
+rcase reader_256kib 262144 10
+
+sudo zfs destroy -r "$DS" > /dev/null 2>&1
+if [ "$FAIL" -ne 0 ]; then
+	say "RESULT=INCOMPLETE (a write failed)"
+	exit 1
+fi
+say "RESULT=MEASURED"
diff --git a/tests/qos-gates/diag_zvol_taste.sh b/tests/qos-gates/diag_zvol_taste.sh
new file mode 100755
index 0000000000000000000000000000000000000000..9fafc0a6f9e692e78c9d9591d4276be08c19de8a
--- /dev/null
+++ b/tests/qos-gates/diag_zvol_taste.sh
@@ -0,0 +1,111 @@
+#!/bin/sh
+# SPDX-License-Identifier: CDDL-1.0
+#
+# diag_zvol_taste.sh — FreeBSD: destroy a volume while GEOM is still tasting
+# it. No QoS property is set anywhere.
+#
+# A volume in GEOM mode is tasted by the kernel when it appears and every
+# time a writer closes it. On 2026-11-18 a test VM fell (page fault in
+# zvol_geom_access, fault address 0x50, another thread in
+# zvol_remove_minors_impl) while a diagnostic created, wrote and destroyed
+# volumes of the same name one right after the other. The code involved
+# (module/os/freebsd/zfs/zvol_os.c) is the one of the unmodified tree. This
+# script repeats the sequence so that the unmodified module and the fork can
+# be compared.
+#
+#   diag_zvol_taste.sh --pool POOL --out OUTDIR [--loops 200] [--label NAME]
+#                      [--volmode dev|geom] [--by-default]
+#
+# Each loop: zfs create -V 8M -o volmode=MODE, then zfs destroy at once;
+# every fourth loop writes 1 MiB to the volume first (a close after a write
+# makes GEOM taste again). The loop number is printed before each loop: when
+# the machine falls, the last line received tells how far it went.
+#
+# --volmode dev (default) is the case that fell: "zfs create -o volmode=dev"
+# sets the property after the volume exists, so the volume first appears in
+# the default mode (geom), GEOM starts tasting it, and the change of mode
+# removes that provider right away (zvol_set_volmode_impl). With
+# --volmode geom nothing is removed at creation.
+# --by-default tries the way around: the wanted mode is made the default
+# (vfs.zfs.vol.mode) for the time of the loops and the volume is created
+# without "-o volmode=", so that it appears in its final mode at once.
+# Not a gate. Exit 0 = every loop done and nothing bad in the kernel log.
+
+set -u
+QG_DIR=$(cd "$(dirname "$0")" && pwd)
+. "$QG_DIR/lib.sh"
+
+POOL=; OUT=; LABEL=diag-zvol-taste; LOOPS=200; VMODE=dev; BYDEF=no
+while [ $# -gt 0 ]; do
+	case "$1" in
+	--pool) POOL=$2; shift 2 ;;
+	--out) OUT=$2; shift 2 ;;
+	--label) LABEL=$2; shift 2 ;;
+	--loops) LOOPS=$2; shift 2 ;;
+	--volmode) VMODE=$2; shift 2 ;;
+	--by-default) BYDEF=yes; shift ;;
+	*) qg_die "unknown argument $1" ;;
+	esac
+done
+[ -n "$POOL" ] && [ -n "$OUT" ] || qg_die "--pool and --out are mandatory"
+case "$VMODE" in dev|geom) ;; *) qg_die "--volmode must be dev or geom" ;; esac
+[ "$QG_OS" = FreeBSD ] || qg_die "FreeBSD only: the sequence is about GEOM"
+mkdir -p "$OUT" || qg_die "cannot create $OUT"
+RES=$OUT/RESULT
+: > "$RES"
+say() { printf '%s\n' "$*" | tee -a "$RES"; }
+
+say "label=$LABEL date=$(qg_now)"
+say "os=$(uname -sr) ncpu=$(qg_ncpu)"
+say "module_loaded=$(qg_loaded_module_id)"
+OLDMODE=$(sysctl -n vfs.zfs.vol.mode 2>/dev/null)
+say "loops=$LOOPS volmode=$VMODE by_default=$BYDEF default_volmode=$OLDMODE"
+qg_dmesg > "$OUT/dmesg.before" 2>/dev/null
+
+VOL=$POOL/qg-taste-vol
+sudo zfs destroy "$VOL" > /dev/null 2>&1
+if [ "$BYDEF" = yes ]; then
+	case "$VMODE" in dev) _m=2 ;; *) _m=1 ;; esac
+	sudo sysctl vfs.zfs.vol.mode=$_m > /dev/null || qg_die "cannot set vfs.zfs.vol.mode"
+	VOPT=
+else
+	VOPT="-o volmode=$VMODE"
+fi
+FAIL=0
+i=1
+while [ "$i" -le "$LOOPS" ]; do
+	echo "loop=$i"
+	# shellcheck disable=SC2086
+	if ! sudo zfs create -V 8M $VOPT "$VOL" 2> "$OUT/create.err"; then
+		say "FAIL loop $i: cannot create ($(head -1 "$OUT/create.err" | cut -c1-100))"
+		FAIL=1; break
+	fi
+	if [ $((i % 4)) -eq 0 ]; then
+		sudo dd if=/dev/zero of="/dev/zvol/$VOL" bs=1048576 count=1 > /dev/null 2>&1
+	fi
+	if ! sudo zfs destroy "$VOL" 2> "$OUT/destroy.err"; then
+		# busy: GEOM holds it open while it tastes. Reading the GEOM
+		# configuration waits for the pending events; then once more.
+		sysctl -n kern.geom.conftxt > /dev/null 2>&1
+		if ! sudo zfs destroy "$VOL" 2> "$OUT/destroy.err"; then
+			say "FAIL loop $i: cannot destroy ($(head -1 "$OUT/destroy.err" | cut -c1-100))"
+			FAIL=1; break
+		fi
+	fi
+	i=$((i + 1))
+done
+say "loops_done=$((i - 1))/$LOOPS"
+[ "$BYDEF" = yes ] && sudo sysctl vfs.zfs.vol.mode="$OLDMODE" > /dev/null
+
+qg_dmesg > "$OUT/dmesg.after" 2>/dev/null
+diff "$OUT/dmesg.before" "$OUT/dmesg.after" | grep '^>' > "$OUT/dmesg.new"
+NBAD=$(grep -c -E "$QG_KERN_BAD" "$OUT/dmesg.new")
+say "dmesg_new_lines=$(wc -l < "$OUT/dmesg.new" | tr -d ' ') dmesg_bad=$NBAD"
+[ "$NBAD" -eq 0 ] || { say "FAIL kernel log: $(grep -m1 -E "$QG_KERN_BAD" "$OUT/dmesg.new" | cut -c1-200)"; FAIL=1; }
+
+if [ $FAIL -eq 0 ]; then
+	say "RESULT=PASS"
+	exit 0
+fi
+say "RESULT=FAIL"
+exit 1
diff --git a/tests/qos-gates/g10_compat.sh b/tests/qos-gates/g10_compat.sh
new file mode 100755
index 0000000000000000000000000000000000000000..aa21854779fee74fceed209dfb17ff6ea2f15051
--- /dev/null
+++ b/tests/qos-gates/g10_compat.sh
@@ -0,0 +1,257 @@
+#!/bin/sh
+# SPDX-License-Identifier: CDDL-1.0
+#
+# g10_compat.sh — gate G10 (compatibility): a pool that carries qos:*
+# properties moves between this fork and the unmodified OpenZFS, in both
+# directions, without error.
+#
+# The limits are user properties: the fork adds no pool feature and writes
+# nothing else on disk. This gate checks it from the outside. One phase per
+# invocation; host/run_g10.sh changes the module between the phases:
+#
+#   g10_compat.sh --phase create --pool POOL --out OUTDIR   (module A)
+#   g10_compat.sh --phase other  --pool POOL --out OUTDIR   (module B)
+#   g10_compat.sh --phase back   --pool POOL --out OUTDIR   (module A again)
+#
+# create  builds a small mirrored pool "qg-g10" on two files kept in the
+#         dataset POOL/qg-g10-files: a file system with every qos:* property
+#         set, a child that inherits them, a file system limited to 1 MiB/s
+#         of writes, one without any property, a limited volume, a snapshot;
+#         writes files of known checksums; exports the pool.
+# other   imports it with the other module: same qos:* values, same file
+#         contents, same pool features; writes new files, changes the write
+#         limit to 2 MiB/s, sets a limit on the file system that had none,
+#         removes one property; scrubs; exports.
+# back    imports it again with the first module: the properties are those
+#         the other module left, every file reads back, the scrub is clean.
+#         Then the pool and its files are destroyed.
+# In each phase a write to the limited file system is timed. With the fork it
+# must be held by the limit the properties show at that moment (so a limit
+# set or changed by the unmodified module is the one applied after import);
+# with the unmodified module it must not be held at all.
+# What a phase leaves for the next one is kept in POOL/qg-g10-files/state.
+# Exit 0 = the phase found nothing wrong.
+
+set -u
+QG_DIR=$(cd "$(dirname "$0")" && pwd)
+. "$QG_DIR/lib.sh"
+
+PHASE=; POOL=; OUT=; LABEL=g10-compat
+while [ $# -gt 0 ]; do
+	case "$1" in
+	--phase) PHASE=$2; shift 2 ;;
+	--pool) POOL=$2; shift 2 ;;
+	--out) OUT=$2; shift 2 ;;
+	--label) LABEL=$2; shift 2 ;;
+	*) qg_die "unknown argument $1" ;;
+	esac
+done
+[ -n "$POOL" ] && [ -n "$OUT" ] || qg_die "--pool and --out are mandatory"
+case "$PHASE" in create|other|back) ;; *) qg_die "--phase create|other|back is mandatory" ;; esac
+case "$(date +%s%N)" in
+*[!0-9]*) qg_die "date +%s%N gives no nanoseconds on this system" ;;
+esac
+mkdir -p "$OUT" || qg_die "cannot create $OUT"
+RES=$OUT/RESULT
+: > "$RES"
+say() { printf '%s\n' "$*" | tee -a "$RES"; }
+FAIL=0
+bad() { say "FAIL $*"; FAIL=$((FAIL + 1)); }
+
+# the fork is the module that has the QoS tunables
+case "$QG_OS" in
+FreeBSD) sysctl -n vfs.zfs.qos_debug > /dev/null 2>&1 && FORK=yes || FORK=no ;;
+*) [ -e /sys/module/zfs/parameters/zfs_qos_debug ] && FORK=yes || FORK=no ;;
+esac
+say "label=$LABEL phase=$PHASE date=$(qg_now)"
+say "os=$(uname -sr) ncpu=$(qg_ncpu)"
+say "module_loaded=$(qg_loaded_module_id) qos_code=$FORK"
+qg_dmesg > "$OUT/dmesg.before" 2>/dev/null
+
+TP=qg-g10
+FILES_DS=$POOL/qg-g10-files
+FDIR=$(zfs get -H -o value mountpoint "$POOL")/qg-g10-files
+TMNT=$FDIR/mnt
+STATE=$FDIR/state
+
+props() { # the qos:* properties of the whole test pool, one per line
+	zfs get -H -r -t filesystem,volume,snapshot -o name,property,value,source all $TP |
+	    awk -F'\t' '$2 ~ /^qos:/' | sort
+}
+features() { zpool get -H -o property,value all $TP | awk '$1 ~ /^feature@/' | sort; }
+sums() { # checksum and name of every file of the test pool, and of the volume
+	( cd "$TMNT" && find . -type f | sort | while read -r _f; do
+		printf '%s %s\n' "$(qg_sha256 "$_f")" "$_f"
+	done )
+	printf '%s %s\n' "$(sudo dd if=/dev/zvol/$TP/vol bs=1048576 count=4 2>/dev/null | qg_sha256 /dev/stdin)" "volume:first-4MiB"
+}
+newfile() { # newfile <path under the test pool>
+	dd if=/dev/urandom of="$TMNT/$1" bs=1048576 count=1 2>/dev/null ||
+	    bad "cannot write $1"
+}
+# the write rate the module has configured for the limited file system, as
+# its QoS kstat gives it, or "none" (no kstat: no limit configured)
+configured_rate() {
+	_o=$(printf '%x' "$(zfs get -H -p -o value objsetid $TP/slow)")
+	case "$QG_OS" in
+	FreeBSD) _v=$(sysctl -n "kstat.zfs.$TP.qos.qos-0x$_o.config_bw_rate_write" 2>/dev/null) ;;
+	*) _v=$(awk '$1 == "config_bw_rate_write" {print $3}' \
+	    "/proc/spl/kstat/zfs/$TP/qos-0x$_o" 2>/dev/null) ;;
+	esac
+	[ -n "$_v" ] && echo "$_v" || echo none
+}
+# timed_write <MiB> <expected rate in MiB/s, 0 = no limit expected>
+# The bucket of an idle dataset holds one to two seconds of its rate.
+timed_write() {
+	if [ "$FORK" = yes ] && [ "$2" -gt 0 ]; then
+		_c=$(configured_rate)
+		say "configured_rate=$_c expected=$(($2 * 1048576))"
+		[ "$_c" = "$(($2 * 1048576))" ] ||
+		    bad "the module has configured $_c bytes/s for writes, the property says $(($2 * 1048576))"
+	fi
+	_s=$(date +%s%N)
+	qg_run_bounded 120 "$OUT/dd-timed.out" dd if=/dev/zero of="$TMNT/slow/timed" \
+	    bs=1048576 count="$1" conv=fsync
+	_rc=$?
+	_e=$(date +%s%N)
+	[ $_rc -eq 0 ] || { bad "timed write: dd ended with code $_rc"; return; }
+	_t=$(echo "$_s $_e" | awk '{printf "%.2f", ($2 - $1) / 1000000000}')
+	if [ "$FORK" = yes ] && [ "$2" -gt 0 ]; then
+		# held by that rate: the bucket gives one to two seconds of it
+		# at once, the rest comes at the rate. The margins are narrow
+		# enough to tell 1 MiB/s from 2 MiB/s on the sizes used here.
+		_v=$(echo "$_t $1 $2" | awk '{lo = ($2 - 2 * $3) / $3 * 0.75; hi = ($2 - $3) / $3 * 1.4 + 1;
+		    print ($1 >= lo && $1 <= hi) ? "ok" : "off"}')
+		say "timed_write: $1 MiB in $_t s, limit expected $2 MiB/s: $_v"
+		[ "$_v" = ok ] || bad "the write limit applied is not the $2 MiB/s the properties show ($1 MiB in $_t s)"
+	else
+		_v=$(echo "$_t" | awk '{print ($1 < 1.5) ? "ok" : "off"}')
+		say "timed_write: $1 MiB in $_t s, no limit expected: $_v"
+		[ "$_v" = ok ] || bad "a module without the QoS code held a write ($1 MiB in $_t s)"
+	fi
+	sudo zpool sync $TP
+}
+# settle: wait for the device events of the volume. On FreeBSD reading the
+# GEOM configuration waits for the pending GEOM events; it is also done before
+# the pool is exported or destroyed, because removing a volume that GEOM is
+# still tasting can bring the unmodified OpenZFS 2.4.4 down (FreeBSD bug
+# 292645, see diag_zvol_taste.sh).
+settle() {
+	case "$QG_OS" in
+	FreeBSD) sysctl -n kern.geom.conftxt > /dev/null 2>&1 ;;
+	*) sudo udevadm settle > /dev/null 2>&1 ;;
+	esac
+}
+wait_zvol() {
+	settle
+	[ -e /dev/zvol/$TP/vol ] || bad "the volume has no device node"
+}
+scrub() {
+	sudo zpool scrub -w $TP || bad "scrub did not run"
+	zpool status $TP > "$OUT/zpool-status.txt" 2>&1
+	grep -q 'errors: No known data errors' "$OUT/zpool-status.txt" ||
+	    bad "pool not clean after the scrub (see zpool-status.txt)"
+	grep -q 'with 0 errors' "$OUT/zpool-status.txt" ||
+	    bad "the scrub reports errors (see zpool-status.txt)"
+}
+import_pool() {
+	sudo zpool import -d "$FDIR" -o cachefile=none $TP > "$OUT/import.out" 2>&1 ||
+	    { bad "import failed: $(head -1 "$OUT/import.out" | cut -c1-160)"; return 1; }
+	zpool status -x $TP > "$OUT/zpool-status-x.txt" 2>&1
+	grep -q -i 'unsupported\|not enabled\|degraded\|faulted' "$OUT/zpool-status-x.txt" &&
+	    bad "the pool does not import clean: $(head -3 "$OUT/zpool-status-x.txt" | tr '\n' ' ' | cut -c1-200)"
+	wait_zvol
+	return 0
+}
+finish() {
+	qg_dmesg > "$OUT/dmesg.after" 2>/dev/null
+	diff "$OUT/dmesg.before" "$OUT/dmesg.after" | grep '^>' > "$OUT/dmesg.new"
+	NBAD=$(grep -c -E "$QG_KERN_BAD" "$OUT/dmesg.new")
+	say "dmesg_bad=$NBAD"
+	[ "$NBAD" -eq 0 ] || bad "kernel log: $(grep -m1 -E "$QG_KERN_BAD" "$OUT/dmesg.new" | cut -c1-200)"
+	if [ $FAIL -eq 0 ]; then
+		say "RESULT=PASS"
+		exit 0
+	fi
+	say "RESULT=FAIL ($FAIL)"
+	exit 1
+}
+
+case "$PHASE" in
+create)
+	sudo zpool destroy $TP > /dev/null 2>&1
+	sudo zfs destroy -r "$FILES_DS" > /dev/null 2>&1
+	sudo zfs create -o compression=off "$FILES_DS" || qg_die "cannot create $FILES_DS"
+	sudo chown "$(id -u)" "$FDIR"
+	mkdir -p "$STATE" || qg_die "cannot create $STATE"
+	truncate -s 512M "$FDIR/vdev-a.img" "$FDIR/vdev-b.img" || qg_die "cannot create the vdev files"
+	sudo zpool create -f -o cachefile=none -O compression=off -m "$TMNT" $TP \
+	    mirror "$FDIR/vdev-a.img" "$FDIR/vdev-b.img" || qg_die "cannot create the pool $TP"
+	for _d in lim lim/child slow free; do
+		sudo zfs create $TP/$_d || qg_die "cannot create $TP/$_d"
+	done
+	sudo zfs create -V 64M $TP/vol || qg_die "cannot create the volume"
+	sudo chown -R "$(id -u)" "$TMNT"
+	wait_zvol
+	for _f in lim/f1 lim/f2 lim/f3 lim/f4 lim/child/f1 lim/child/f2 slow/f1 free/f1 free/f2; do
+		newfile "$_f"
+	done
+	sudo dd if=/dev/urandom of=/dev/zvol/$TP/vol bs=1048576 count=4 2>/dev/null ||
+	    bad "cannot write the volume"
+	sudo zfs set qos:enabled=on qos:max_bw_read=8388608 qos:max_bw_write=8388608 \
+	    qos:max_iops_read=1000 qos:max_iops_write=1000 qos:max_iosize=1048576 \
+	    qos:boost=2 qos:boost_pool=1 qos:count_arc_hits=on $TP/lim || bad "cannot set the properties of lim"
+	sudo zfs set qos:enabled=on qos:max_bw_write=1048576 $TP/slow || bad "cannot set the limit of slow"
+	sudo zfs set qos:enabled=on qos:max_bw_read=8388608 qos:max_bw_write=8388608 $TP/vol ||
+	    bad "cannot set the limits of the volume"
+	sudo zfs snapshot $TP/lim@s1 || bad "cannot snapshot"
+	sudo zpool sync $TP
+	timed_write 6 1
+	props > "$STATE/props.create"; features > "$STATE/features.create"; sums > "$STATE/sums.create"
+	cp "$STATE/props.create" "$STATE/features.create" "$STATE/sums.create" "$OUT/"
+	say "properties=$(wc -l < "$STATE/props.create") files=$(wc -l < "$STATE/sums.create") features=$(wc -l < "$STATE/features.create")"
+	echo "$FORK" > "$STATE/fork.create"
+	settle; sudo zpool export $TP || bad "cannot export the pool"
+	;;
+other)
+	[ -r "$STATE/props.create" ] || qg_die "no state of a create phase in $STATE"
+	[ "$(cat "$STATE/fork.create")" != "$FORK" ] ||
+	    qg_die "this is the module of the create phase: the other one must be loaded"
+	import_pool || finish
+	props > "$OUT/props.seen"; features > "$OUT/features.seen"; sums > "$OUT/sums.seen"
+	cmp -s "$STATE/props.create" "$OUT/props.seen" || bad "the qos:* properties differ from those set at creation"
+	cmp -s "$STATE/features.create" "$OUT/features.seen" || bad "the pool features differ from those at creation"
+	# the timed file is not part of the comparison: each phase rewrites it
+	grep -v ' ./slow/timed$' "$STATE/sums.create" > "$OUT/sums.expected"
+	grep -v ' ./slow/timed$' "$OUT/sums.seen" | cmp -s "$OUT/sums.expected" - ||
+	    bad "file contents differ from those written at creation"
+	timed_write 6 1
+	for _f in lim/o1 lim/child/o1 free/o1; do newfile "$_f"; done
+	sudo zfs set qos:max_bw_write=2097152 $TP/slow || bad "cannot change the limit of slow"
+	sudo zfs set qos:enabled=on qos:max_bw_read=4194304 $TP/free || bad "cannot set a limit on free"
+	sudo zfs inherit qos:max_iosize $TP/lim || bad "cannot remove qos:max_iosize from lim"
+	sudo zpool sync $TP
+	scrub
+	props > "$STATE/props.other"; sums > "$STATE/sums.other"
+	cp "$STATE/props.other" "$STATE/sums.other" "$OUT/"
+	say "properties=$(wc -l < "$STATE/props.other") files=$(wc -l < "$STATE/sums.other")"
+	settle; sudo zpool export $TP || bad "cannot export the pool"
+	;;
+back)
+	[ -r "$STATE/props.other" ] || qg_die "no state of an other phase in $STATE"
+	[ "$(cat "$STATE/fork.create")" = "$FORK" ] ||
+	    qg_die "this is not the module of the create phase"
+	import_pool || finish
+	props > "$OUT/props.seen"; features > "$OUT/features.seen"; sums > "$OUT/sums.seen"
+	cmp -s "$STATE/props.other" "$OUT/props.seen" || bad "the qos:* properties differ from those the other module left"
+	cmp -s "$STATE/features.create" "$OUT/features.seen" || bad "the pool features differ from those at creation"
+	grep -v ' ./slow/timed$' "$STATE/sums.other" > "$OUT/sums.expected"
+	grep -v ' ./slow/timed$' "$OUT/sums.seen" | cmp -s "$OUT/sums.expected" - ||
+	    bad "file contents differ from those the other module left"
+	timed_write 12 2
+	scrub
+	settle; sudo zpool destroy $TP || bad "cannot destroy the pool"
+	sudo zfs destroy -r "$FILES_DS" || bad "cannot destroy $FILES_DS"
+	;;
+esac
+finish
diff --git a/tests/qos-gates/g2_noqos.sh b/tests/qos-gates/g2_noqos.sh
new file mode 100755
index 0000000000000000000000000000000000000000..40fda5ec71651f507d5ce179a3f32250c59adc6b
--- /dev/null
+++ b/tests/qos-gates/g2_noqos.sh
@@ -0,0 +1,216 @@
+#!/bin/sh
+# SPDX-License-Identifier: CDDL-1.0
+#
+# g2_noqos.sh — gate G2: with no QoS property set, the module under test must
+# survive what the unmodified module survives.
+#
+# Scenario (reported on FreeBSD 15 against this fork, 2026-09):
+#   1. ztest, with its vdev files on a filesystem served by the kernel module
+#      under test;
+#   2. N times: import the ztest pool into the kernel, then export it;
+#   3. a second, shorter ztest pass in a new directory.
+#
+#   g2_noqos.sh --dir DIR --out OUTDIR [--label NAME] [--ztest PATH]
+#               [--time 90] [--pass 30] [--ztest-args "-VV -G -v 1"]
+#               [--cycles 3] [--second-time 60] [--import-by dir|cachefile]
+#               [--altroot /mnt] [--scrub] [--step-timeout 600] [--debug-kernel]
+#
+#   --dir DIR        work area. Must live on ZFS served by the module under
+#                    test. DIR/p1 and DIR/p2 are created and must not exist.
+#                    With --dir /tmp the run has the exact reported shape:
+#                    ztest uses its default directory, nothing is created.
+#   --import-by      dir: zpool import -d <dir>; cachefile: zpool import -c
+#                    <dir>/zpool.cache (what the report used).
+#
+# Exit 0 = PASS. The verdict only means something next to a control run:
+# same machine, same day, unmodified module, same ztest binary.
+
+set -u
+QG_DIR=$(cd "$(dirname "$0")" && pwd)
+. "$QG_DIR/lib.sh"
+
+DIR=; OUT=; LABEL=g2
+ZTEST=$(command -v ztest 2>/dev/null)
+TIME=90; PASS=30; ZARGS="-VV -G -v 1"
+CYCLES=3; SECOND=60; IMPORT_BY=dir; ALTROOT=/mnt; SCRUB=no; STEP_TMO=600; DEBUGK=no
+
+while [ $# -gt 0 ]; do
+	case "$1" in
+	--dir) DIR=$2; shift 2 ;;
+	--out) OUT=$2; shift 2 ;;
+	--label) LABEL=$2; shift 2 ;;
+	--ztest) ZTEST=$2; shift 2 ;;
+	--time) TIME=$2; shift 2 ;;
+	--pass) PASS=$2; shift 2 ;;
+	--ztest-args) ZARGS=$2; shift 2 ;;
+	--cycles) CYCLES=$2; shift 2 ;;
+	--second-time) SECOND=$2; shift 2 ;;
+	--import-by) IMPORT_BY=$2; shift 2 ;;
+	--altroot) ALTROOT=$2; shift 2 ;;
+	--scrub) SCRUB=yes; shift ;;
+	--debug-kernel) DEBUGK=yes; shift ;;
+	--step-timeout) STEP_TMO=$2; shift 2 ;;
+	*) qg_die "unknown argument $1" ;;
+	esac
+done
+
+[ -n "$DIR" ] && [ -n "$OUT" ] || qg_die "--dir and --out are mandatory"
+[ -n "$ZTEST" ] && [ -x "$ZTEST" ] || qg_die "ztest binary not found (--ztest)"
+case "$IMPORT_BY" in dir|cachefile) ;; *) qg_die "--import-by dir|cachefile" ;; esac
+mkdir -p "$OUT" || qg_die "cannot create $OUT"
+[ "$DEBUGK" = yes ] && qg_require_debug_kernel
+
+if [ "$DIR" = /tmp ]; then
+	P1=/tmp; P2=
+	# Leftovers of an earlier pass are part of the conditions: record them.
+	ls -la /tmp | grep -E ' (ztest[._]|zpool\.cache)' > "$OUT/tmp-leftovers.before" 2>/dev/null
+else
+	P1=$DIR/p1; P2=$DIR/p2
+	[ -e "$P1" ] || [ -e "$P2" ] && qg_die "$P1 or $P2 already exists: one new directory per pass"
+	mkdir -p "$P1" || qg_die "cannot create $P1"
+fi
+
+RES=$OUT/RESULT
+: > "$RES"
+FAIL=0
+say() { printf '%s\n' "$*" | tee -a "$RES"; }
+bad() { say "FAIL $*"; FAIL=$((FAIL + 1)); }
+
+T0=$(date +%s)
+
+# --- conditions -------------------------------------------------------------
+DS=$(zfs list -H -o name "$P1" 2>/dev/null)
+[ -n "$DS" ] || qg_die "$P1 is not on ZFS: the gate would not exercise the module"
+say "label=$LABEL date=$(qg_now)"
+say "os=$(uname -sr) ncpu=$(qg_ncpu)"
+say "module_loaded=$(qg_loaded_module_id)"
+say "zfs_version=$(zfs version 2>/dev/null | tr '\n' ' ')"
+say "ztest_binary=$ZTEST sha256=$(qg_sha256 "$ZTEST")"
+# In a build tree, $ZTEST is a libtool wrapper: name the real binary too.
+ZREAL=$(dirname "$ZTEST")/.libs/$(basename "$ZTEST")
+[ -f "$ZREAL" ] && say "ztest_real=$ZREAL sha256=$(qg_sha256 "$ZREAL")"
+say "ztest_args=$ZARGS time=$TIME pass=$PASS second=$SECOND cycles=$CYCLES import_by=$IMPORT_BY scrub=$SCRUB"
+say "dataset=$DS avail=$(zfs get -H -o value available "$DS")"
+zfs get -H -o property,value,source \
+    compression,recordsize,quota,refquota,sync,primarycache,atime,logbias,dedup,encryption \
+    "$DS" > "$OUT/dataset-props.txt" 2>&1
+zfs get -H -o property,value,source direct "$DS" >> "$OUT/dataset-props.txt" 2>/dev/null
+
+# The gate is "no QoS": refuse to run if any qos:* property applies.
+QP=$(zfs get -H -o name,property,value,source all "$DS" 2>/dev/null | grep -c 'qos:')
+say "qos_properties_in_effect=$QP"
+[ "$QP" -eq 0 ] || qg_die "qos:* properties apply to $DS — not a no-QoS run"
+
+qg_dmesg > "$OUT/dmesg.before" 2>/dev/null
+
+run_step() { # run_step <name> <timeout> <command...>
+	_n=$1; _t=$2; shift 2
+	qg_run_bounded "$_t" "$OUT/$_n.out" "$@"
+	_rc=$?
+	printf 'step=%s rc=%s\n' "$_n" "$_rc" >> "$OUT/steps.txt"
+	return $_rc
+}
+
+hang_report() { # called when a step timed out: keep the kernel stacks
+	case "$QG_OS" in
+	FreeBSD) sudo procstat -kk -a > "$OUT/hang-procstat-kk.txt" 2>&1 ;;
+	*) for p in $(pgrep -x zpool) $(pgrep -x ztest); do
+		echo "== pid $p"; sudo cat /proc/"$p"/stack 2>&1
+	   done > "$OUT/hang-stacks.txt" ;;
+	esac
+}
+
+# --- pass 1 -----------------------------------------------------------------
+qg_log "ztest pass 1 (${TIME}s) in $P1"
+if [ "$P1" = /tmp ]; then
+	# shellcheck disable=SC2086
+	run_step ztest-p1 $((TIME + 900)) "$ZTEST" $ZARGS -T "$TIME" -P "$PASS"
+else
+	# shellcheck disable=SC2086
+	run_step ztest-p1 $((TIME + 900)) "$ZTEST" $ZARGS -T "$TIME" -P "$PASS" -f "$P1"
+fi
+RC=$?
+say "ztest_p1_rc=$RC"
+[ $RC -eq 0 ] || bad "ztest pass 1 rc=$RC ($(tail -1 "$OUT/ztest-p1.out" | cut -c1-200))"
+ls -la "$P1" | grep -E ' (ztest[._]|zpool\.cache)' > "$OUT/p1-files.txt" 2>/dev/null
+
+# --- kernel import / export ---------------------------------------------------
+# ztest leaves an empty zpool.cache when its last pass ended normally instead
+# of being killed: the cachefile shape is then not runnable, whatever the
+# module. Say so and import by directory.
+if [ "$IMPORT_BY" = cachefile ] && [ ! -s "$P1/zpool.cache" ]; then
+	say "cachefile_empty=yes import_by=dir (fallback)"
+	IMPORT_BY=dir
+fi
+CYC_OK=0
+i=1
+while [ "$i" -le "$CYCLES" ] && [ $RC -eq 0 ]; do
+	if [ "$IMPORT_BY" = cachefile ]; then
+		run_step "import-$i" "$STEP_TMO" sudo zpool import -c "$P1/zpool.cache" -R "$ALTROOT" ztest
+	else
+		run_step "import-$i" "$STEP_TMO" sudo zpool import -d "$P1" -R "$ALTROOT" ztest
+	fi
+	IRC=$?
+	if [ $IRC -ge 124 ]; then
+		bad "cycle $i: zpool import did not return within ${STEP_TMO}s"
+		hang_report; break
+	fi
+	# import may return non-zero only because the root dataset cannot be mounted
+	H=$(sudo zpool list -H -o health ztest 2>/dev/null)
+	if [ -z "$H" ]; then
+		bad "cycle $i: pool not imported (rc=$IRC: $(tail -1 "$OUT/import-$i.out" | cut -c1-160))"
+		break
+	fi
+	sudo zpool status -v ztest > "$OUT/status-$i.out" 2>&1
+	say "cycle=$i import_rc=$IRC health=$H scan=$(grep -m1 'scan:' "$OUT/status-$i.out" | cut -c1-90)"
+	case "$H" in SUSPENDED|FAULTED|UNAVAIL) bad "cycle $i: pool health $H" ;; esac
+	if [ "$SCRUB" = yes ] && [ "$i" -eq 1 ]; then
+		run_step "scrub-$i" "$STEP_TMO" sudo zpool scrub -w ztest
+		SRC=$?
+		[ $SRC -ge 124 ] && { bad "cycle $i: scrub did not finish"; hang_report; break; }
+		sudo zpool status -v ztest > "$OUT/status-$i-after-scrub.out" 2>&1
+	fi
+	run_step "export-$i" "$STEP_TMO" sudo zpool export ztest
+	ERC=$?
+	if [ $ERC -ge 124 ]; then
+		bad "cycle $i: zpool export did not return within ${STEP_TMO}s"
+		hang_report; break
+	fi
+	[ $ERC -eq 0 ] || { bad "cycle $i: zpool export rc=$ERC"; break; }
+	CYC_OK=$((CYC_OK + 1))
+	i=$((i + 1))
+done
+say "cycles_ok=$CYC_OK/$CYCLES"
+[ "$CYC_OK" -eq "$CYCLES" ] || [ $RC -ne 0 ] || bad "only $CYC_OK of $CYCLES import/export cycles"
+
+# --- pass 2 -------------------------------------------------------------------
+if [ "$SECOND" -gt 0 ] && [ -n "$P2" ] && [ $FAIL -eq 0 ]; then
+	mkdir -p "$P2"
+	qg_log "ztest pass 2 (${SECOND}s) in $P2"
+	# shellcheck disable=SC2086
+	run_step ztest-p2 $((SECOND + 900)) "$ZTEST" $ZARGS -T "$SECOND" -P "$PASS" -f "$P2"
+	RC2=$?
+	say "ztest_p2_rc=$RC2"
+	[ $RC2 -eq 0 ] || bad "ztest pass 2 rc=$RC2 ($(tail -1 "$OUT/ztest-p2.out" | cut -c1-200))"
+fi
+
+# --- kernel log ---------------------------------------------------------------
+qg_dmesg > "$OUT/dmesg.after" 2>/dev/null
+diff "$OUT/dmesg.before" "$OUT/dmesg.after" | grep '^>' > "$OUT/dmesg.new"
+KPAT=$QG_KERN_BAD
+if [ "$DEBUGK" = yes ]; then
+	KPAT=$QG_KERN_BAD_DEBUG
+	qg_lor_pairs "$OUT/lor-pairs.txt"
+	say "lock_order_reversals_since_boot=$(wc -l < "$OUT/lor-pairs.txt" | tr -d " ")"
+fi
+NBAD=$(grep -c -E "$KPAT" "$OUT/dmesg.new")
+say "dmesg_new_lines=$(wc -l < "$OUT/dmesg.new" | tr -d ' ') dmesg_bad=$NBAD"
+[ "$NBAD" -eq 0 ] || bad "kernel log: $(grep -m1 -E "$KPAT" "$OUT/dmesg.new" | cut -c1-200)"
+
+say "seconds=$(( $(date +%s) - T0 ))"
+if [ $FAIL -eq 0 ]; then
+	say "RESULT=PASS"
+	exit 0
+fi
+say "RESULT=FAIL ($FAIL)"
+exit 1
diff --git a/tests/qos-gates/g5_arc_hits.sh b/tests/qos-gates/g5_arc_hits.sh
new file mode 100755
index 0000000000000000000000000000000000000000..0f9f31c7423195b4d7a7da4df6bc044f64697deb
--- /dev/null
+++ b/tests/qos-gates/g5_arc_hits.sh
@@ -0,0 +1,120 @@
+#!/bin/sh
+# SPDX-License-Identifier: CDDL-1.0
+#
+# g5_arc_hits.sh — gate G5 (robustness), what qos:count_arc_hits really does.
+#
+# The documentation says: by default every read is charged; with
+# qos:count_arc_hits=off only the reads that go to the disk are. This gate
+# reads a small file under a read limit in the four combinations (property on
+# or off, data in the cache or not) and reports whether the read was limited.
+# Data is kept out of the cache with primarycache=metadata on a second
+# dataset, so the pool does not have to be exported.
+#
+#   g5_arc_hits.sh --pool POOL --out OUTDIR [--label NAME]
+#
+# File of 6 MiB, limit of 1 MiB/s (the bucket holds 2 MiB): a limited read
+# takes at least 4 s, an unlimited one a fraction of a second.
+# OUTDIR/arc_hits.tsv: case, seconds, limited (yes, no, unclear), documented,
+# verdict. Exit 0 = the four cases behave as documented and nothing hung.
+
+set -u
+QG_DIR=$(cd "$(dirname "$0")" && pwd)
+. "$QG_DIR/lib.sh"
+
+POOL=; OUT=; LABEL=g5-arc-hits
+while [ $# -gt 0 ]; do
+	case "$1" in
+	--pool) POOL=$2; shift 2 ;;
+	--out) OUT=$2; shift 2 ;;
+	--label) LABEL=$2; shift 2 ;;
+	*) qg_die "unknown argument $1" ;;
+	esac
+done
+[ -n "$POOL" ] && [ -n "$OUT" ] || qg_die "--pool and --out are mandatory"
+case "$(date +%s%N)" in
+*[!0-9]*) qg_die "date +%s%N gives no nanoseconds on this system" ;;
+esac
+mkdir -p "$OUT" || qg_die "cannot create $OUT"
+RES=$OUT/RESULT
+: > "$RES"
+say() { printf '%s\n' "$*" | tee -a "$RES"; }
+FAIL=0
+bad() { say "FAIL $*"; FAIL=$((FAIL + 1)); }
+
+say "label=$LABEL date=$(qg_now)"
+say "os=$(uname -sr) ncpu=$(qg_ncpu)"
+say "module_loaded=$(qg_loaded_module_id)"
+qg_dmesg > "$OUT/dmesg.before" 2>/dev/null
+
+MNTP=$(zfs get -H -o value mountpoint "$POOL")
+DSC=$POOL/qg-hits-cached
+DSU=$POOL/qg-hits-uncached
+FILE_MIB=6
+RATE=1048576
+
+mk() { # mk <dataset> <primarycache>
+	sudo zfs destroy -r "$1" >/dev/null 2>&1
+	sudo zfs create -o compression=off -o primarycache="$2" "$1" ||
+	    qg_die "cannot create $1"
+	sudo chown "$(id -u)" "$MNTP/${1#*/}"
+	dd if=/dev/urandom of="$MNTP/${1#*/}/f" bs=1048576 count=$FILE_MIB 2>/dev/null ||
+	    qg_die "cannot write the test file of $1"
+}
+mk "$DSC" all
+mk "$DSU" metadata
+sudo zpool sync "$POOL"
+# the cached case needs the data in memory before the limit is set
+cat "$MNTP/${DSC#*/}/f" > /dev/null
+say "primarycache: $(zfs get -H -o name,value primarycache "$DSC" "$DSU" | tr '\t\n' '= ')"
+
+# seconds taken to read the file, or HANG / ERROR
+tread() { # tread <file>
+	_s=$(date +%s%N)
+	qg_run_bounded 60 "$OUT/dd.out" dd if="$1" of=/dev/null bs=1048576
+	_rc=$?
+	_e=$(date +%s%N)
+	if [ $_rc -eq 124 ]; then echo HANG; return; fi
+	if [ $_rc -ne 0 ]; then echo ERROR; return; fi
+	echo "$_s $_e" | awk '{printf "%.2f", ($2 - $1) / 1000000000}'
+}
+
+printf 'case\tseconds\tlimited\tdocumented\tverdict\n' > "$OUT/arc_hits.tsv"
+run_case() { # run_case <name> <dataset> <on|off> <documented: yes|no>
+	sudo zfs set qos:enabled=on qos:max_bw_read=$RATE "qos:count_arc_hits=$3" "$2" ||
+	    qg_die "cannot set the limit on $2"
+	_t=$(tread "$MNTP/${2#*/}/f")
+	case "$_t" in
+	HANG|ERROR) _lim=$_t ;;
+	*) _lim=$(echo "$_t" | awk '{print ($1 >= 3) ? "yes" : (($1 < 1.5) ? "no" : "unclear")}') ;;
+	esac
+	if [ "$_lim" = "$4" ]; then
+		_v=ok
+	else
+		_v=MISMATCH
+		bad "$1: read limited=$_lim (${_t} s), the documentation says $4"
+	fi
+	printf '%s\t%s\t%s\t%s\t%s\n' "$1" "$_t" "$_lim" "$4" "$_v" | tee -a "$OUT/arc_hits.tsv"
+	for _p in qos:max_bw_read qos:count_arc_hits qos:enabled; do
+		sudo zfs inherit "$_p" "$2"
+	done
+}
+run_case hits_on_cached "$DSC" on yes
+run_case hits_off_cached "$DSC" off no
+run_case hits_on_uncached "$DSU" on yes
+run_case hits_off_uncached "$DSU" off yes
+
+sudo zfs destroy -r "$DSC" >/dev/null 2>&1
+sudo zfs destroy -r "$DSU" >/dev/null 2>&1
+qg_dmesg > "$OUT/dmesg.after" 2>/dev/null
+diff "$OUT/dmesg.before" "$OUT/dmesg.after" | grep '^>' > "$OUT/dmesg.new"
+NBAD=$(grep -c -E "$QG_KERN_BAD" "$OUT/dmesg.new")
+say "dmesg_bad=$NBAD"
+[ "$NBAD" -eq 0 ] || bad "kernel log: $(grep -m1 -E "$QG_KERN_BAD" "$OUT/dmesg.new" | cut -c1-200)"
+say "table=$OUT/arc_hits.tsv"
+
+if [ $FAIL -eq 0 ]; then
+	say "RESULT=PASS"
+	exit 0
+fi
+say "RESULT=FAIL ($FAIL)"
+exit 1
