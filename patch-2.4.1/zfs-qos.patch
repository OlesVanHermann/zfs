index 0000000000000000000000000000000000000000..1a879109ee92c35dd21f8be483fe7dd392ca2554
--- /dev/null
+++ b/tests/qos-gates/build.sh
@@ -0,0 +1,198 @@
+#!/bin/sh
+# SPDX-License-Identifier: CDDL-1.0
+#
+# build.sh — canonical build of an OpenZFS tree (fork or upstream), with the
+# checks that a successful exit code does not give.
+#
+# Runs on the machine that will load the module (Linux or FreeBSD).
+#
+#   build.sh <srcdir> --expect-qos yes|no [--label NAME] [--debug]
+#            [--invariants] [--jobs N]
+#
+#   --expect-qos yes   fork tree: QoS objects must be linked in the module
+#   --expect-qos no    upstream control: no qos_ symbol at all
+#   --debug            ./configure --enable-debug (ZFS assertions)
+#   --invariants       FreeBSD only, with --debug: build for an INVARIANTS
+#                      kernel (set KERNBUILDDIR to that kernel's build dir)
+#
+# Result: <srcdir>/BUILDINFO and <srcdir>/qg-build.log. Exit 0 only if the
+# build succeeded AND every check passed.
+#
+# Why this exists: a module built with CFLAGS taken from the environment
+# lost -O2 (kernel stack overflow under scrub), and a tree whose FreeBSD
+# makefile missed the QoS objects still built with exit code 0.
+
+set -u
+QG_DIR=$(cd "$(dirname "$0")" && pwd)
+. "$QG_DIR/lib.sh"
+
+SRC=
+LABEL=
+EXPECT_QOS=
+DEBUG=no
+INVARIANTS=no
+JOBS=$(qg_ncpu)
+
+while [ $# -gt 0 ]; do
+	case "$1" in
+	--expect-qos) EXPECT_QOS=$2; shift 2 ;;
+	--label) LABEL=$2; shift 2 ;;
+	--debug) DEBUG=yes; shift ;;
+	--invariants) INVARIANTS=yes; shift ;;
+	--jobs) JOBS=$2; shift 2 ;;
+	-*) qg_die "unknown option $1" ;;
+	*) SRC=$1; shift ;;
+	esac
+done
+
+[ -n "$SRC" ] && [ -d "$SRC" ] || qg_die "usage: build.sh <srcdir> --expect-qos yes|no"
+case "$EXPECT_QOS" in yes|no) ;; *) qg_die "--expect-qos yes|no is mandatory" ;; esac
+SRC=$(cd "$SRC" && pwd)
+[ -n "$LABEL" ] || LABEL=$(basename "$SRC")
+
+# Flags must come from the build system, never from the caller's environment.
+for v in CFLAGS CPPFLAGS COPTFLAGS DEBUG_FLAGS KCFLAGS EXTRA_CFLAGS; do
+	eval "val=\${$v:-}"
+	[ -z "$val" ] || qg_die "$v is set in the environment ('$val'): refusing to build"
+done
+
+LOG=$SRC/qg-build.log
+INFO=$SRC/BUILDINFO
+: > "$LOG"
+FAIL=0
+note() { printf '%s\n' "$*" | tee -a "$INFO"; }
+check() { # check <name> <ok|ko> <detail>
+	if [ "$2" = ok ]; then
+		note "CHECK $1 ok $3"
+	else
+		note "CHECK $1 FAILED $3"
+		FAIL=$((FAIL + 1))
+	fi
+}
+
+CONF_OPTS=
+[ "$DEBUG" = yes ] && CONF_OPTS="$CONF_OPTS --enable-debug"
+[ "$INVARIANTS" = yes ] && CONF_OPTS="$CONF_OPTS --enable-invariants"
+
+T0=$(date +%s)
+cd "$SRC" || qg_die "cd $SRC"
+
+: > "$INFO"
+note "label=$LABEL"
+note "date=$(qg_now)"
+note "os=$QG_OS kernel=$(uname -r) ncpu=$(qg_ncpu)"
+note "gitrev=$(sed -n 's/^#define[[:blank:]]ZFS_META_GITREV "\(.*\)"$/\1/p' include/zfs_gitrev.h 2>/dev/null)"
+note "configure_opts=${CONF_OPTS:-<none>}"
+note "expect_qos=$EXPECT_QOS debug=$DEBUG invariants=$INVARIANTS jobs=$JOBS"
+note "kernbuilddir=${KERNBUILDDIR:-<default>}"
+
+if [ ! -x ./configure ]; then
+	qg_log "autogen" | tee -a "$LOG"
+	sh ./autogen.sh >> "$LOG" 2>&1 || { check autogen ko "see $LOG"; exit 1; }
+fi
+STAMP=$SRC/.qg-configured
+if [ ! -f "$STAMP" ] || [ "$(cat "$STAMP")" != "opts:$CONF_OPTS" ]; then
+	qg_log "configure $CONF_OPTS" | tee -a "$LOG"
+	# FreeBSD: automake's dependency bootstrap needs GNU make.
+	# shellcheck disable=SC2086
+	if [ "$QG_OS" = FreeBSD ]; then
+		MAKE=gmake ./configure $CONF_OPTS >> "$LOG" 2>&1
+	else
+		./configure $CONF_OPTS >> "$LOG" 2>&1
+	fi || { check configure ko "see $LOG"; exit 1; }
+	printf 'opts:%s' "$CONF_OPTS" > "$STAMP"
+fi
+qg_log "make -j$JOBS" | tee -a "$LOG"
+if [ "$QG_OS" = Linux ]; then
+	qg_make -j"$JOBS" V=1 >> "$LOG" 2>&1
+else
+	qg_make -j"$JOBS" >> "$LOG" 2>&1
+fi
+RC=$?
+[ $RC -eq 0 ] && check build ok "rc=0" || check build ko "rc=$RC, see $LOG"
+[ $RC -eq 0 ] || { note "result=FAIL"; exit 1; }
+
+case "$QG_OS" in
+FreeBSD) KO=$SRC/module/openzfs.ko ;;
+*) KO=$SRC/module/zfs.ko ;;
+esac
+[ -f "$KO" ] && check module ok "$KO" || { check module ko "$KO missing"; note "result=FAIL"; exit 1; }
+
+# --- optimisation level actually used for the kernel objects -------------
+case "$QG_OS" in
+FreeBSD)
+	# The compile command of dsl_scan.c, as make echoed it. With parallel
+	# jobs two commands sometimes share a line and this one is cut in two:
+	# its head, where the flags are, is then not on the line that names
+	# the file. Every object of the module is compiled with the same
+	# flags, so take them from the command of another file of module/zfs
+	# (the stack frame checked below is measured on dsl_scan itself).
+	CL=$(grep -m1 -E '^cc .*(^|[[:space:]/])dsl_scan\.c([[:space:]]|$)' "$LOG")
+	if [ -z "$CL" ]; then
+		CL=$(grep -m1 -E '^cc .*/module/zfs/[a-z_]+\.c([[:space:]]|$)' "$LOG")
+		[ -n "$CL" ] && note "optflags_from=another object of module/zfs (the line of dsl_scan.c is cut by parallel output)"
+	fi
+	;;
+*)
+	CL=$(cat "$SRC/module/zfs/.dsl_scan.o.cmd" 2>/dev/null | head -1)
+	;;
+esac
+OPT=$(printf '%s\n' "$CL" | tr ' ' '\n' | grep -E '^-O' | tr '\n' ' ')
+note "optflags_dsl_scan=${OPT:-<none>}"
+if [ "$DEBUG" = no ]; then
+	case " $OPT" in
+	*" -O0"*|*" -Og"*) check optimisation ko "found '$OPT'" ;;
+	*" -O2"*) check optimisation ok "-O2" ;;
+	*) check optimisation ko "no -O2 in the dsl_scan.c compile line ('$OPT')" ;;
+	esac
+fi
+
+# --- stack frame of the recursive scan function ---------------------------
+FRAME=$(objdump -d --no-show-raw-insn "$KO" 2>/dev/null |
+    grep -A20 -E '<dsl_scan_visitbp[^>]*>:' | grep -m1 -E 'sub[q]?[[:space:]]+\$0x[0-9a-f]+,[[:space:]]*%rsp' |
+    sed -n 's/.*\$0x\([0-9a-f]*\),.*/\1/p')
+if [ -n "$FRAME" ]; then
+	FRAME_DEC=$(printf '%d' "0x$FRAME")
+	note "frame_dsl_scan_visitbp=$FRAME_DEC"
+	if [ "$DEBUG" = no ]; then
+		[ "$FRAME_DEC" -le 512 ] && check stackframe ok "$FRAME_DEC bytes" ||
+		    check stackframe ko "$FRAME_DEC bytes per recursion level (limit 512)"
+	fi
+else
+	note "frame_dsl_scan_visitbp=unknown"
+fi
+
+# --- QoS objects really linked, nothing left unresolved --------------------
+QDEF=$(nm "$KO" 2>/dev/null | grep -c -E ' [TtDdBbRr] qos_')
+QUND=$(nm "$KO" 2>/dev/null | grep -c -E ' U qos_')
+note "qos_symbols_defined=$QDEF qos_symbols_undefined=$QUND"
+if [ "$EXPECT_QOS" = yes ]; then
+	[ "$QDEF" -gt 0 ] && [ "$QUND" -eq 0 ] && check qos_linked ok "$QDEF defined, 0 undefined" ||
+	    check qos_linked ko "$QDEF defined, $QUND undefined"
+else
+	[ "$QDEF" -eq 0 ] && [ "$QUND" -eq 0 ] && check no_qos ok "control tree" ||
+	    check no_qos ko "$QDEF defined, $QUND undefined in a control tree"
+fi
+
+# --- identity ---------------------------------------------------------------
+note "module=$KO"
+note "module_sha256=$(qg_sha256 "$KO")"
+if [ "$QG_OS" = Linux ]; then
+	note "module_srcversion=$(modinfo -F srcversion "$KO" 2>/dev/null)"
+	note "module_vermagic=$(modinfo -F vermagic "$KO" 2>/dev/null)"
+fi
+for b in ztest zdb zpool zfs; do
+	if [ -x "$SRC/$b" ]; then
+		note "userland_$b=present"
+	else
+		note "userland_$b=MISSING"
+	fi
+done
+note "build_seconds=$(( $(date +%s) - T0 ))"
+
+if [ $FAIL -eq 0 ]; then
+	note "result=PASS"
+	exit 0
+fi
+note "result=FAIL ($FAIL check(s))"
+exit 1
diff --git a/tests/qos-gates/cfr_tool.c b/tests/qos-gates/cfr_tool.c
new file mode 100644
index 0000000000000000000000000000000000000000..0ce7d45da815a375488f028d4c9f6b0beec4a11c
--- /dev/null
+++ b/tests/qos-gates/cfr_tool.c
@@ -0,0 +1,73 @@
+// SPDX-License-Identifier: CDDL-1.0
+/*
+ * cfr_tool.c — copy a file with copy_file_range(2), the call that lets
+ * OpenZFS clone blocks instead of copying them. Built on the test machine by
+ * diag_other_ops.sh.
+ *
+ *   cfr_tool SRC DST
+ *
+ * Prints "bytes=<n> calls=<n> seconds=<s>".
+ */
+
+#define	_GNU_SOURCE
+#include <sys/stat.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <time.h>
+#include <unistd.h>
+
+static double
+now(void)
+{
+	struct timespec ts;
+
+	(void) clock_gettime(CLOCK_MONOTONIC, &ts);
+	return (ts.tv_sec + ts.tv_nsec / 1e9);
+}
+
+int
+main(int argc, char **argv)
+{
+	struct stat st;
+	long long left, done = 0;
+	int in, out, calls = 0;
+	double t0;
+
+	if (argc != 3) {
+		(void) fprintf(stderr, "usage: cfr_tool SRC DST\n");
+		return (2);
+	}
+	in = open(argv[1], O_RDONLY);
+	if (in < 0 || fstat(in, &st) != 0) {
+		perror(argv[1]);
+		return (1);
+	}
+	out = open(argv[2], O_WRONLY | O_CREAT | O_TRUNC, 0644);
+	if (out < 0) {
+		perror(argv[2]);
+		return (1);
+	}
+	t0 = now();
+	for (left = st.st_size; left > 0; ) {
+		ssize_t n = copy_file_range(in, NULL, out, NULL, left, 0);
+
+		if (n < 0) {
+			perror("copy_file_range");
+			return (1);
+		}
+		if (n == 0)
+			break;
+		left -= n;
+		done += n;
+		calls++;
+	}
+	if (fsync(out) != 0) {
+		perror("fsync");
+		return (1);
+	}
+	(void) printf("bytes=%lld calls=%d seconds=%.3f\n", done, calls,
+	    now() - t0);
+	(void) close(in);
+	(void) close(out);
+	return (0);
+}
diff --git a/tests/qos-gates/diag_dirty_quota.sh b/tests/qos-gates/diag_dirty_quota.sh
new file mode 100755
index 0000000000000000000000000000000000000000..58cba2d24e8aa0a0d756027b640ac6748f370fe0
--- /dev/null
+++ b/tests/qos-gates/diag_dirty_quota.sh
@@ -0,0 +1,145 @@
+#!/bin/sh
+# SPDX-License-Identifier: CDDL-1.0
+#
+# diag_dirty_quota.sh — does the write throughput of a limited dataset depend
+# on the limits of the OTHER datasets of its pool?
+#
+# A limited dataset may hold a share of the dirty data of the pool equal to
+# its share of the sum of all the write limits of the pool:
+#   quota = its rate * zfs_dirty_data_max / sum of the write rates
+# (dsl_pool_qos_dirty_update()). A writer that would go over the quota waits
+# for the pool to sync (dmu_tx.c). The share shrinks as limited datasets are
+# added, whether they write or not, and one dataset with a very large limit
+# is enough to shrink the share of all the others.
+#
+# Not a gate: it gives figures.
+#
+#   diag_dirty_quota.sh --pool POOL --out OUTDIR [--label NAME]
+#                       [--rate BYTES_PER_S] [--mib N]
+#
+# One dataset limited to --rate for writes (default 100 MiB/s) receives --mib
+# of buffered writes (default 1536), three times:
+#   alone           no other limited dataset
+#   100_neighbours  100 idle datasets with the same limit beside it
+#   one_huge        one idle dataset limited to 1 TiB/s beside it
+# OUTDIR/dirty_quota.tsv: case, the pool-wide total and the quota the module
+# logs for the dataset (zfs_qos_debug is set for the run), seconds, MiB/s,
+# transaction groups of the pool during the write, and how many times a writer
+# was delayed for dirty data (dmu_tx_dirty_delay, which also counts the delays
+# of the unmodified code).
+# Use a pool that has no limited dataset of its own: they count in the total.
+
+set -u
+QG_DIR=$(cd "$(dirname "$0")" && pwd)
+. "$QG_DIR/lib.sh"
+
+POOL=; OUT=; LABEL=diag-dirty-quota; RATE=104857600; MIB=1536
+while [ $# -gt 0 ]; do
+	case "$1" in
+	--pool) POOL=$2; shift 2 ;;
+	--out) OUT=$2; shift 2 ;;
+	--label) LABEL=$2; shift 2 ;;
+	--rate) RATE=$2; shift 2 ;;
+	--mib) MIB=$2; shift 2 ;;
+	*) qg_die "unknown argument $1" ;;
+	esac
+done
+[ -n "$POOL" ] && [ -n "$OUT" ] || qg_die "--pool and --out are mandatory"
+case "$(date +%s%N)" in
+*[!0-9]*) qg_die "date +%s%N gives no nanoseconds on this system" ;;
+esac
+mkdir -p "$OUT" || qg_die "cannot create $OUT"
+RES=$OUT/RESULT
+: > "$RES"
+say() { printf '%s\n' "$*" | tee -a "$RES"; }
+
+qdebug() { # qdebug <0|1>
+	case "$QG_OS" in
+	FreeBSD) sudo sysctl "vfs.zfs.qos_debug=$1" > /dev/null 2>&1 ;;
+	*) echo "$1" | sudo tee /sys/module/zfs/parameters/zfs_qos_debug > /dev/null 2>&1 ;;
+	esac
+}
+dbgmsg() {
+	case "$QG_OS" in
+	FreeBSD) sysctl -n kstat.zfs.misc.dbgmsg 2>/dev/null ;;
+	*) sudo cat /proc/spl/kstat/zfs/dbgmsg 2>/dev/null ;;
+	esac
+}
+txg_now() { # a transaction group number of the pool: only differences are used
+	case "$QG_OS" in
+	FreeBSD) sudo zdb -u "$POOL" 2>/dev/null | awk '/txg =/ {print $3; exit}' ;;
+	*) tail -1 "/proc/spl/kstat/zfs/$POOL/txgs" 2>/dev/null | awk '{print $1}' ;;
+	esac
+}
+delays() {
+	case "$QG_OS" in
+	FreeBSD) sysctl -n kstat.zfs.misc.dmu_tx.dmu_tx_dirty_delay 2>/dev/null ;;
+	*) awk '$1 == "dmu_tx_dirty_delay" {print $3}' /proc/spl/kstat/zfs/dmu_tx 2>/dev/null ;;
+	esac
+}
+
+say "label=$LABEL date=$(qg_now)"
+say "os=$(uname -sr) ncpu=$(qg_ncpu)"
+say "module_loaded=$(qg_loaded_module_id)"
+case "$QG_OS" in
+FreeBSD) say "dirty_data_max=$(sysctl -n vfs.zfs.dirty_data_max 2>/dev/null)" ;;
+*) say "dirty_data_max=$(cat /sys/module/zfs/parameters/zfs_dirty_data_max 2>/dev/null)" ;;
+esac
+say "rate=$RATE bytes/s, $MIB MiB written in each case"
+qdebug 1 || qg_die "cannot set zfs_qos_debug (is this the fork?)"
+
+DS=$POOL/qg-dq
+MNT=$(zfs get -H -o value mountpoint "$POOL")/qg-dq
+sudo zfs destroy -r "$DS" > /dev/null 2>&1
+sudo zfs create -o compression=off "$DS" || qg_die "cannot create $DS"
+sudo zfs create "$DS/a" || qg_die "cannot create $DS/a"
+sudo chown "$(id -u)" "$MNT/a"
+OBJ=$(zfs get -H -p -o value objsetid "$DS/a")
+
+FAIL=0
+printf 'case\ttotal_bw\tquota_bytes\tseconds\tmib_per_s\tpool_txgs\tdirty_delays\n' > "$OUT/dirty_quota.tsv"
+# wcase <name>: (re)sets the limit of the dataset, so that the module computes
+# its quota against the pool total of this moment, then writes
+wcase() {
+	sudo zfs set qos:enabled=on qos:max_bw_write="$RATE" "$DS/a" || { FAIL=1; return; }
+	sudo zpool sync "$POOL"
+	_q=$(dbgmsg | grep "QoS dirty quota ds $OBJ:" | tail -1)
+	_tb=$(echo "$_q" | sed -n 's/.*total_bw=\([0-9]*\).*/\1/p')
+	_qu=$(echo "$_q" | sed -n 's/.*quota=\([0-9]*\).*/\1/p')
+	_x0=$(txg_now); _d0=$(delays)
+	_t0=$(date +%s%N)
+	dd if=/dev/zero of="$MNT/a/f" bs=1048576 count="$MIB" conv=notrunc > "$OUT/dd-$1.out" 2>&1 ||
+	    { say "FAIL $1: the write failed"; FAIL=1; }
+	_t1=$(date +%s%N)
+	_x1=$(txg_now); _d1=$(delays)
+	sudo zpool sync "$POOL"
+	printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$1" "${_tb:-NA}" "${_qu:-NA}" \
+	    "$(awk -v a="$_t0" -v b="$_t1" 'BEGIN {printf "%.2f", (b - a) / 1e9}')" \
+	    "$(awk -v a="$_t0" -v b="$_t1" -v m="$MIB" 'BEGIN {printf "%.1f", m / ((b - a) / 1e9)}')" \
+	    "$(( ${_x1:-0} - ${_x0:-0} ))" "$(( ${_d1:-0} - ${_d0:-0} ))" |
+	    tee -a "$OUT/dirty_quota.tsv"
+}
+
+wcase alone
+
+sudo zfs create "$DS/n" || qg_die "cannot create $DS/n"
+_i=1
+while [ "$_i" -le 100 ]; do
+	sudo zfs create -o qos:enabled=on -o qos:max_bw_write="$RATE" "$DS/n/d$_i" ||
+	    qg_die "cannot create neighbour $_i"
+	_i=$((_i + 1))
+done
+wcase 100_neighbours
+sudo zfs destroy -r "$DS/n" || { say "FAIL: cannot destroy the neighbours"; FAIL=1; }
+
+sudo zfs create -o qos:enabled=on -o qos:max_bw_write=1099511627776 "$DS/huge" ||
+    qg_die "cannot create the dataset with the large limit"
+wcase one_huge
+
+sudo zfs destroy -r "$DS" > /dev/null 2>&1
+qdebug 0
+if [ "$FAIL" -ne 0 ]; then
+	say "RESULT=INCOMPLETE"
+	exit 1
+fi
+say "RESULT=MEASURED"
diff --git a/tests/qos-gates/diag_ds_profile.sh b/tests/qos-gates/diag_ds_profile.sh
new file mode 100755
index 0000000000000000000000000000000000000000..7838f54b3c9be5fa5028c8a93603f980f586c6a6
--- /dev/null
+++ b/tests/qos-gates/diag_ds_profile.sh
@@ -0,0 +1,120 @@
+#!/bin/sh
+# SPDX-License-Identifier: CDDL-1.0
+#
+# diag_ds_profile.sh — Linux only. Where the time goes when datasets that are
+# not mounted are created, listed and destroyed: number of calls and time
+# spent in the functions that load and evict a dataset, measured with the
+# kernel function profiler (ftrace), plus the wall time of each phase.
+#
+# Not a gate: it gives figures, to compare a build with the control and a
+# fix with what it replaces. No QoS property is set.
+#
+#   diag_ds_profile.sh --pool POOL --out OUTDIR [--label NAME] [--datasets 100]
+#                      [--parent-props N]
+#
+# --parent-props N gives the parent of the test datasets N user properties
+# (none of them a qos:* one): loading a dataset reads the properties of its
+# whole lineage, so a parent that carries many properties is the costly case.
+#
+# A dataset that is not mounted is loaded again each time a command looks at
+# it, so everything that runs when a dataset is loaded is paid many times by
+# zfs list, zfs get and the like.
+# OUTDIR/profile.tsv: phase, function, calls, total_us, avg_us.
+# OUTDIR/phases.tsv: phase, wall_ms, datasets.
+# The profiler slows the traced functions down: read the figures as shares
+# and as call counts, not as absolute costs.
+
+set -u
+QG_DIR=$(cd "$(dirname "$0")" && pwd)
+. "$QG_DIR/lib.sh"
+
+POOL=; OUT=; LABEL=diag-ds; NDS=100; PPROPS=0
+while [ $# -gt 0 ]; do
+	case "$1" in
+	--pool) POOL=$2; shift 2 ;;
+	--out) OUT=$2; shift 2 ;;
+	--label) LABEL=$2; shift 2 ;;
+	--datasets) NDS=$2; shift 2 ;;
+	--parent-props) PPROPS=$2; shift 2 ;;
+	*) qg_die "unknown argument $1" ;;
+	esac
+done
+[ -n "$POOL" ] && [ -n "$OUT" ] || qg_die "--pool and --out are mandatory"
+[ "$QG_OS" = Linux ] || qg_die "the function profiler used here is Linux only"
+TR=/sys/kernel/debug/tracing
+sudo test -e $TR/function_profile_enabled || qg_die "no function profiler in this kernel"
+mkdir -p "$OUT" || qg_die "cannot create $OUT"
+RES=$OUT/RESULT
+: > "$RES"
+say() { printf '%s\n' "$*" | tee -a "$RES"; }
+
+say "label=$LABEL date=$(qg_now)"
+say "os=$(uname -sr) ncpu=$(qg_ncpu)"
+say "module_loaded=$(qg_loaded_module_id)"
+
+# the functions of interest that exist in the loaded module
+WANT="dsl_dataset_hold_obj dsl_dataset_evict_async dsl_prop_get_ds qos_prop_apply qos_bucket_init qos_bucket_fini"
+HAVE=
+for f in $WANT; do
+	sudo grep -q -w "$f" $TR/available_filter_functions && HAVE="$HAVE $f"
+done
+say "traced:$HAVE"
+
+prof_start() {
+	echo 0 | sudo tee $TR/function_profile_enabled > /dev/null
+	# shellcheck disable=SC2086
+	echo $HAVE | sudo tee $TR/set_ftrace_filter > /dev/null
+	echo 1 | sudo tee $TR/function_profile_enabled > /dev/null
+}
+# prof_stop <phase>: sum the per-CPU tables into profile.tsv
+prof_stop() {
+	echo 0 | sudo tee $TR/function_profile_enabled > /dev/null
+	sudo sh -c "cat $TR/trace_stat/function*" |
+	    awk -v p="$1" '$2 ~ /^[0-9]+$/ && $4 == "us" {h[$1] += $2; t[$1] += $3}
+	    END {for (f in h) printf "%s\t%s\t%d\t%.0f\t%.1f\n", p, f, h[f], t[f], h[f] ? t[f] / h[f] : 0}' |
+	    sort >> "$OUT/profile.tsv"
+}
+ms() { _s=$(date +%s%N); "$@" > /dev/null 2>&1; _rc=$?; _e=$(date +%s%N); echo $(( (_e - _s) / 1000000 )); return $_rc; }
+
+DS=$POOL/qg-diag
+sudo zfs destroy -r "$DS" > /dev/null 2>&1
+sudo zfs create -o mountpoint=none "$DS" || qg_die "cannot create $DS"
+if [ "$PPROPS" -gt 0 ]; then
+	_args=; _i=0
+	while [ $_i -lt "$PPROPS" ]; do
+		_args="$_args qgtest:p$_i=value-$_i"; _i=$((_i + 1))
+	done
+	# shellcheck disable=SC2086
+	sudo zfs set $_args "$DS" || qg_die "cannot set $PPROPS user properties on $DS"
+fi
+say "datasets=$NDS parent_props=$PPROPS"
+QP=$(zfs get -H -o name,property,value,source all "$DS" 2>/dev/null | grep -c 'qos:')
+[ "$QP" -eq 0 ] || qg_die "qos:* properties apply to $DS — not a no-QoS run"
+printf 'phase\tfunction\tcalls\ttotal_us\tavg_us\n' > "$OUT/profile.tsv"
+printf 'phase\twall_ms\tdatasets\n' > "$OUT/phases.tsv"
+FAIL=0
+
+prof_start
+W=$(ms sh -c "i=0; while [ \$i -lt $NDS ]; do sudo zfs create -o mountpoint=none $DS/d\$i || exit 1; i=\$((i+1)); done") || FAIL=1
+prof_stop create
+printf 'create\t%s\t%s\n' "$W" "$NDS" >> "$OUT/phases.tsv"
+
+prof_start
+W=$(ms sh -c "sudo zfs list -H -r -o name,used $DS") || FAIL=1
+prof_stop list
+printf 'list\t%s\t%s\n' "$W" "$NDS" >> "$OUT/phases.tsv"
+
+prof_start
+W=$(ms sudo zfs destroy -r "$DS") || FAIL=1
+prof_stop destroy
+printf 'destroy\t%s\t%s\n' "$W" "$NDS" >> "$OUT/phases.tsv"
+
+echo | sudo tee $TR/set_ftrace_filter > /dev/null
+cat "$OUT/phases.tsv"
+cat "$OUT/profile.tsv"
+if [ $FAIL -eq 0 ] && [ "$(wc -l < "$OUT/profile.tsv")" -gt 1 ]; then
+	say "RESULT=PASS"
+	exit 0
+fi
+say "RESULT=FAIL (a phase failed or the profiler gave nothing)"
+exit 1
diff --git a/tests/qos-gates/diag_iops.sh b/tests/qos-gates/diag_iops.sh
new file mode 100755
index 0000000000000000000000000000000000000000..d15071e63973e0670e05e9a6d465b2d5806336b3
--- /dev/null
+++ b/tests/qos-gates/diag_iops.sh
@@ -0,0 +1,119 @@
+#!/bin/sh
+# SPDX-License-Identifier: CDDL-1.0
+#
+# diag_iops.sh — what qos:max_iops_read and qos:max_iops_write count, and
+# whether the rate they set holds.
+#
+# The operation limits are consumed where the byte limits are: one operation
+# for each transaction a write is assigned to, one for each read request that
+# reaches the DMU, one more for each commit of the intent log. That is not the
+# number of system calls, nor of network requests, nor of disk I/Os: a large
+# write(2) is cut in several transactions, a commit costs an operation of its
+# own. This tool measures the unit and the rate.
+#
+# Not a gate: it gives figures.
+#
+#   diag_iops.sh --pool POOL --out OUTDIR [--label NAME] [--rate N]
+#
+# A dataset limited to --rate operations per second (default 100) in one
+# direction only, no byte limit. OUTDIR/iops.tsv, one line per case: system
+# calls made, operations charged to the limit (kstat), operations per system
+# call, seconds, and the rate the limit let through once the reserve of the
+# bucket is taken out. Each case starts on a bucket that was just set, and a
+# bucket is filled with two seconds of its rate when its limit is set: the
+# sustained rate is rate_low = (charged - 2 x rate) / seconds. rate_high =
+# (charged - rate) / seconds is what it would be had the bucket held one
+# second only. A case that stays within the reserve has no sustained rate
+# ("-").
+#   w_4k           1000 writes of 4 KiB, not committed
+#   w_128k         1000 writes of 128 KiB, not committed
+#   w_1m           200 writes of 1 MiB, not committed (records of 128 KiB)
+#   w_4k_sync      500 writes of 4 KiB, each committed
+#   r_4k           1000 reads of 4 KiB
+#   r_1m           16 reads of 1 MiB
+
+set -u
+QG_DIR=$(cd "$(dirname "$0")" && pwd)
+. "$QG_DIR/lib.sh"
+
+POOL=; OUT=; LABEL=diag-iops; RATE=100
+while [ $# -gt 0 ]; do
+	case "$1" in
+	--pool) POOL=$2; shift 2 ;;
+	--out) OUT=$2; shift 2 ;;
+	--label) LABEL=$2; shift 2 ;;
+	--rate) RATE=$2; shift 2 ;;
+	*) qg_die "unknown argument $1" ;;
+	esac
+done
+[ -n "$POOL" ] && [ -n "$OUT" ] || qg_die "--pool and --out are mandatory"
+case "$(date +%s%N)" in
+*[!0-9]*) qg_die "date +%s%N gives no nanoseconds on this system" ;;
+esac
+mkdir -p "$OUT" || qg_die "cannot create $OUT"
+RES=$OUT/RESULT
+: > "$RES"
+say() { printf '%s\n' "$*" | tee -a "$RES"; }
+
+say "label=$LABEL date=$(qg_now)"
+say "os=$(uname -sr) ncpu=$(qg_ncpu)"
+say "module_loaded=$(qg_loaded_module_id)"
+say "rate=$RATE operations/s"
+
+DS=$POOL/qg-iops
+MNT=$(zfs get -H -o value mountpoint "$POOL")/qg-iops
+sudo zfs destroy -r "$DS" > /dev/null 2>&1
+sudo zfs create -o compression=off -o recordsize=128K "$DS" || qg_die "cannot create $DS"
+sudo chown "$(id -u)" "$MNT"
+OBJ=$(printf '%x' "$(zfs get -H -p -o value objsetid "$DS")")
+dd if=/dev/zero of="$MNT/src" bs=1048576 count=16 2>/dev/null || qg_die "cannot write the source file"
+sudo zpool sync "$POOL"
+
+kstat_val() { # kstat_val <field of the QoS kstat>
+	case "$QG_OS" in
+	FreeBSD) sysctl -n "kstat.zfs.$POOL.qos.qos-0x$OBJ.$1" 2>/dev/null ;;
+	*) awk -v k="$1" '$1 == k {print $3}' "/proc/spl/kstat/zfs/$POOL/qos-0x$OBJ" 2>/dev/null ;;
+	esac
+}
+
+FAIL=0
+printf 'case\tlimit\tsyscalls\tcharged_ops\tops_per_syscall\tseconds\trate_low\trate_high\n' > "$OUT/iops.tsv"
+# icase <name> <read|write> <system calls> <shell command, run in $MNT>
+icase() {
+	# a fresh bucket for each case: no limit, then the limit
+	for _p in qos:max_iops_read qos:max_iops_write qos:max_bw_read qos:max_bw_write; do
+		sudo zfs inherit "$_p" "$DS" 2> /dev/null
+	done
+	sudo zfs set qos:enabled=on "qos:max_iops_$2=$RATE" "$DS" || { FAIL=1; return; }
+	sudo zpool sync "$POOL"
+	[ -n "$(kstat_val stat_total_ios_$2)" ] || { say "FAIL $1: no QoS kstat"; FAIL=1; return; }
+	_o0=$(kstat_val "stat_total_ios_$2")
+	# run directly: the bounded wait of lib.sh has a grain of one second on
+	# Linux, which is 10 % of what is measured here (the host bounds the
+	# whole script)
+	_t0=$(date +%s%N)
+	( cd "$MNT" && eval "$4" ) > "$OUT/case-$1.out" 2>&1
+	_rc=$?
+	_t1=$(date +%s%N)
+	_o1=$(kstat_val "stat_total_ios_$2")
+	[ $_rc -eq 0 ] || { say "FAIL $1: the command ended with code $_rc"; FAIL=1; }
+	awk -v n="$1" -v r="$RATE" -v sc="$3" -v o0="$_o0" -v o1="$_o1" -v a="$_t0" -v b="$_t1" 'BEGIN {
+		s = (b - a) / 1e9; o = o1 - o0
+		lo = (o > 2 * r) ? sprintf("%.1f", (o - 2 * r) / s) : "-"
+		hi = (o > 2 * r) ? sprintf("%.1f", (o - r) / s) : "-"
+		printf "%s\t%s\t%s\t%d\t%.2f\t%.2f\t%s\t%s\n", n, r, sc, o, o / sc, s, lo, hi
+	}' | tee -a "$OUT/iops.tsv"
+}
+icase w_4k write 1000 'dd if=/dev/zero of=w4k bs=4096 count=1000 conv=notrunc'
+icase w_128k write 1000 'dd if=/dev/zero of=w128k bs=131072 count=1000 conv=notrunc'
+icase w_1m write 200 'dd if=/dev/zero of=w1m bs=1048576 count=200 conv=notrunc'
+icase w_4k_sync write 500 'dd if=/dev/zero of=w4ks bs=4096 count=500 oflag=sync'
+icase r_4k read 1000 'dd if=src of=/dev/null bs=4096 count=1000'
+icase r_1m read 16 'dd if=src of=/dev/null bs=1048576 count=16'
+
+sudo zfs destroy -r "$DS" > /dev/null 2>&1
+if [ "$FAIL" -ne 0 ]; then
+	say "RESULT=INCOMPLETE"
+	exit 1
+fi
+say "RESULT=MEASURED"
diff --git a/tests/qos-gates/diag_meta_cost.sh b/tests/qos-gates/diag_meta_cost.sh
new file mode 100755
index 0000000000000000000000000000000000000000..6746738021fd506b45558310f1003dd014ff25aa
--- /dev/null
+++ b/tests/qos-gates/diag_meta_cost.sh
@@ -0,0 +1,129 @@
+#!/bin/sh
+# SPDX-License-Identifier: CDDL-1.0
+#
+# diag_meta_cost.sh — how many bytes and operations of the write limit one
+# metadata operation is charged.
+#
+# A write is charged when its transaction is assigned, for the space the
+# transaction reserves — a worst-case estimate, not what is finally written.
+# For an operation that only changes metadata the whole charge is that
+# estimate. This script sets a limit far above anything the test can reach
+# (nothing is throttled) and reads, in the QoS kstat of the dataset, how much
+# was charged for a few hundred operations of each kind.
+#
+# Not a gate: it gives figures.
+#
+#   diag_meta_cost.sh --pool POOL --out OUTDIR [--label NAME] [--count 200]
+#                     [--timed-limit 1048576] [--timed-count 40]
+#
+# OUTDIR/meta_cost.tsv: operation, count, bytes_per_op, charges_per_op.
+# OUTDIR/timed.tsv: the creation of --timed-count empty files timed under a
+# real limit of --timed-limit bytes/s, against the time the charge predicts.
+# With a limit of L bytes/s, an operation charged B bytes can be done at most
+# L / B times per second on that dataset, whatever it really writes.
+
+set -u
+QG_DIR=$(cd "$(dirname "$0")" && pwd)
+. "$QG_DIR/lib.sh"
+
+POOL=; OUT=; LABEL=diag-meta; N=200; TLIMIT=1048576; NT=40
+while [ $# -gt 0 ]; do
+	case "$1" in
+	--pool) POOL=$2; shift 2 ;;
+	--out) OUT=$2; shift 2 ;;
+	--label) LABEL=$2; shift 2 ;;
+	--count) N=$2; shift 2 ;;
+	--timed-limit) TLIMIT=$2; shift 2 ;;
+	--timed-count) NT=$2; shift 2 ;;
+	*) qg_die "unknown argument $1" ;;
+	esac
+done
+[ -n "$POOL" ] && [ -n "$OUT" ] || qg_die "--pool and --out are mandatory"
+mkdir -p "$OUT" || qg_die "cannot create $OUT"
+RES=$OUT/RESULT
+: > "$RES"
+say() { printf '%s\n' "$*" | tee -a "$RES"; }
+
+say "label=$LABEL date=$(qg_now)"
+say "os=$(uname -sr) ncpu=$(qg_ncpu)"
+say "module_loaded=$(qg_loaded_module_id)"
+
+DS=$POOL/qg-meta
+MNT=$(zfs get -H -o value mountpoint "$POOL")/qg-meta
+sudo zfs destroy -r "$DS" > /dev/null 2>&1
+sudo zfs create -o compression=off "$DS" || qg_die "cannot create $DS"
+sudo chown "$(id -u)" "$MNT"
+OBJ=$(printf '%x' "$(zfs get -H -p -o value objsetid "$DS")")
+# 1 TiB/s and 2^40 operations/s: far above what the test can do
+sudo zfs set qos:enabled=on qos:max_bw_write=1099511627776 \
+    qos:max_iops_write=1099511627776 "$DS" || qg_die "cannot set the limit"
+
+kstat_val() { # kstat_val <field>
+	case "$QG_OS" in
+	FreeBSD) sysctl -n "kstat.zfs.$POOL.qos.qos-0x$OBJ.$1" 2>/dev/null ;;
+	*) awk -v k="$1" '$1 == k {print $3}' "/proc/spl/kstat/zfs/$POOL/qos-0x$OBJ" 2>/dev/null ;;
+	esac
+}
+[ -n "$(kstat_val stat_total_bytes_write)" ] || qg_die "no QoS kstat for $DS"
+
+printf 'operation\tcount\tbytes_per_op\tcharges_per_op\n' > "$OUT/meta_cost.tsv"
+# op <name> <shell loop body using $i>
+op() {
+	_name=$1; _body=$2
+	sudo zpool sync "$POOL"
+	_b0=$(kstat_val stat_total_bytes_write); _i0=$(kstat_val stat_total_ios_write)
+	( cd "$MNT" && i=0 && while [ $i -lt "$N" ]; do eval "$_body" || exit 1; i=$((i + 1)); done ) ||
+	    { say "FAIL $_name: the operation failed"; return 1; }
+	sudo zpool sync "$POOL"
+	_b1=$(kstat_val stat_total_bytes_write); _i1=$(kstat_val stat_total_ios_write)
+	printf '%s\t%s\t%s\t%s\n' "$_name" "$N" \
+	    "$(( (_b1 - _b0) / N ))" \
+	    "$(awk -v a="$_i0" -v b="$_i1" -v n="$N" 'BEGIN {printf "%.2f", (b - a) / n}')" |
+	    tee -a "$OUT/meta_cost.tsv"
+}
+FAIL=0
+op create_empty_file ': > f$i' || FAIL=1
+op write_1_byte 'printf x >> f$i' || FAIL=1
+op write_4k 'dd if=/dev/zero of=f$i bs=4096 count=1 conv=notrunc 2>/dev/null' || FAIL=1
+op write_128k 'dd if=/dev/zero of=f$i bs=131072 count=1 conv=notrunc 2>/dev/null' || FAIL=1
+op chmod 'chmod 600 f$i' || FAIL=1
+op rename 'mv f$i g$i' || FAIL=1
+op unlink 'unlink g$i' || FAIL=1
+op mkdir 'mkdir d$i' || FAIL=1
+op rmdir 'rmdir d$i' || FAIL=1
+
+# The same charge under a real limit: empty files created one after the other
+# on a dataset limited to TLIMIT bytes/s of writes. The bucket holds two
+# seconds of the rate, so NT creations charged B bytes each cannot take less
+# than (NT x B - 2 x TLIMIT) / TLIMIT seconds if the charge is what the
+# table above says.
+B=$(awk -F"\t" '$1 == "create_empty_file" {print $3}' "$OUT/meta_cost.tsv")
+printf 'operation\tcount\tlimit_bytes_s\tseconds\texpected_seconds\tper_second\n' > "$OUT/timed.tsv"
+if [ -n "$B" ] && [ "$B" -gt 0 ]; then
+	# the directory first: under the limit it would take its own charge
+	mkdir -p "$MNT/timed"
+	sudo zpool sync "$POOL"
+	sudo zfs set qos:max_bw_write="$TLIMIT" qos:max_iops_write=0 "$DS"
+	_s=$(date +%s%N)
+	qg_run_bounded 300 "$OUT/timed.out" sh -c "cd '$MNT/timed' || exit 1; i=0
+	    while [ \$i -lt $NT ]; do : > t\$i || exit 1; i=\$((i+1)); done"
+	_rc=$?
+	_e=$(date +%s%N)
+	if [ $_rc -eq 0 ]; then
+		echo "$_s $_e" | awk -v n="$NT" -v l="$TLIMIT" -v b="$B" '{
+			s = ($2 - $1) / 1000000000; x = (n * b - 2 * l) / l; if (x < 0) x = 0
+			printf "create_empty_file\t%d\t%d\t%.2f\t%.2f\t%.2f\n", n, l, s, x, n / s }' |
+		    tee -a "$OUT/timed.tsv"
+	else
+		say "FAIL timed creations: rc=$_rc"; FAIL=1
+	fi
+fi
+
+sudo zfs destroy -r "$DS" > /dev/null 2>&1
+say "table=$OUT/meta_cost.tsv"
+if [ $FAIL -eq 0 ]; then
+	say "RESULT=PASS"
+	exit 0
+fi
+say "RESULT=FAIL (an operation failed)"
+exit 1
diff --git a/tests/qos-gates/diag_mixed_sizes.sh b/tests/qos-gates/diag_mixed_sizes.sh
new file mode 100755
index 0000000000000000000000000000000000000000..877b1dc8791d4c3266642950b3fcda37d00beaf4
--- /dev/null
+++ b/tests/qos-gates/diag_mixed_sizes.sh
@@ -0,0 +1,240 @@
+#!/bin/sh
+# SPDX-License-Identifier: CDDL-1.0
+#
+# diag_mixed_sizes.sh — under a low limit, is a program still served while
+# another one issues larger requests on the same dataset?
+#
+# Two rules of the bucket may starve a waiter; the tool is there to see
+# whether they do:
+#   - a request larger than the bucket (two seconds of the rate) is admitted
+#     as soon as the balance is positive and charged in full, which puts the
+#     bucket in debt, while a request that fits in the bucket needs all its
+#     tokens: a stream of over-sized requests takes the balance back into
+#     debt before a small one finds its tokens;
+#   - among requests that fit in the bucket, one that needs more tokens than
+#     the others never finds them while the others keep taking what comes
+#     in. Creating a file is such a request: its transaction is charged a
+#     few hundred kilobytes.
+# Not a gate: it gives figures.
+#
+#   diag_mixed_sizes.sh --pool POOL --out OUTDIR [--label NAME] [--rate BYTES_PER_S]
+#                       [--large-bs BYTES] [--large-count N]
+#
+# One dataset limited to --rate (default 256 KiB/s) in one direction only;
+# every file written or read exists before the limit is set. The "large"
+# program issues --large-count requests of --large-bs bytes (default: 6 of
+# 1 MiB, larger than the default bucket). With requests that fit in the bucket
+# (say --rate 1048576 --large-bs 131072 --large-count 96) the tool tells
+# whether a request that needs more tokens than those of the stream, a file
+# creation, is served while the stream keeps the bucket empty.
+# OUTDIR/mixed_sizes.tsv, one line per case, with what the limit counted
+# during the case: charges (requests admitted), bytes charged, and tries it
+# refused (a waiter tries again every tick or every 10 ms: the refusals per
+# second tell how many programs were waiting on the limit).
+#   small_alone        20 requests of 4 KiB, nothing else running
+#   large_alone        the large requests, nothing else running (charges and
+#                      bytes: how the module saw them)
+#   small_with_large   the 20 small requests started once the limit has
+#                      refused a first try of the large program
+#   create_alone       writes only: 3 empty files created
+#   create_with_large  the same 3 creations while the large program runs
+# A program that takes about as long as the large one was served only when
+# the large one let go. OUTDIR/<direction>-<case>.probe: while the program of
+# a "with_large" case waits, the balance of the bucket as the kstat shows it
+# (0 = empty or in debt), the counters, and the kernel stack of the program.
+
+set -u
+QG_DIR=$(cd "$(dirname "$0")" && pwd)
+. "$QG_DIR/lib.sh"
+
+POOL=; OUT=; LABEL=diag-mixed-sizes; RATE=262144; LBS=1048576; LCOUNT=6
+while [ $# -gt 0 ]; do
+	case "$1" in
+	--pool) POOL=$2; shift 2 ;;
+	--out) OUT=$2; shift 2 ;;
+	--label) LABEL=$2; shift 2 ;;
+	--rate) RATE=$2; shift 2 ;;
+	--large-bs) LBS=$2; shift 2 ;;
+	--large-count) LCOUNT=$2; shift 2 ;;
+	*) qg_die "unknown argument $1" ;;
+	esac
+done
+[ -n "$POOL" ] && [ -n "$OUT" ] || qg_die "--pool and --out are mandatory"
+case "$(date +%s%N)" in
+*[!0-9]*) qg_die "date +%s%N gives no nanoseconds on this system" ;;
+esac
+mkdir -p "$OUT" || qg_die "cannot create $OUT"
+RES=$OUT/RESULT
+: > "$RES"
+say() { printf '%s\n' "$*" | tee -a "$RES"; }
+
+say "label=$LABEL date=$(qg_now)"
+say "os=$(uname -sr) ncpu=$(qg_ncpu)"
+say "module_loaded=$(qg_loaded_module_id)"
+say "rate=$RATE bytes/s (the bucket holds $((RATE * 2)) bytes)"
+say "large_program=$LCOUNT requests of $LBS bytes"
+
+DS=$POOL/qg-mix
+MNT=$(zfs get -H -o value mountpoint "$POOL")/qg-mix
+sudo zfs destroy -r "$DS" > /dev/null 2>&1
+sudo zfs create -o compression=off "$DS" || qg_die "cannot create $DS"
+sudo chown "$(id -u)" "$MNT"
+for _f in large dst-large; do
+	dd if=/dev/zero of="$MNT/$_f" bs="$LBS" count="$LCOUNT" 2>/dev/null || qg_die "cannot write $_f"
+done
+for _f in small dst-small; do
+	dd if=/dev/zero of="$MNT/$_f" bs=4096 count=20 2>/dev/null || qg_die "cannot write $_f"
+done
+sudo zpool sync "$POOL"
+say "recordsize=$(zfs get -H -o value recordsize "$DS")"
+
+FAIL=0
+OBJ=$(printf '%x' "$(zfs get -H -p -o value objsetid "$DS")")
+kstat_val() { # kstat_val <field of the QoS kstat>
+	case "$QG_OS" in
+	FreeBSD) sysctl -n "kstat.zfs.$POOL.qos.qos-0x$OBJ.$1" 2>/dev/null ;;
+	*) awk -v k="$1" '$1 == k {print $3}' "/proc/spl/kstat/zfs/$POOL/qos-0x$OBJ" 2>/dev/null ;;
+	esac
+}
+# in_debt <read|write>: returns once the limit has refused a try of the large
+# program (it looks at the counter again and again, for a while at most), so
+# that the bucket is empty or in debt when the other program starts
+in_debt() {
+	_b0=$(kstat_val "stat_throttle_count_$1"); _k=0
+	while [ "$_k" -lt 20000 ]; do
+		_b1=$(kstat_val "stat_throttle_count_$1")
+		[ $((${_b1:-0} - ${_b0:-0})) -ge 1 ] && return 0
+		_k=$((_k + 1))
+	done
+	say "note: the limit never refused a try of the large program ($1)"
+	return 1
+}
+secs() { awk -v a="$1" -v b="$2" 'BEGIN {printf "%.2f", (b - a) / 1e9}'; }
+# counters <read|write>: charges, bytes charged, tries refused, so far
+counters() {
+	echo "$(kstat_val "stat_total_ios_$1") $(kstat_val "stat_total_bytes_$1") $(kstat_val "stat_throttle_count_$1")"
+}
+# delta "<counters before>" "<counters after>": the three differences
+delta() {
+	echo "$1 $2" | awk '{printf "%d\t%d\t%d", $4 - $1, $5 - $2, $6 - $3}'
+}
+# limit <read|write>: only that direction is limited, from a full bucket
+limit() {
+	for _p in qos:max_bw_read qos:max_bw_write; do sudo zfs inherit "$_p" "$DS" 2> /dev/null; done
+	sudo zfs set qos:enabled=on "qos:max_bw_$1=$RATE" "$DS" || { FAIL=1; return 1; }
+	sudo zpool sync "$POOL"
+}
+small() { # small <read|write>
+	if [ "$1" = write ]; then
+		dd if=/dev/zero of="$MNT/dst-small" bs=4096 count=20 conv=notrunc
+	else
+		dd if="$MNT/small" of=/dev/null bs=4096 count=20
+	fi
+}
+large() { # large <read|write>
+	if [ "$1" = write ]; then
+		dd if=/dev/zero of="$MNT/dst-large" bs="$LBS" count="$LCOUNT" conv=notrunc
+	else
+		dd if="$MNT/large" of=/dev/null bs="$LBS" count="$LCOUNT"
+	fi
+}
+creates() { # creates <tag>: three empty files
+	for _i in 1 2 3; do : > "$MNT/new-$1-$_i" || return 1; done
+}
+kstack() { # kernel stack of the program run by the subshell <pid>
+	_c=$(pgrep -P "$1" | head -1)
+	[ -n "$_c" ] || _c=$1
+	case "$QG_OS" in
+	FreeBSD) sudo procstat -kk "$_c" ;;
+	*) sudo cat "/proc/$_c/stack" ;;
+	esac
+}
+# probe <read|write> <case> <pid>: twice while the program <pid> is waiting
+# (when two, then six seconds of the rate have been charged since it started),
+# what the bucket holds and where the program sleeps in the kernel
+probe() {
+	_c0=$(kstat_val "stat_total_bytes_$1")
+	for _thr in $((RATE * 2)) $((RATE * 6)); do
+		_k=0
+		while [ "$_k" -lt 20000 ]; do
+			kill -0 "$3" 2> /dev/null || return 0
+			_c1=$(kstat_val "stat_total_bytes_$1")
+			[ $((${_c1:-0} - ${_c0:-0})) -ge "$_thr" ] && break
+			_k=$((_k + 1))
+		done
+		{
+			echo "== $((${_c1:-0} - ${_c0:-0})) bytes charged since the program started"
+			# three looks in a row: a waiter that sleeps a tick at a time
+			# is not always caught at the same place
+			for _s in 1 2 3; do
+				echo "-- look $_s: t_ns=$(date +%s%N) bw_tokens=$(kstat_val "stat_bw_tokens_$1") refused=$(kstat_val "stat_throttle_count_$1") charges=$(kstat_val "stat_total_ios_$1") charged=$(kstat_val "stat_total_bytes_$1")"
+				kstack "$3"
+			done
+		} >> "$OUT/$1-$2.probe" 2>&1
+	done
+}
+# with_large <read|write> <name of the case> <function> [argument]: runs the
+# function once the large program has put the bucket in debt
+with_large() {
+	limit "$1" || return
+	_w0=$(counters "$1")
+	_l0=$(date +%s%N)
+	( in_debt "$1" ) &
+	_dp=$!
+	# the large program notes its own end: it may finish before the other one
+	( large "$1" > "$OUT/$1-large-during-$2.out" 2>&1
+	    date +%s%N > "$OUT/$1-large-during-$2.end" ) &
+	_lp=$!
+	# waited for directly, here and below: the bounded wait of lib.sh has a
+	# grain of one second on Linux (the host bounds the whole script)
+	wait "$_dp"
+	_t0=$(date +%s%N)
+	"$3" "${4:-$1}" > "$OUT/$1-$2.out" 2>&1 &
+	_sp=$!
+	( probe "$1" "$2" "$_sp" ) &
+	wait "$_sp" || FAIL=1
+	_t1=$(date +%s%N)
+	wait "$_lp"
+	_l1=$(cat "$OUT/$1-large-during-$2.end" 2> /dev/null)
+	[ -n "$_l1" ] || _l1=$(date +%s%N)
+	_w1=$(counters "$1")
+	printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$1" "$2" "$(secs "$_t0" "$_t1")" "$(secs "$_l0" "$_l1")" \
+	    "$(delta "$_w0" "$_w1")" "$(secs "$_l0" "$_t0")" | tee -a "$OUT/mixed_sizes.tsv"
+}
+
+# started_after: seconds between the start of the large program and the start
+# of the other one (with_large cases)
+printf 'direction\tcase\tseconds\tlarge_seconds\tcharges\tbytes_charged\trefused_tries\tstarted_after\n' > "$OUT/mixed_sizes.tsv"
+for dir in write read; do
+	limit $dir || continue
+	_c0=$(counters $dir)
+	_t0=$(date +%s%N); small $dir > "$OUT/$dir-small-alone.out" 2>&1 || FAIL=1; _t1=$(date +%s%N)
+	_c1=$(counters $dir)
+	printf '%s\tsmall_alone\t%s\t-\t%s\t-\n' "$dir" "$(secs "$_t0" "$_t1")" "$(delta "$_c0" "$_c1")" |
+	    tee -a "$OUT/mixed_sizes.tsv"
+
+	limit $dir || continue
+	_c0=$(counters $dir)
+	_t0=$(date +%s%N); large $dir > "$OUT/$dir-large-alone.out" 2>&1 || FAIL=1; _t1=$(date +%s%N)
+	_c1=$(counters $dir)
+	printf '%s\tlarge_alone\t-\t%s\t%s\t-\n' "$dir" "$(secs "$_t0" "$_t1")" "$(delta "$_c0" "$_c1")" |
+	    tee -a "$OUT/mixed_sizes.tsv"
+
+	with_large $dir small_with_large small
+
+	[ "$dir" = write ] || continue
+	limit write || continue
+	_c0=$(counters write)
+	_t0=$(date +%s%N); creates alone > "$OUT/write-create-alone.out" 2>&1 || FAIL=1; _t1=$(date +%s%N)
+	_c1=$(counters write)
+	printf 'write\tcreate_alone\t%s\t-\t%s\t-\n' "$(secs "$_t0" "$_t1")" "$(delta "$_c0" "$_c1")" |
+	    tee -a "$OUT/mixed_sizes.tsv"
+	with_large write create_with_large creates with
+done
+
+sudo zfs destroy -r "$DS" > /dev/null 2>&1
+if [ "$FAIL" -ne 0 ]; then
+	say "RESULT=INCOMPLETE"
+	exit 1
+fi
+say "RESULT=MEASURED"
diff --git a/tests/qos-gates/diag_mmap_charge.sh b/tests/qos-gates/diag_mmap_charge.sh
new file mode 100755
index 0000000000000000000000000000000000000000..fab389f8d873aa4e917ce0905d571401e5d3ca7e
--- /dev/null
+++ b/tests/qos-gates/diag_mmap_charge.sh
@@ -0,0 +1,197 @@
+#!/bin/sh
+# SPDX-License-Identifier: CDDL-1.0
+#
+# diag_mmap_charge.sh — what the accesses to a mapped file are charged.
+#
+# The QoS code charges reads in two functions of the DMU. With a mapped file,
+# some reads do not go through them, and one kind of write does:
+#   - a page read in on a fault: zfs_fillpage() calls dmu_read() on Linux,
+#     where reads are charged; zfs_getpages() calls dmu_read_pages() on
+#     FreeBSD, which has no QoS hook;
+#   - write(2) on a file some pages of which are resident: update_pages()
+#     reads the data just written back from the DMU to refresh those pages,
+#     through dmu_read(), so the write is also charged as a read;
+#   - a write through the mapping followed by msync(): each page is written
+#     and logged as a small write, which the intent log copies (what that
+#     costs is the subject of diag_zil_readback.sh).
+#
+# Not a gate: it gives figures.
+#
+#   diag_mmap_charge.sh --pool POOL --out OUTDIR [--label NAME]
+#
+# OUTDIR/mmap_charge.tsv, both limits far above what the test can reach, one
+# line per access to an 8 MiB file: bytes accessed, bytes charged to the READ
+# limit and in how many charges, bytes charged to the write limit, bytes the
+# intent log copied, bytes it logged by pointer, commits, seconds.
+# OUTDIR/timed.tsv: four of those accesses under a READ limit of 1 MiB/s, the
+# write limit staying out of reach. An access the read limit holds takes
+# about 7 s, one it does not hold a fraction of a second.
+#
+# With a module of the published v2.1 or v2.2, the limits set here stay in the
+# pool-wide total of the write limits until the pool is imported again: do
+# not run this on a pool that a measurement is about to use.
+
+set -u
+QG_DIR=$(cd "$(dirname "$0")" && pwd)
+. "$QG_DIR/lib.sh"
+
+POOL=; OUT=; LABEL=diag-mmap-charge
+while [ $# -gt 0 ]; do
+	case "$1" in
+	--pool) POOL=$2; shift 2 ;;
+	--out) OUT=$2; shift 2 ;;
+	--label) LABEL=$2; shift 2 ;;
+	*) qg_die "unknown argument $1" ;;
+	esac
+done
+[ -n "$POOL" ] && [ -n "$OUT" ] || qg_die "--pool and --out are mandatory"
+case "$(date +%s%N)" in
+*[!0-9]*) qg_die "date +%s%N gives no nanoseconds on this system" ;;
+esac
+mkdir -p "$OUT" || qg_die "cannot create $OUT"
+RES=$OUT/RESULT
+: > "$RES"
+say() { printf '%s\n' "$*" | tee -a "$RES"; }
+
+say "label=$LABEL date=$(qg_now)"
+say "os=$(uname -sr) ncpu=$(qg_ncpu) pagesize=$(getconf PAGESIZE)"
+say "module_loaded=$(qg_loaded_module_id)"
+if zpool status "$POOL" | grep -q '^[[:space:]]*logs'; then
+	say "dedicated_log=yes ($(zpool status "$POOL" | awk '/^[[:space:]]*logs/ {getline; print $1}'))"
+else
+	say "dedicated_log=no"
+fi
+
+# the helper is kept out of the dataset under test: starting it must not be
+# a read of that dataset
+TOOL=$OUT/mmap_tool
+cc -O2 -o "$TOOL" "$QG_DIR/mmap_tool.c" > "$OUT/cc.out" 2>&1 ||
+    qg_die "cannot build mmap_tool (see $OUT/cc.out)"
+
+DS=$POOL/qg-mmap
+MNT=$(zfs get -H -o value mountpoint "$POOL")/qg-mmap
+sudo zfs destroy -r "$DS" > /dev/null 2>&1
+sudo zfs create -o compression=off -o sync=standard -o recordsize=128K "$DS" ||
+    qg_die "cannot create $DS"
+sudo chown "$(id -u)" "$MNT"
+OBJ=$(printf '%x' "$(zfs get -H -p -o value objsetid "$DS")")
+FAR=1099511627776	# 1 TiB/s: far above what the test can do
+sudo zfs set qos:enabled=on qos:max_bw_read=$FAR qos:max_bw_write=$FAR "$DS" ||
+    qg_die "cannot set the limits"
+
+kstat_val() { # kstat_val <field of the QoS kstat>
+	case "$QG_OS" in
+	FreeBSD) sysctl -n "kstat.zfs.$POOL.qos.qos-0x$OBJ.$1" 2>/dev/null ;;
+	*) awk -v k="$1" '$1 == k {print $3}' "/proc/spl/kstat/zfs/$POOL/qos-0x$OBJ" 2>/dev/null ;;
+	esac
+}
+zil_val() { # zil_val <field of the dataset kstat>
+	case "$QG_OS" in
+	FreeBSD) sysctl -n "kstat.zfs.$POOL.dataset.objset-0x$OBJ.$1" 2>/dev/null ;;
+	*) awk -v k="$1" '$1 == k {print $3}' "/proc/spl/kstat/zfs/$POOL/objset-0x$OBJ" 2>/dev/null ;;
+	esac
+}
+[ -n "$(kstat_val stat_total_bytes_read)" ] || qg_die "no QoS kstat for $DS"
+
+M8=8388608
+FAIL=0
+# One file per access: none has been mapped before its own test.
+for _f in r-sys r-map w-held w-plain w-map t-r-sys t-r-map t-w-held t-w-plain; do
+	dd if=/dev/zero of="$MNT/$_f" bs=1048576 count=8 > /dev/null 2>&1 ||
+	    qg_die "cannot create $MNT/$_f"
+done
+sudo zpool sync "$POOL"
+
+# hold_start <file>: another process maps the file and reads all of it, so
+# that its pages are resident, then keeps the mapping until hold_stop.
+HOLD_PID=
+hold_start() {
+	mkfifo "$MNT/.hold-in-$1" "$MNT/.hold-out-$1" || return 1
+	"$TOOL" hold "$MNT/$1" < "$MNT/.hold-in-$1" > "$MNT/.hold-out-$1" \
+	    2> "$OUT/hold-$1.err" &
+	HOLD_PID=$!
+	exec 8> "$MNT/.hold-in-$1"
+	_ready=
+	read -r _ready < "$MNT/.hold-out-$1"
+	[ "$_ready" = ready ]
+}
+hold_stop() {
+	exec 8>&-
+	wait "$HOLD_PID"
+}
+
+printf 'access\tbytes\tcharged_read\tread_charges\tcharged_write\tlog_copied_bytes\tlog_indirect_bytes\tlog_commits\tseconds\n' \
+    > "$OUT/mmap_charge.tsv"
+# pat <name> <bytes accessed> <shell command, run in $MNT>
+pat() {
+	_r0=$(kstat_val stat_total_bytes_read); _n0=$(kstat_val stat_total_ios_read)
+	_w0=$(kstat_val stat_total_bytes_write)
+	_c0=$(zil_val zil_itx_copied_bytes); _k0=$(zil_val zil_itx_needcopy_bytes)
+	_i0=$(zil_val zil_itx_indirect_bytes); _m0=$(zil_val zil_commit_count)
+	_t0=$(date +%s%N)
+	( cd "$MNT" && eval "$3" ) > "$OUT/pat-$1.out" 2>&1 ||
+	    { say "FAIL $1: the access failed"; FAIL=1; return; }
+	_t1=$(date +%s%N)
+	sudo zpool sync "$POOL"
+	_r1=$(kstat_val stat_total_bytes_read); _n1=$(kstat_val stat_total_ios_read)
+	_w1=$(kstat_val stat_total_bytes_write)
+	_c1=$(zil_val zil_itx_copied_bytes); _k1=$(zil_val zil_itx_needcopy_bytes)
+	_i1=$(zil_val zil_itx_indirect_bytes); _m1=$(zil_val zil_commit_count)
+	printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$1" "$2" "$((_r1 - _r0))" \
+	    "$((_n1 - _n0))" "$((_w1 - _w0))" \
+	    "$((${_c1:-0} - ${_c0:-0} + ${_k1:-0} - ${_k0:-0}))" \
+	    "$((${_i1:-0} - ${_i0:-0}))" "$((${_m1:-0} - ${_m0:-0}))" \
+	    "$(awk -v a="$_t0" -v b="$_t1" 'BEGIN {printf "%.2f", (b - a) / 1e9}')" |
+	    tee -a "$OUT/mmap_charge.tsv"
+}
+# reference: the same file read by read(2)
+pat read_syscall $M8 'dd if=r-sys of=/dev/null bs=1048576'
+# read through a mapping: every page comes in on a fault
+pat read_mmap $M8 '"$TOOL" read r-map'
+# write(2) over a file whose pages are resident in another process
+if hold_start w-held; then
+	pat write_over_mapped $M8 'dd if=/dev/zero of=w-held bs=1048576 count=8 conv=notrunc'
+	hold_stop
+else
+	say "FAIL write_over_mapped: the file could not be held mapped"; FAIL=1
+fi
+# reference: the same write over a file nobody maps
+pat write_not_mapped $M8 'dd if=/dev/zero of=w-plain bs=1048576 count=8 conv=notrunc'
+# written through the mapping, then msync(MS_SYNC)
+pat write_mmap_msync $M8 '"$TOOL" write w-map'
+
+# The same accesses when the read limit is within reach: 1 MiB/s, the write
+# limit staying out of reach. The limit is set from "out of reach" before
+# each case, so that every case starts from the same reserve.
+printf 'case\tseconds\tcharged_read\tcharged_write\n' > "$OUT/timed.tsv"
+tcase() { # tcase <name> <shell command, run in $MNT>
+	sudo zfs set qos:max_bw_read=1048576 "$DS" || { FAIL=1; return; }
+	sudo zpool sync "$POOL"
+	_r0=$(kstat_val stat_total_bytes_read); _w0=$(kstat_val stat_total_bytes_write)
+	_t0=$(date +%s%N)
+	( cd "$MNT" && eval "$2" ) > "$OUT/timed-$1.out" 2>&1 ||
+	    { say "FAIL $1: the access failed"; FAIL=1; }
+	_t1=$(date +%s%N)
+	_r1=$(kstat_val stat_total_bytes_read); _w1=$(kstat_val stat_total_bytes_write)
+	printf '%s\t%s\t%s\t%s\n' "$1" \
+	    "$(awk -v a="$_t0" -v b="$_t1" 'BEGIN {printf "%.2f", (b - a) / 1e9}')" \
+	    "$((_r1 - _r0))" "$((_w1 - _w0))" | tee -a "$OUT/timed.tsv"
+	sudo zfs set qos:max_bw_read=$FAR "$DS" || FAIL=1
+	sudo zpool sync "$POOL"
+}
+tcase read_syscall 'dd if=t-r-sys of=/dev/null bs=1048576'
+tcase read_mmap '"$TOOL" read t-r-map'
+if hold_start t-w-held; then
+	tcase write_over_mapped 'dd if=/dev/zero of=t-w-held bs=1048576 count=8 conv=notrunc'
+	hold_stop
+else
+	say "FAIL timed write_over_mapped: the file could not be held mapped"; FAIL=1
+fi
+tcase write_not_mapped 'dd if=/dev/zero of=t-w-plain bs=1048576 count=8 conv=notrunc'
+
+sudo zfs destroy -r "$DS" > /dev/null 2>&1
+if [ "$FAIL" -ne 0 ]; then
+	say "RESULT=INCOMPLETE (an access failed)"
+	exit 1
+fi
+say "RESULT=MEASURED"
