diff --git a/include/sys/qos_bucket.h b/include/sys/qos_bucket.h
new file mode 100644
index 0000000000000000000000000000000000000000..dcc1f59abac5df3ea7068338a13f264d3995e95f
--- /dev/null
+++ b/include/sys/qos_bucket.h
@@ -0,0 +1,179 @@
+/*
