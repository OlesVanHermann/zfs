new file mode 100755
index 0000000000000000000000000000000000000000..ac6b58f7b7ac0ec24c480d72cf60ddaf32fd3d69
--- /dev/null
+++ b/tests/qos-gates/host/timings.sh
@@ -0,0 +1,94 @@
+#!/bin/bash
+# SPDX-License-Identifier: CDDL-1.0
+#
+# timings.sh — the table of measured durations, rebuilt from the evidence:
+# nothing in it is typed from memory.
+#
+#   timings.sh <out.tsv> [--manual FILE] [--no-builds] <evidence-root>...
+#
+# Sources, one line per action:
+#   - every <evidence-root>/<run>/host.txt (written by host/run_gate.sh,
+#     host/run_g2.sh, host/boost_cell.sh): host_seconds, and the verdict
+#     found in the run's RESULT file;
+#   - every BUILDINFO on the two test machines (written by build.sh):
+#     build_seconds and result, unless --no-builds;
+#   - the lines of --manual FILE, copied as they are: durations that were
+#     measured outside these tools. Same five columns; a start that was
+#     derived rather than recorded is written with a leading "~".
+#
+# Columns: start_utc, action, duration_seconds, status, source.
+# The totals per source are printed on standard output. They add up actions
+# that may have run at the same time on the two machines: this is execution
+# time, not elapsed time.
+
+set -uo pipefail
+QOS_ENV=${QOS_ENV:-/home/ubuntu/qos-tests/0-setup/qos_env.sh}
+# shellcheck disable=SC1090
+source "$QOS_ENV" >/dev/null 2>&1
+
+[ $# -ge 2 ] || { echo "usage: $0 <out.tsv> [--manual FILE] [--no-builds] <evidence-root>..." >&2; exit 2; }
+OUT=$1; shift
+MANUAL=; BUILDS=yes; ROOTS=()
+while [ $# -gt 0 ]; do
+	case "$1" in
+	--manual) MANUAL=$2; shift 2 ;;
+	--no-builds) BUILDS=no; shift ;;
+	*) ROOTS+=("$1"); shift ;;
+	esac
+done
+
+rows() {
+for root in "${ROOTS[@]}"; do
+	for h in "$root"/*/host.txt; do
+		[ -f "$h" ] || continue
+		d=$(dirname "$h"); n=$(basename "$d")
+		st=$(grep -h '^start=' "$h" | tail -1 | cut -d= -f2)
+		[ -n "$st" ] || st=$(echo "$n" | grep -o -E '[0-9]{8}T[0-9]{6}Z' | tail -1)
+		dur=$(grep -h '^host_seconds=' "$h" | tail -1 | cut -d= -f2)
+		res=$(grep -h '^RESULT=' "$d/out/RESULT" "$d/RESULT" 2>/dev/null | tail -1 |
+		    cut -d= -f2 | sed -E 's/ evidence=.*//' | cut -c1-48)
+		[ -n "$res" ] || res="NO_VERDICT($(grep -h -E 'ssh_rc|vm_lost' "$h" | tr '\n' ' ' | sed 's/ $//'))"
+		printf '%s\t%s\t%s\t%s\t%s\n' "${st:-NA}" \
+		    "$(echo "$n" | sed -E 's/-[0-9]{8}T[0-9]{6}Z$//')" \
+		    "${dur:-NON MESURÉ}" "$res" "evidence:$(basename "$(dirname "$(dirname "$root")")" | cut -c1-40)"
+	done
+done
+
+if [ "$BUILDS" = yes ]; then
+	for vm in lnx bsd; do
+		case "$vm" in
+		lnx) SSH=$LNX_SSH; BASE=/home/ubuntu/qos-build ;;
+		bsd) SSH=$BSD_SSH; BASE=/scratch/build ;;
+		esac
+		timeout 60 $SSH "sh -c 'for f in $BASE/*/BUILDINFO; do
+		    printf \"%s\\t%s\\t%s\\t%s\\n\" \
+		        \"\$(grep -h ^date= \$f | tail -1 | cut -d= -f2)\" \
+		        \"\$(basename \$(dirname \$f))\" \
+		        \"\$(grep -h ^build_seconds= \$f | tail -1 | cut -d= -f2)\" \
+		        \"\$(grep -h ^result= \$f | tail -1 | cut -d= -f2)\"
+		    done'" 2>/dev/null |
+		    while IFS=$'\t' read -r dt lab secs res; do
+			[ -n "$lab" ] || continue
+			printf '%s\t%s\t%s\t%s\t%s\n' "$(echo "$dt" | tr -d ':-')" \
+			    "build-$vm-$lab" "${secs:-NON MESURÉ}" "${res:-NO_VERDICT}" "BUILDINFO:$vm"
+		    done
+	done
+fi
+
+[ -n "$MANUAL" ] && [ -f "$MANUAL" ] && grep -v -E '^(#|start_utc)' "$MANUAL"
+return 0
+}
+
+{
+	printf 'start_utc\taction\tduration_seconds\tstatus\tsource\n'
+	rows | sort -t "$(printf '\t')" -k1,1
+} > "$OUT"
+
+echo "lines=$(($(wc -l < "$OUT") - 1)) file=$OUT"
+awk -F'\t' 'NR > 1 {
+	k = $5; sub(/:.*/, "", k)
+	if ($3 ~ /^[0-9.]+$/) { s[k] += $3; n[k]++; tot += $3; nt++ } else { u[k]++; ut++ }
+} END {
+	for (k in n) printf "  %-10s actions=%d seconds=%.0f not_measured=%d\n", k, n[k], s[k], u[k] + 0
+	printf "  %-10s actions=%d seconds=%.0f not_measured=%d\n", "TOTAL", nt, tot, ut + 0
+}' "$OUT" | sort
diff --git a/tests/qos-gates/host/vm_module.sh b/tests/qos-gates/host/vm_module.sh
new file mode 100755
index 0000000000000000000000000000000000000000..d01c3a1c77aec613b1f2b32eae9490f399b5a451
--- /dev/null
+++ b/tests/qos-gates/host/vm_module.sh
@@ -0,0 +1,85 @@
+#!/bin/bash
+# SPDX-License-Identifier: CDDL-1.0
+#
+# vm_module.sh — put a given ZFS kernel module in service on a test VM and
+# prove which one is loaded afterwards.
+#
+#   vm_module.sh bsd stock            FreeBSD base zfs.ko (control)
+#   vm_module.sh bsd tree:<label>     openzfs.ko built by build.sh in <base>/<label>
+#   vm_module.sh bsd ko:<path>        an openzfs.ko file kept on the VM
+#   vm_module.sh lnx tree:<label>     zfs.ko + spl.ko built in <base>/<label>
+#
+# FreeBSD: the module is chosen by the loader, so the VM is rebooted. The
+#   script waits for the libvirt reboot event, then for sshd.
+# Linux: the module stack is reloaded in place; pools are exported first and
+#   the scratch pool is imported again.
+#
+# Exit 0 only if the VM answers and reports the expected module.
+
+set -uo pipefail
+HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
+QOS_ENV=${QOS_ENV:-/home/ubuntu/qos-tests/0-setup/qos_env.sh}
+# shellcheck disable=SC1090
+source "$QOS_ENV" >/dev/null 2>&1
+
+[ $# -eq 2 ] || { echo "usage: $0 <lnx|bsd> <stock|tree:LABEL|ko:PATH>" >&2; exit 2; }
+VM=$1; WHAT=$2
+mono() { cut -d' ' -f1 /proc/uptime; }
+T0=$(mono)
+
+case "$VM" in
+bsd)
+	BASE=/scratch/build
+	case "$WHAT" in
+	stock)
+		$BSD_SSH "sudo sysrc -f /boot/loader.conf zfs_load=YES openzfs_load=NO" || exit 1
+		EXPECT=/boot/kernel/zfs.ko ;;
+	tree:*)
+		$BSD_SSH "sh $BASE/qos-gates/install_module.sh $BASE/${WHAT#tree:} &&
+		    sudo sysrc -f /boot/loader.conf zfs_load=NO openzfs_load=YES" || exit 1
+		EXPECT=/boot/kernel/openzfs.ko ;;
+	ko:*)
+		$BSD_SSH "sh $BASE/qos-gates/install_module.sh --ko ${WHAT#ko:} &&
+		    sudo sysrc -f /boot/loader.conf zfs_load=NO openzfs_load=YES" || exit 1
+		EXPECT=/boot/kernel/openzfs.ko ;;
+	*) echo "bad target $WHAT" >&2; exit 2 ;;
+	esac
+	WANT=$($BSD_SSH "sha256 -q $EXPECT")
+
+	# One listener for the reboot event, started before the reboot is asked.
+	sudo -n virsh event --domain "$BSD_VM_NAME" --event reboot --timeout 240 >/dev/null 2>&1 &
+	EV=$!
+	$BSD_SSH "sync; sudo shutdown -r now" >/dev/null 2>&1
+	wait $EV
+	# ssh retries by itself, once per attempt: no shell loop, no sleep.
+	if ! ssh -i "$SSH_KEY" $SSH_OPTS -o ConnectTimeout=5 -o ConnectionAttempts=90 \
+	    "freebsd@$BSD_VM_IP" true 2>/dev/null; then
+		echo "FAIL: $BSD_VM_NAME did not come back (mountroot? see the recovery procedure)" >&2
+		exit 1
+	fi
+	GOT=$($BSD_SSH "kldstat -v | awk '\$5 ~ /^(openzfs|zfs)\\.ko\$/ {gsub(/[()]/, \"\", \$6); print \$6; exit}'")
+	GOTSUM=$($BSD_SSH "sha256 -q $GOT")
+	echo "vm=bsd target=$WHAT loaded=$GOT sha256=$GOTSUM version=$($BSD_SSH 'sysctl -n vfs.zfs.version.module 2>/dev/null')"
+	if [ "$GOT" != "$EXPECT" ] || [ "$GOTSUM" != "$WANT" ]; then
+		echo "FAIL: expected $EXPECT sha256=$WANT" >&2
+		exit 1
+	fi
+	$BSD_SSH "zpool list -H -o name,health" | tr '\n' ' '; echo
+	;;
+lnx)
+	BASE=/home/ubuntu/qos-build
+	case "$WHAT" in
+	tree:*) L=${WHAT#tree:} ;;
+	*) echo "lnx supports tree:LABEL only" >&2; exit 2 ;;
+	esac
+	$LNX_SSH "sudo zpool export -a 2>/dev/null; sh $BASE/qos-gates/install_module.sh $BASE/$L" || exit 1
+	WANT=$($LNX_SSH "modinfo -F srcversion $BASE/$L/module/zfs.ko")
+	GOT=$($LNX_SSH "cat /sys/module/zfs/srcversion")
+	echo "vm=lnx target=$WHAT loaded_srcversion=$GOT installed=$($LNX_SSH 'modinfo -n zfs')"
+	[ "$GOT" = "$WANT" ] || { echo "FAIL: expected srcversion $WANT" >&2; exit 1; }
+	# The pools were exported to reload the module: bring the scratch pool back.
+	$LNX_SSH "sudo zpool import scratch 2>/dev/null; sudo zpool list -H -o name,health" | tr '\n' ' '; echo
+	;;
+*) echo "first argument must be lnx or bsd" >&2; exit 2 ;;
+esac
+echo "switch_seconds=$(echo "$(mono) - $T0" | bc)"
diff --git a/tests/qos-gates/host/vm_restart.sh b/tests/qos-gates/host/vm_restart.sh
new file mode 100755
index 0000000000000000000000000000000000000000..80b6d6332e38c2394efefd6f31129a606b457287
--- /dev/null
+++ b/tests/qos-gates/host/vm_restart.sh
@@ -0,0 +1,69 @@
+#!/bin/bash
+# SPDX-License-Identifier: CDDL-1.0
+#
+# vm_restart.sh — cold restart of a test VM (power off, power on), needed
+# when the libvirt definition changed or a new module must be picked up by
+# the FreeBSD loader. Waits on libvirt events and on sshd: no sleep, no loop
+# on a timer.
+#
+#   vm_restart.sh <lnx|bsd> [--force] [--snapshot TAG]
+#
+#   --force   the VM is hung (a process stuck in the kernel blocks a clean
+#             shutdown): cut the power with "virsh destroy" instead.
+#   --snapshot TAG
+#             while the VM is off, take an internal snapshot TAG of its
+#             system disk (the qcow2 one), to come back to with
+#             "qemu-img snapshot -a TAG <disk>" (VM off). To be done before
+#             a module that could keep the machine from booting is
+#             installed; the data disks are raw and are not part of it.
+
+set -uo pipefail
+QOS_ENV=${QOS_ENV:-/home/ubuntu/qos-tests/0-setup/qos_env.sh}
+# shellcheck disable=SC1090
+source "$QOS_ENV" >/dev/null 2>&1
+
+case "${1:-}" in
+lnx) SSH=$LNX_SSH; DOM=$LNX_VM_NAME; ADDR=ubuntu@$LNX_VM_IP; DOWN="sync; sudo shutdown -h now" ;;
+bsd) SSH=$BSD_SSH; DOM=$BSD_VM_NAME; ADDR=freebsd@$BSD_VM_IP; DOWN="sync; sudo shutdown -p now" ;;
+*) echo "usage: $0 <lnx|bsd> [--force] [--snapshot TAG]" >&2; exit 2 ;;
+esac
+VMARG=$1; shift
+FORCE=no; SNAP=
+while [ $# -gt 0 ]; do
+	case "$1" in
+	--force) FORCE=yes; shift ;;
+	--snapshot) SNAP=${2:-}; [ -n "$SNAP" ] || { echo "--snapshot needs a tag" >&2; exit 2; }; shift 2 ;;
+	*) echo "unknown argument $1" >&2; exit 2 ;;
+	esac
+done
+mono() { cut -d' ' -f1 /proc/uptime; }
+T0=$(mono)
+
+if [ "$FORCE" = yes ] && [ "$(sudo -n virsh domstate "$DOM")" = running ]; then
+	sudo -n virsh destroy "$DOM" >/dev/null
+fi
+if [ "$(sudo -n virsh domstate "$DOM")" = running ]; then
+	sudo -n virsh event --domain "$DOM" --event lifecycle --timeout 240 >/dev/null 2>&1 &
+	EV=$!
+	$SSH "$DOWN" >/dev/null 2>&1
+	wait $EV
+	# "Shutdown Finished" comes first, "Stopped" follows: at most 3 more events.
+	for _ in 1 2 3; do
+		[ "$(sudo -n virsh domstate "$DOM")" = "shut off" ] && break
+		sudo -n virsh event --domain "$DOM" --event lifecycle --timeout 60 >/dev/null 2>&1
+	done
+fi
+[ "$(sudo -n virsh domstate "$DOM")" = "shut off" ] || { echo "FAIL: $DOM is not shut off" >&2; exit 1; }
+if [ -n "$SNAP" ]; then
+	DISK=$(sudo -n virsh domblklist "$DOM" | awk '$2 ~ /\.qcow2$/ {print $2; exit}')
+	[ -n "$DISK" ] || { echo "FAIL: $DOM has no qcow2 system disk to snapshot" >&2; exit 1; }
+	sudo -n qemu-img snapshot -c "$SNAP" "$DISK" ||
+	    { echo "FAIL: cannot snapshot $DISK (the VM is left off)" >&2; exit 1; }
+	echo "snapshot=$SNAP disk=$DISK"
+fi
+sudo -n virsh start "$DOM" >/dev/null || { echo "FAIL: cannot start $DOM" >&2; exit 1; }
+if ! ssh -i "$SSH_KEY" $SSH_OPTS -o ConnectTimeout=5 -o ConnectionAttempts=90 "$ADDR" true 2>/dev/null; then
+	echo "FAIL: $DOM does not answer on ssh after start" >&2
+	exit 1
+fi
+echo "vm=$VMARG restarted restart_seconds=$(echo "$(mono) - $T0" | bc)"
diff --git a/tests/qos-gates/host/ztest_user.sh b/tests/qos-gates/host/ztest_user.sh
new file mode 100755
index 0000000000000000000000000000000000000000..29eee9ba25be2f710f8a8ca64d515a19a1a46418
--- /dev/null
+++ b/tests/qos-gates/host/ztest_user.sh
@@ -0,0 +1,66 @@
+#!/bin/bash
+# SPDX-License-Identifier: CDDL-1.0
+#
+# ztest_user.sh — repeated ztest passes of an in-tree build, in user space
+# (libzpool only: no kernel module is involved, so this may run on the host).
+#
+#   ztest_user.sh <tree> <workroot> <seconds-per-pass> <passes> [label]
+#
+# The tree is expected to be configured with --enable-debug --enable-asan
+# --enable-ubsan: assertions and sanitizers then cover the QoS code that is
+# compiled into libzpool. The pool layout of each pass comes from a fixed
+# table, so a fork tree and its upstream control see the same sequence.
+# Unlike scripts/zloop.sh this needs no root and leaves core_pattern alone.
+#
+# Stops at the first failing pass and keeps its directory. Exit 0 = all passed.
+
+set -uo pipefail
+[ $# -ge 4 ] || { echo "usage: $0 <tree> <workroot> <seconds-per-pass> <passes> [label]" >&2; exit 2; }
+TREE=$(cd "$1" && pwd); ROOT=$2; SECS=$3; N=$4; LABEL=${5:-$(basename "$TREE")}
+[ -x "$TREE/ztest" ] || { echo "no ztest in $TREE" >&2; exit 2; }
+mkdir -p "$ROOT"
+ROOT=$(cd "$ROOT" && pwd)
+
+export ASAN_OPTIONS=abort_on_error=true:halt_on_error=true:allocator_may_return_null=true:disable_coredump=true:detect_stack_use_after_return=true
+export UBSAN_OPTIONS=abort_on_error=true:halt_on_error=true:print_stacktrace=true
+ulimit -c 0
+
+# The raid kind is always explicit: left to "random", ztest may pick dRAID
+# with a child count that its own argument check then refuses.
+LAYOUTS=(
+	"-K raidz"
+	"-K raidz -m 0 -r 5 -R 2 -v 3"
+	"-K raidz -m 2 -r 0 -R 1 -v 2"
+	"-K raidz -a 12 -C special=on"
+	"-K raidz -m 0 -r 5 -R 1 -v 1 -X -t 16"
+	"-K draid -m 0 -r 8 -R 1 -D 4 -S 1 -v 1"
+)
+mono() { cut -d' ' -f1 /proc/uptime; }
+SUM=$ROOT/summary.txt
+{
+	echo "label=$LABEL tree=$TREE date=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+	echo "ztest_sha256=$(sha256sum "$TREE/.libs/ztest" 2>/dev/null | cut -d' ' -f1)"
+	echo "gitrev=$(sed -n 's/^#define[[:blank:]]ZFS_META_GITREV "\(.*\)"$/\1/p' "$TREE/include/zfs_gitrev.h" 2>/dev/null)"
+} >> "$SUM"
+
+FAILED=0
+for i in $(seq 1 "$N"); do
+	L=${LAYOUTS[$(( (i - 1) % ${#LAYOUTS[@]} ))]}
+	D=$ROOT/pass-$i
+	[ -e "$D" ] && { echo "refused: $D exists (one new directory per pass)" >&2; exit 3; }
+	mkdir "$D"
+	T0=$(mono)
+	# shellcheck disable=SC2086
+	timeout -k 30 $((SECS + 1200)) "$TREE/ztest" -G -VVVV $L -T "$SECS" -P $((SECS / 3 + 1)) -f "$D" > "$D.log" 2>&1
+	RC=$?
+	echo "pass=$i rc=$RC seconds=$(echo "$(mono) - $T0" | bc) layout='${L:-default}'" | tee -a "$SUM"
+	if [ $RC -ne 0 ]; then
+		FAILED=1
+		tail -40 "$D.log" > "$D.tail"
+		break
+	fi
+	# A passed pass needs no vdev files any more: release the space.
+	find "$D" -type f -exec truncate -s 0 {} +
+done
+[ $FAILED -eq 0 ] && echo "RESULT=PASS passes=$N" | tee -a "$SUM" || echo "RESULT=FAIL at pass $i (kept: $D)" | tee -a "$SUM"
+exit $FAILED
diff --git a/tests/qos-gates/install_module.sh b/tests/qos-gates/install_module.sh
new file mode 100755
index 0000000000000000000000000000000000000000..e6ea4ee3a0f234cc8b9d3a0d837f19e62bd9104c
--- /dev/null
+++ b/tests/qos-gates/install_module.sh
@@ -0,0 +1,105 @@
+#!/bin/sh
+# SPDX-License-Identifier: CDDL-1.0
+#
+# install_module.sh — install the kernel module built by build.sh, after
+# checking that it can load. Run on the machine that will load it.
+#
+#   install_module.sh <srcdir> [--kernel-dir /boot/kernel] [--backup-dir DIR]
+#
+# FreeBSD: copies module/openzfs.ko into the kernel directory (default
+#   /boot/kernel; a debug kernel has its own directory). The module is taken
+#   by the loader at the next boot: this script does NOT reboot.
+#   A root-on-ZFS machine does not boot with a module that fails to link, so
+#   every symbol the new module needs must be provided by the kernel or be
+#   already required by the module it replaces.
+# Linux: copies module/zfs.ko and module/spl.ko where depmod gives them
+#   priority, reloads the stack and proves srcversion(loaded) = srcversion(built).
+#   All pools must be exported by the caller first.
+#
+# The previous module is kept in the backup directory, named by its hash.
+
+set -u
+QG_DIR=$(cd "$(dirname "$0")" && pwd)
+. "$QG_DIR/lib.sh"
+
+SRC=; KO=; KDIR=/boot/kernel; BK=$HOME/ko-backups
+while [ $# -gt 0 ]; do
+	case "$1" in
+	--kernel-dir) KDIR=$2; shift 2 ;;
+	--backup-dir) BK=$2; shift 2 ;;
+	--ko) KO=$2; shift 2 ;;	# FreeBSD only: a module file kept from an earlier build
+	-*) qg_die "unknown option $1" ;;
+	*) SRC=$1; shift ;;
+	esac
+done
+if [ -n "$KO" ]; then
+	[ "$QG_OS" = FreeBSD ] && [ -f "$KO" ] || qg_die "--ko FILE: FreeBSD only, file must exist"
+else
+	[ -n "$SRC" ] && [ -f "$SRC/BUILDINFO" ] ||
+	    qg_die "usage: install_module.sh <srcdir built by build.sh> | --ko FILE"
+	grep -q '^result=PASS' "$SRC/BUILDINFO" || qg_die "$SRC/BUILDINFO is not a PASS build"
+fi
+mkdir -p "$BK"
+
+backup() { # backup <file>
+	[ -f "$1" ] || return 0
+	_h=$(qg_sha256 "$1" | cut -c1-16)
+	_d=$BK/$(basename "$1").$_h
+	[ -f "$_d" ] || sudo cp -p "$1" "$_d"
+	qg_log "previous $(basename "$1") kept as $_d"
+}
+
+case "$QG_OS" in
+FreeBSD)
+	NEW=${KO:-$SRC/module/openzfs.ko}
+	CUR=$KDIR/openzfs.ko
+	[ -f "$KDIR/kernel" ] || qg_die "$KDIR/kernel missing"
+	REF=$CUR
+	[ -f "$REF" ] || REF=$KDIR/zfs.ko
+	[ -f "$REF" ] || qg_die "no reference module in $KDIR to compare symbols with"
+
+	nm "$NEW" | awk '$1 == "U" {print $2}' | sort -u > /tmp/qg-new.u
+	nm "$REF" | awk '$1 == "U" {print $2}' | sort -u > /tmp/qg-ref.u
+	nm "$KDIR/kernel" | awk 'NF == 3 && $2 != "U" {print $3}' | sort -u > /tmp/qg-kern.d
+	# symbols the new module needs, that the replaced one did not need,
+	# and that the kernel does not define: these would stop the boot
+	comm -23 /tmp/qg-new.u /tmp/qg-ref.u | comm -23 - /tmp/qg-kern.d > /tmp/qg-missing
+	if [ -s /tmp/qg-missing ]; then
+		qg_log "unresolvable symbols:"; cat /tmp/qg-missing
+		qg_die "refusing to install $NEW: it would not link at boot"
+	fi
+	qg_log "link check ok ($(wc -l < /tmp/qg-new.u | tr -d ' ') undefined symbols, all covered)"
+
+	backup "$CUR"
+	sudo cp "$NEW" "$CUR" && sudo kldxref "$KDIR" || qg_die "copy failed"
+	qg_log "installed $CUR sha256=$(qg_sha256 "$CUR")"
+	qg_log "loaded now: $(qg_loaded_module_id) — takes effect at next boot"
+	;;
+Linux)
+	KV=$(uname -r)
+	DST=/lib/modules/$KV/kernel/zfs
+	want=$(modinfo -F srcversion "$SRC/module/zfs.ko")
+	[ -n "$want" ] || qg_die "cannot read srcversion of $SRC/module/zfs.ko"
+	[ -d "$DST" ] || sudo mkdir -p "$DST"
+	if lsmod | grep -q '^zfs '; then
+		[ -z "$(sudo zpool list -H -o name 2>/dev/null)" ] ||
+		    qg_die "pools are imported: export them before replacing the module"
+		sudo "$SRC/scripts/zfs.sh" -u >/dev/null 2>&1 || sudo modprobe -r zfs ||
+		    qg_die "cannot unload the running zfs module"
+	fi
+	for m in zfs spl; do
+		backup "$DST/$m.ko"
+		sudo cp "$SRC/module/$m.ko" "$DST/$m.ko" || qg_die "copy $m.ko failed"
+	done
+	sudo depmod -a "$KV" || qg_die "depmod failed"
+	inst=$(modinfo -F srcversion zfs)
+	[ "$inst" = "$want" ] || qg_die "modinfo resolves zfs to srcversion $inst, wanted $want ($(modinfo -n zfs))"
+	sudo modprobe zfs || qg_die "modprobe zfs failed"
+	got=$(cat /sys/module/zfs/srcversion)
+	[ "$got" = "$want" ] || qg_die "loaded srcversion $got, wanted $want"
+	qg_log "installed and loaded: $(modinfo -n zfs) srcversion=$got"
+	;;
+*)
+	qg_die "unsupported OS $QG_OS"
+	;;
+esac
diff --git a/tests/qos-gates/lib.sh b/tests/qos-gates/lib.sh
new file mode 100755
index 0000000000000000000000000000000000000000..5545930dc3a1cdc785e805e16a3215ea429904da
--- /dev/null
+++ b/tests/qos-gates/lib.sh
@@ -0,0 +1,138 @@
+#!/bin/sh
+# SPDX-License-Identifier: CDDL-1.0
+#
+# Common helpers for the QoS release gates.
+# POSIX sh on purpose: the same files run on Linux and on FreeBSD.
+
+QG_OS=$(uname -s)
+
+qg_ncpu() {
+	case "$QG_OS" in
+	FreeBSD) sysctl -n hw.ncpu ;;
+	*) nproc ;;
+	esac
+}
+
+qg_sha256() {
+	case "$QG_OS" in
+	FreeBSD) sha256 -q "$1" ;;
+	*) sha256sum "$1" | cut -d' ' -f1 ;;
+	esac
+}
+
+qg_make() {
+	case "$QG_OS" in
+	FreeBSD) gmake "$@" ;;
+	*) make "$@" ;;
+	esac
+}
+
+qg_now() { date -u +%Y-%m-%dT%H:%M:%SZ; }
+
+qg_log() { printf '%s %s\n' "$(qg_now)" "$*"; }
+
+qg_die() {
+	printf '%s FATAL %s\n' "$(qg_now)" "$*" >&2
+	exit 1
+}
+
+# Identity of the kernel module that is loaded right now.
+# Linux: srcversion. FreeBSD: sha256 of the file the kernel loaded.
+qg_loaded_module_id() {
+	case "$QG_OS" in
+	FreeBSD)
+		_f=$(kldstat -v | awk '$5 ~ /^(openzfs|zfs)\.ko$/ {
+		    gsub(/[()]/, "", $6); print $6; exit }')
+		if [ -n "$_f" ] && [ -f "$_f" ]; then
+			printf 'file=%s sha256=%s\n' "$_f" "$(qg_sha256 "$_f")"
+		else
+			printf 'file=unknown\n'
+		fi
+		;;
+	*)
+		if [ -r /sys/module/zfs/srcversion ]; then
+			printf 'srcversion=%s version=%s\n' \
+			    "$(cat /sys/module/zfs/srcversion)" \
+			    "$(cat /sys/module/zfs/version)"
+		else
+			printf 'not-loaded\n'
+		fi
+		;;
+	esac
+}
+
+# qg_wait_pid <pid> <seconds> — block until the process exits (return 0) or
+# until the delay is over (return 124). A process stuck in the kernel cannot
+# be killed, so timeout(1) would wait for it for ever; this never does, and
+# it does not poll.
+qg_wait_pid() {
+	case "$QG_OS" in
+	FreeBSD)
+		pwait -t "$2" "$1" >/dev/null 2>&1
+		_w=$?
+		;;
+	*)
+		timeout "$2" tail --pid="$1" -f /dev/null >/dev/null 2>&1
+		_w=$?
+		;;
+	esac
+	[ "$_w" -eq 124 ] && return 124
+	return 0
+}
+
+# qg_run_bounded <seconds> <outfile> <command...> — run a command with a
+# deadline. Returns the command's exit code, or 124 if it was still running
+# at the deadline (it is then left alone: see qg_wait_pid).
+qg_run_bounded() {
+	_tmo=$1; _out=$2; shift 2
+	"$@" > "$_out" 2>&1 &
+	_pid=$!
+	qg_wait_pid "$_pid" "$_tmo"
+	if [ $? -eq 124 ]; then
+		QG_STUCK_PID=$_pid
+		return 124
+	fi
+	wait "$_pid"
+}
+
+# Kernel message buffer, used to diff before/after a test.
+qg_dmesg() {
+	case "$QG_OS" in
+	FreeBSD) dmesg ;;
+	*) sudo dmesg ;;
+	esac
+}
+
+# Patterns that must never appear in the kernel log during a gate.
+QG_KERN_BAD='panic|PANIC|VERIFY|ASSERT|uncorrectable I/O|has encountered|suspended|lock order reversal|BUG:|Oops|general protection|hung_task|blocked for more than|KASAN|use-after-free|double fault|witness'
+# Under a debug kernel (gate G7) WITNESS reports lock order reversals for
+# unmodified OpenZFS too. They are then not a failure by themselves: the set
+# of reversals is written out and compared with the control run
+# (host/compare_lor.sh). Everything else stays fatal.
+QG_KERN_BAD_DEBUG='panic|PANIC|VERIFY|ASSERT|uncorrectable I/O|has encountered|suspended|BUG:|Oops|general protection|hung_task|blocked for more than|KASAN|use-after-free|double fault|sleeping thread|Sleeping on|non-sleepable|recursed on non-recursive|unlock of unowned|acquiring duplicate lock'
+
+# qg_require_debug_kernel — a run labelled "debug kernel" must be one. After
+# a panic the machine comes back on its default kernel (the one-shot boot is
+# spent), and the message buffer still holds the previous boot's lines: a
+# gate started then would look like a debug run without being one.
+qg_require_debug_kernel() {
+	case "$QG_OS" in
+	FreeBSD)
+		sysctl -n debug.witness.watch >/dev/null 2>&1 ||
+		    qg_die "--debug-kernel asked but this kernel ($(sysctl -n kern.ident)) has no WITNESS"
+		;;
+	*)
+		qg_log "note: no debug-kernel check on $QG_OS"
+		;;
+	esac
+}
+
+# qg_lor_pairs <file> — the distinct "first -> second" lock pairs that WITNESS
+# reported since boot (FreeBSD prints each distinct reversal once).
+qg_lor_pairs() {
+	case "$QG_OS" in
+	FreeBSD) dmesg ;;
+	*) sudo dmesg ;;
+	esac | grep -E '^lock order .* -> .* attempted at' |
+	    sed -e 's/^lock order //' -e 's/ attempted at.*//' | sort -u > "$1"
+}
diff --git a/tests/qos-gates/mmap_tool.c b/tests/qos-gates/mmap_tool.c
new file mode 100644
index 0000000000000000000000000000000000000000..a4ce2b9519fa221054f294fb0876c3d90838ba0a
--- /dev/null
+++ b/tests/qos-gates/mmap_tool.c
@@ -0,0 +1,98 @@
+// SPDX-License-Identifier: CDDL-1.0
+/*
+ * mmap_tool.c — the accesses through a memory mapping that
+ * diag_mmap_charge.sh measures. Built on the test machine by that script.
+ *
+ *   mmap_tool read FILE    read every byte of FILE through a mapping
+ *   mmap_tool write FILE   overwrite every byte of FILE through a shared
+ *                          mapping, then msync(MS_SYNC)
+ *   mmap_tool hold FILE    map FILE, read every byte so that its pages are
+ *                          resident, print "ready", then keep the mapping
+ *                          until standard input reaches end of file
+ *
+ * read and write print "bytes=<n> seconds=<s>".
+ */
+
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+
+static double
+now(void)
+{
+	struct timespec ts;
+
+	(void) clock_gettime(CLOCK_MONOTONIC, &ts);
+	return (ts.tv_sec + ts.tv_nsec / 1e9);
+}
+
+static int
+usage(void)
+{
+	(void) fprintf(stderr, "usage: mmap_tool read|write|hold FILE\n");
+	return (2);
+}
+
+int
+main(int argc, char **argv)
+{
+	struct stat st;
+	unsigned char *p;
+	volatile unsigned long sum = 0;
+	double t0;
+	int fd, wr, hold;
+	off_t i;
+	char c;
+
+	if (argc != 3)
+		return (usage());
+	wr = (strcmp(argv[1], "write") == 0);
+	hold = (strcmp(argv[1], "hold") == 0);
+	if (!wr && !hold && strcmp(argv[1], "read") != 0)
+		return (usage());
+
+	fd = open(argv[2], wr ? O_RDWR : O_RDONLY);
+	if (fd < 0 || fstat(fd, &st) != 0) {
+		perror(argv[2]);
+		return (1);
+	}
+	if (st.st_size == 0) {
+		(void) fprintf(stderr, "%s is empty\n", argv[2]);
+		return (1);
+	}
+	p = mmap(NULL, st.st_size, wr ? PROT_READ | PROT_WRITE : PROT_READ,
+	    MAP_SHARED, fd, 0);
+	if (p == MAP_FAILED) {
+		perror("mmap");
+		return (1);
+	}
+
+	t0 = now();
+	if (wr) {
+		(void) memset(p, 0x5a, st.st_size);
+		if (msync(p, st.st_size, MS_SYNC) != 0) {
+			perror("msync");
+			return (1);
+		}
+	} else {
+		for (i = 0; i < st.st_size; i++)
+			sum += p[i];
+	}
+
+	if (hold) {
+		(void) printf("ready\n");
+		(void) fflush(stdout);
+		while (read(0, &c, 1) > 0)
+			;
+	} else {
+		(void) printf("bytes=%lld seconds=%.3f\n",
+		    (long long)st.st_size, now() - t0);
+	}
+	(void) munmap(p, st.st_size);
+	(void) close(fd);
+	return (0);
+}
diff --git a/tests/qos-stress/README.md b/tests/qos-stress/README.md
new file mode 100644
index 0000000000000000000000000000000000000000..4464278c3c62f8972975d79c3d997170a86ee40a
--- /dev/null
+++ b/tests/qos-stress/README.md
@@ -0,0 +1,109 @@
+# qos-stress — ZFS QoS stress harness (Y-patch17)
+
+Reproducible harness to validate the ZFS QoS patches S/U/X at the scale
+of **1000 to 2000 datasets**. The existing S1/S2/S3 suite uses ~5
+datasets, which is not enough to surface wake-thread CPU, lock
+contention, or per-pool wake-thread sharding behavior.
+
+## Scripts
+
+| Script | Purpose |
+|---|---|
+| `lib.sh` | Shared helpers (naming, kstat read, pool/cmd checks). `source`d by the others. |
+| `create_datasets.sh NB POOL` | Create `POOL/stress/ds0001 … dsNNNN`. Idempotent. 10% get QoS props. |
+| `run_load.sh DURATION [POOL] [RUN_ID]` | Launch fio on `QOS_LOAD_PCT` (default 5%) of datasets, staggered startdelay. |
+| `measure_wake_cpu.sh DURATION [RUN_ID]` | `perf stat -e cycles,instructions` on wake threads + kstat delta CSV. |
+| `measure_locks.sh DURATION [RUN_ID]` | `perf lock record -a` / `perf lock report` — targeted summary CSV. |
+| `report.sh RUN_ID` | Aggregate the `RUN_ID` artifacts into `reports/${RUN_ID}.md`. |
+| `teardown.sh POOL` | Destroy every `POOL/stress/dsNNNN`. `--purge-parent` also removes the container. |
+
+All scripts expect to be run from this directory (they `source` `lib.sh`
+via `$BASH_SOURCE`).
+
+## Typical session
+
+```bash
+cd tests/qos-stress
+
+# 1. Populate
+bash create_datasets.sh 2000 testqos
+
+# 2. Parallel measurement + load
+RUN_ID="run-baseline-$(date -u +%Y%m%dT%H%M%SZ)"
+bash measure_wake_cpu.sh 300 "$RUN_ID" &
+bash measure_locks.sh    300 "$RUN_ID" &
+bash run_load.sh         300 testqos "$RUN_ID"
+wait
+
+# 3. Report
+bash report.sh "$RUN_ID"
+cat reports/${RUN_ID}.md
+
+# 4. Cleanup
+bash teardown.sh testqos
+```
+
+## Target metrics
+
+| Metric | no patch | + S | + S+U | + S+U+X |
+|---|---|---|---|---|
+| wake CPU idle, 2000 ds | ~1% | ~1% | <0.1% | <0.1% |
+| `qb_lock` rank in top10 (no-QoS load) | #1–3 | **absent** | absent | absent |
+| `qos_active_pools_lock` rank | present | present | present | **absent** |
+
+These are the pass/fail thresholds.
+
+## Environment assumptions
+
+- Linux host with a ZFS build that exposes `/proc/spl/kstat/zfs/qos-boost-wake`.
+- `fio`, `perf`, `zfs`, `zpool` in `$PATH`.
+- `perf lock record` needs root or a user with `CAP_SYS_ADMIN`.
+- `jq` optional but required for the IO table in `report.sh`.
+
+### Note on `wake_pids=0`
+
+`measure_wake_cpu.sh` looks up wake-thread PIDs with
+`pgrep -f qos_pool_wake`.  Linux ZFS kernel threads do **not** always
+publish the function name in `/proc/<pid>/comm`; in that case the
+lookup returns zero PIDs and the CSV row reports `wake_pids=0`.
+
+This is **expected** and not a failure — the script transparently falls
+back to `perf stat -a` (system-wide sampling) for the cycles/insns
+columns, and the real wake-thread activity is always observable through
+the `d_idle_cycles` / `d_signaled_early` / `d_surplus_*` deltas sourced
+from `/proc/spl/kstat/zfs/qos-boost-wake`, which is the authoritative
+source regardless of PID visibility.
+
+Local test pool:
+
+```
+Pool : testqos   (image-backed vdev under .../test-env/)
+```
+
+Heavier runs belong in a test VM, not on a machine that holds data.
+
+## Output layout
+
+```
+tests/qos-stress/
+  reports/
+    <RUN_ID>.md                  aggregated markdown report
+    <RUN_ID>_fio.json            raw fio per-job stats
+    <RUN_ID>_wake.csv            perf cycles/insns + kstat delta (one row)
+    <RUN_ID>_locks_top50.txt     perf lock report head
+    <RUN_ID>_locks_summary.csv   targeted qos lock ranks
+    <RUN_ID>_kstat_before.txt    /proc/spl/kstat/zfs/qos-boost-wake snapshot
+    <RUN_ID>_kstat_after.txt     snapshot after run
+    <RUN_ID>_load_ds.txt         list of datasets loaded
+  logs/
+    <RUN_ID>_fio.job             generated fio jobfile
+    <RUN_ID>_fio.log             fio stderr
+    <RUN_ID>_perf-lock.data      perf.data for offline replay
+    <RUN_ID>_perf-lock.log       perf lock record stderr
+```
+
+## Non-goals
+
+- No pool creation (the harness expects `testqos` or `testpool` already imported).
+- No ZFS source modification — this is test infrastructure only.
+- No automated regression scoring: the reports are read by a person.
diff --git a/tests/qos-stress/create_datasets.sh b/tests/qos-stress/create_datasets.sh
new file mode 100755
index 0000000000000000000000000000000000000000..7aafb27c28bc8608dfb89f3622343ded55ecc45a
--- /dev/null
+++ b/tests/qos-stress/create_datasets.sh
@@ -0,0 +1,73 @@
+#!/bin/bash
+# ── Y-patch17 stress harness: create NB datasets under POOL/stress/ ──
+#
+# Usage:  create_datasets.sh NB POOL
+#   NB    number of datasets (e.g. 2000)
+#   POOL  zpool name (e.g. testqos)
+#
+# - Dataset names are zero-padded: POOL/stress/ds0001 … dsNNNN.
+# - Idempotent: skips datasets that already exist (zfs list -H).
+# - Distribution: 10% get QoS properties set (1 every 10).
+#     qos:max_bw   in [ 1M , 100M ] bytes/s
+#     qos:max_iops in [ 100 , 5000 ]
+# - Target: 2000 datasets in < 5 min on NVMe.
+
+set -euo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+# shellcheck source=lib.sh
+source "$SCRIPT_DIR/lib.sh"
+
+if [ $# -ne 2 ]; then
+    echo "usage: $0 NB POOL" >&2
+    exit 2
+fi
+
+NB="$1"
+POOL="$2"
+
+require_cmd zfs
+require_cmd zpool
+require_pool "$POOL"
+
+# ── Parent container dataset ──
+PARENT="$POOL/stress"
+if ! zfs list -H -o name "$PARENT" >/dev/null 2>&1; then
+    log "creating parent dataset $PARENT"
+    zfs create "$PARENT"
+fi
+
+START=$(date +%s)
+CREATED=0
+SKIPPED=0
+QOS_SET=0
+
+for i in $(seq 1 "$NB"); do
+    dsname=$(printf "%s/ds%04d" "$PARENT" "$i")
+    if zfs list -H -o name "$dsname" >/dev/null 2>&1; then
+        SKIPPED=$((SKIPPED+1))
+    else
+        zfs create "$dsname"
+        CREATED=$((CREATED+1))
+    fi
+
+    if is_qos_active "$i"; then
+        # Deterministic but distributed values — not truly random so
+        # reruns produce comparable load.
+        bw=$(( ( (i * 7919) % 99 + 1 ) * 1000000 ))   # 1M..100M
+        iops=$(( (i * 6553) % 4900 + 100 ))           # 100..5000
+        zfs set "qos:max_bw=$bw" "qos:max_iops=$iops" "$dsname"
+        QOS_SET=$((QOS_SET+1))
+    fi
+
+    # Progress every 100 datasets
+    if (( i % 100 == 0 )); then
+        log "progress: $i / $NB (created=$CREATED skipped=$SKIPPED qos=$QOS_SET)"
+    fi
+done
+
+END=$(date +%s)
+ELAPSED=$((END - START))
+
+log "done: NB=$NB created=$CREATED skipped=$SKIPPED qos_set=$QOS_SET elapsed=${ELAPSED}s"
+echo "created=$CREATED skipped=$SKIPPED qos_set=$QOS_SET elapsed=${ELAPSED}s"
diff --git a/tests/qos-stress/lib.sh b/tests/qos-stress/lib.sh
new file mode 100755
index 0000000000000000000000000000000000000000..623bd53773d66951669c23260f48ebff2e8367e3
--- /dev/null
+++ b/tests/qos-stress/lib.sh
@@ -0,0 +1,87 @@
+#!/bin/bash
+# ── Y-patch17 stress harness: shared helpers ──
+#
+# Sourced by create_datasets.sh, run_load.sh, measure_wake_cpu.sh,
+# measure_locks.sh, report.sh, teardown.sh.
+
+set -euo pipefail
+
+BASE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+REPORTS_DIR="$BASE_DIR/reports"
+LOG_DIR="$BASE_DIR/logs"
+mkdir -p "$REPORTS_DIR" "$LOG_DIR"
+
+KSTAT_WAKE="/proc/spl/kstat/zfs/qos-boost-wake"
+
+# ── Naming ──
+# Zero-padded dataset name: ds0001 … ds9999
+ds_name() {
+    printf "ds%04d" "$1"
+}
+
+# ── Distribution ──
+# 10% of NB datasets get QoS properties enabled.
+qos_active_count() {
+    local nb="$1"
+    echo $(( nb / 10 ))
+}
+
+# Deterministic "is this dataset QoS-enabled?" (1 every 10).
+# Kept in one place so create_datasets.sh, run_load.sh and report.sh
+# agree on which datasets carry QoS.
+is_qos_active() {
+    local idx="$1"
+    (( idx % 10 == 0 ))
+}
+
+# ── kstat helpers ──
+# Fetch a named value from /proc/spl/kstat/zfs/qos-boost-wake.
+# Usage: kstat_read wake_idle_cycles_total
+#
+# Note: field names are the strings from KSTAT_NAMED_INIT in
+# qos_bucket.c (e.g. wake_*, zil_waited_total), NOT the C member
+# names (qwk_*) which are internal to the struct.
+kstat_read() {
+    local key="$1"
+    if [ -r "$KSTAT_WAKE" ]; then
+        awk -v k="$key" '$1==k {print $3}' "$KSTAT_WAKE" 2>/dev/null
+    fi
+}
+
+# Full snapshot of the wake kstat to a file.
+kstat_snapshot() {
+    local out="$1"
+    if [ -r "$KSTAT_WAKE" ]; then
+        cat "$KSTAT_WAKE" > "$out"
+    else
+        echo "# $KSTAT_WAKE unavailable" > "$out"
+    fi
+}
+
+# ── Environment validation ──
+require_cmd() {
+    local c="$1"
+    command -v "$c" >/dev/null 2>&1 || {
+        echo "error: missing required command: $c" >&2
+        return 1
+    }
+}
+
+require_pool() {
+    local pool="$1"
+    zpool list -H -o name "$pool" >/dev/null 2>&1 || {
+        echo "error: pool '$pool' not imported" >&2
+        return 1
+    }
+}
+
+# ── Run-id generation ──
+# Stable: caller passes explicit RUN_ID; fallback = timestamp.
+gen_run_id() {
+    echo "run-$(date -u +%Y%m%dT%H%M%SZ)"
+}
+
+# ── Logging ──
+log() {
+    echo "[$(date -u +%H:%M:%S)] $*" >&2
+}
diff --git a/tests/qos-stress/measure_locks.sh b/tests/qos-stress/measure_locks.sh
new file mode 100755
index 0000000000000000000000000000000000000000..3ee485486114425b230e6529c9e10a1ce6eac76b
--- /dev/null
+++ b/tests/qos-stress/measure_locks.sh
@@ -0,0 +1,77 @@
+#!/bin/bash
+# ── Y-patch17 stress harness: record and report kernel lock contention ──
+#
+# Usage:  measure_locks.sh DURATION [RUN_ID]
+#   DURATION  seconds to record (e.g. 60)
+#   RUN_ID    stable id for report files (default: run-<UTC>)
+#
+# Goal: verify that the QoS sharding / fast-path work (patches S/U/X)
+# has removed the expected locks from the top contention list.
+#
+#   - qos_active_pools_lock  should be absent (removed by X-patch16)
+#   - qb_lock                should be absent for no-QoS workloads
+#                            (S-patch11 fast-path)
+#
+# Output:
+#   logs/${RUN_ID}_perf-lock.data   raw perf.data (auto-deleted by caller)
+#   reports/${RUN_ID}_locks_top50.txt
+#   reports/${RUN_ID}_locks_summary.csv
+#
+# Note: perf lock record needs CAP_SYS_ADMIN / root.  The script uses
+# `sudo -n` where needed; fail fast if not allowed.
+
+set -euo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+# shellcheck source=lib.sh
+source "$SCRIPT_DIR/lib.sh"
+
+if [ $# -lt 1 ]; then
+    echo "usage: $0 DURATION [RUN_ID]" >&2
+    exit 2
+fi
+
+DURATION="$1"
+RUN_ID="${2:-$(gen_run_id)}"
+
+require_cmd perf
+
+DATA="$LOG_DIR/${RUN_ID}_perf-lock.data"
+TOP="$REPORTS_DIR/${RUN_ID}_locks_top50.txt"
+CSV="$REPORTS_DIR/${RUN_ID}_locks_summary.csv"
+
+if [ "$(id -u)" -ne 0 ]; then
+    SUDO="sudo -n"
+else
+    SUDO=""
+fi
+
+log "perf lock record for ${DURATION}s → $DATA"
+$SUDO perf lock record -a -o "$DATA" -- sleep "$DURATION" 2>&1 \
+    | tee -a "$LOG_DIR/${RUN_ID}_perf-lock.log" || {
+        log "perf lock record failed — see $LOG_DIR/${RUN_ID}_perf-lock.log"
+        exit 1
+    }
+
+log "perf lock report → $TOP"
+$SUDO perf lock report -i "$DATA" 2>/dev/null | head -60 > "$TOP" || true
+
+# ── Targeted summary CSV ──
+# We look for the QoS-related locks we care about.
+{
+    echo "run_id,lock_name,rank,hits_or_waits"
+    for lock in qos_active_pools_lock qb_lock dp_qos_active_lock dp_qos_wake_lock; do
+        line=$(grep -n -E "\\b${lock}\\b" "$TOP" 2>/dev/null | head -1 || true)
+        if [ -n "$line" ]; then
+            rank=$(echo "$line" | cut -d: -f1)
+            # perf lock report columns: Name acquired contended ...
+            counts=$(echo "$line" | awk '{print $2}')
+            echo "$RUN_ID,$lock,$rank,$counts"
+        else
+            echo "$RUN_ID,$lock,absent,0"
+        fi
+    done
+} > "$CSV"
+
+log "wrote $CSV"
+cat "$CSV"
diff --git a/tests/qos-stress/measure_wake_cpu.sh b/tests/qos-stress/measure_wake_cpu.sh
new file mode 100755
index 0000000000000000000000000000000000000000..588705bacd65e5101d16a85720e9f903cbd2ed10
--- /dev/null
+++ b/tests/qos-stress/measure_wake_cpu.sh
@@ -0,0 +1,104 @@
+#!/bin/bash
+# ── Y-patch17 stress harness: measure wake thread CPU & kstat deltas ──
+#
+# Usage:  measure_wake_cpu.sh DURATION [RUN_ID]
+#   DURATION  sampling window in seconds (e.g. 60)
+#   RUN_ID    stable id for report files (default: run-<UTC>)
+#
+# What it captures:
+#   perf stat -e cycles,instructions on every qos_wake / qos_pool_wake
+#     kernel thread found via /proc/<pid>/comm.
+#   Full kstat snapshot of /proc/spl/kstat/zfs/qos-boost-wake before and
+#     after, plus delta in CSV.
+#
+# Output:
+#   reports/${RUN_ID}_perf_wake.txt
+#   reports/${RUN_ID}_kstat_before.txt
+#   reports/${RUN_ID}_kstat_after.txt
+#   reports/${RUN_ID}_wake.csv      one-line CSV with deltas
+#
+# Note: kernel threads (kthread_t) may not be selectable by `perf stat -p`
+# on every kernel build.  If direct PID attach fails, fall back to a
+# system-wide perf stat filtered to the wake thread comm.
+
+set -euo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+# shellcheck source=lib.sh
+source "$SCRIPT_DIR/lib.sh"
+
+if [ $# -lt 1 ]; then
+    echo "usage: $0 DURATION [RUN_ID]" >&2
+    exit 2
+fi
+
+DURATION="$1"
+RUN_ID="${2:-$(gen_run_id)}"
+
+require_cmd perf
+
+PERFOUT="$REPORTS_DIR/${RUN_ID}_perf_wake.txt"
+KBEF="$REPORTS_DIR/${RUN_ID}_kstat_before.txt"
+KAFT="$REPORTS_DIR/${RUN_ID}_kstat_after.txt"
+CSV="$REPORTS_DIR/${RUN_ID}_wake.csv"
+
+# ── Locate wake threads ──
+# X-patch16: one thread per dsl_pool_t.  Kernel thread name is
+# "qos_pool_wake" (or legacy "qos_wake_thr" on pre-X patches).
+mapfile -t PIDS < <(pgrep -a -f 'qos_pool_wake\|qos_wake' 2>/dev/null \
+                    | awk '{print $1}' || true)
+
+log "found ${#PIDS[@]} wake thread(s): ${PIDS[*]:-<none>}"
+
+# ── kstat before ──
+# Y-patch17 c2 BUG#2: kstat field names are the strings in the
+# KSTAT_NAMED_INIT table of qos_bucket.c (prefixed "wake_" — and
+# "zil_waited_total" without the wake_ prefix), NOT the C member names
+# qwk_*.  The qwk_* spelling would always return empty → zero deltas.
+kstat_snapshot "$KBEF"
+BEF_IDLE=$(kstat_read wake_idle_cycles_total || echo 0)
+BEF_SIG=$(kstat_read wake_signaled_early || echo 0)
+BEF_COLL=$(kstat_read wake_surplus_collected || echo 0)
+BEF_DIST=$(kstat_read wake_surplus_distributed || echo 0)
+BEF_ZIL=$(kstat_read zil_waited_total || echo 0)
+
+START=$(date +%s)
+
+if [ ${#PIDS[@]} -gt 0 ]; then
+    PID_CSV=$(IFS=,; echo "${PIDS[*]}")
+    log "perf stat -p $PID_CSV for ${DURATION}s"
+    # shellcheck disable=SC2086
+    perf stat -e cycles,instructions -p "$PID_CSV" \
+        -- sleep "$DURATION" 2> "$PERFOUT" || {
+            log "per-PID perf failed, falling back to system-wide (filter post-hoc)"
+            perf stat -a -e cycles,instructions -- sleep "$DURATION" \
+                2> "$PERFOUT" || true
+        }
+else
+    log "no wake thread PIDs visible — running system-wide perf stat"
+    perf stat -a -e cycles,instructions -- sleep "$DURATION" 2> "$PERFOUT" || true
+fi
+
+END=$(date +%s)
+ELAPSED=$((END - START))
+
+# ── kstat after ──
+kstat_snapshot "$KAFT"
+AFT_IDLE=$(kstat_read wake_idle_cycles_total || echo 0)
+AFT_SIG=$(kstat_read wake_signaled_early || echo 0)
+AFT_COLL=$(kstat_read wake_surplus_collected || echo 0)
+AFT_DIST=$(kstat_read wake_surplus_distributed || echo 0)
+AFT_ZIL=$(kstat_read zil_waited_total || echo 0)
+
+# ── Extract perf counts ──
+CYCLES=$(awk '/cycles/ && !/instructions/ {gsub(",",""); print $1; exit}' "$PERFOUT" || echo "NA")
+INSNS=$(awk '/instructions/ {gsub(",",""); print $1; exit}' "$PERFOUT" || echo "NA")
+
+# ── CSV header + one row ──
+{
+    echo "run_id,duration_s,wake_pids,cycles,instructions,d_idle_cycles,d_signaled_early,d_surplus_collected,d_surplus_distributed,d_zil_waited"
+    echo "$RUN_ID,$ELAPSED,${#PIDS[@]},$CYCLES,$INSNS,$((AFT_IDLE-BEF_IDLE)),$((AFT_SIG-BEF_SIG)),$((AFT_COLL-BEF_COLL)),$((AFT_DIST-BEF_DIST)),$((AFT_ZIL-BEF_ZIL))"
+} > "$CSV"
+
+log "wrote $CSV"
+cat "$CSV"
diff --git a/tests/qos-stress/report.sh b/tests/qos-stress/report.sh
new file mode 100755
index 0000000000000000000000000000000000000000..218292f158ebf024d457ddc4ef3db0390636e081
--- /dev/null
+++ b/tests/qos-stress/report.sh
@@ -0,0 +1,130 @@
+#!/bin/bash
+# ── Y-patch17 stress harness: aggregate one run into a Markdown report ──
+#
+# Usage:  report.sh RUN_ID
+#   RUN_ID  the id that was used with run_load.sh / measure_*.sh
+#
+# Output:
+#   reports/${RUN_ID}.md   consolidated report
+#
+# Inputs (all optional — skipped cleanly if missing):
+#   reports/${RUN_ID}_fio.json
+#   reports/${RUN_ID}_wake.csv
+#   reports/${RUN_ID}_locks_top50.txt
+#   reports/${RUN_ID}_locks_summary.csv
+#   reports/${RUN_ID}_load_ds.txt
+#   reports/${RUN_ID}_kstat_before.txt
+#   reports/${RUN_ID}_kstat_after.txt
+
+set -euo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+# shellcheck source=lib.sh
+source "$SCRIPT_DIR/lib.sh"
+
+if [ $# -ne 1 ]; then
+    echo "usage: $0 RUN_ID" >&2
+    exit 2
+fi
+
+RUN_ID="$1"
+OUT="$REPORTS_DIR/${RUN_ID}.md"
+
+# ── Helpers (local to this script) ──
+file_exists() { [ -r "$1" ]; }
+
+section() {
+    echo ""
+    echo "## $1"
+    echo ""
+}
+
+fio_summary() {
+    local json="$1"
+    # Requires jq — degrade gracefully.
+    if command -v jq >/dev/null 2>&1 && file_exists "$json"; then
+        echo "| Dataset | MB/s read | MB/s write | p99 read µs | p99 write µs |"
+        echo "|---|---|---|---|---|"
+        jq -r '
+            .jobs[]? |
+            [
+              .jobname,
+              ((.read.bw // 0)/1024),
+              ((.write.bw // 0)/1024),
+              ((.read.clat_ns.percentile["99.000000"] // 0)/1000),
+              ((.write.clat_ns.percentile["99.000000"] // 0)/1000)
+            ] | @tsv
+        ' "$json" 2>/dev/null \
+            | awk -F'\t' 'BEGIN{OFS=" | "} {printf "| %s | %.2f | %.2f | %.1f | %.1f |\n",$1,$2,$3,$4,$5}' \
+            | head -20
+        local n
+        n=$(jq '.jobs | length' "$json" 2>/dev/null || echo 0)
+        if (( n > 20 )); then
+            echo ""
+            echo "_(showing 20 of $n jobs; full JSON in \`${RUN_ID}_fio.json\`)_"
+        fi
+        # Aggregate p99 across all jobs.
+        echo ""
+        local agg_r agg_w p99r p99w
+        agg_r=$(jq '[.jobs[].read.bw]  | add / 1024' "$json" 2>/dev/null || echo NA)
+        agg_w=$(jq '[.jobs[].write.bw] | add / 1024' "$json" 2>/dev/null || echo NA)
+        p99r=$(jq '[.jobs[].read.clat_ns.percentile["99.000000"]  // 0] | max / 1000' "$json" 2>/dev/null || echo NA)
+        p99w=$(jq '[.jobs[].write.clat_ns.percentile["99.000000"] // 0] | max / 1000' "$json" 2>/dev/null || echo NA)
+        echo "**Aggregate**: read=${agg_r} MB/s, write=${agg_w} MB/s, worst p99 read=${p99r} µs, worst p99 write=${p99w} µs"
+    else
+        echo "_jq not installed or fio json missing — see \`${RUN_ID}_fio.json\` raw_"
+    fi
+}
+
+# ── Write report ──
+{
+    echo "# Y-patch17 stress run: $RUN_ID"
+    echo ""
+    echo "- Generated: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
+    echo "- Host: $(hostname)"
+    echo "- Kernel: $(uname -r)"
+    if command -v zfs >/dev/null 2>&1; then
+        echo "- zfs: $(zfs version 2>/dev/null | head -1)"
+    fi
+
+    section "Config"
+    if file_exists "$REPORTS_DIR/${RUN_ID}_load_ds.txt"; then
+        # Y-patch17 c2 BUG#1: 'local' is only valid inside a function;
+        # this block is a command group { ... } > "$OUT" — use a plain
+        # shell variable.
+        nload=$(wc -l < "$REPORTS_DIR/${RUN_ID}_load_ds.txt" || echo 0)
+        echo "- Loaded datasets: **$nload**"
+    fi
+
+    section "Wake CPU & kstats"
+    if file_exists "$REPORTS_DIR/${RUN_ID}_wake.csv"; then
+        echo '```csv'
+        cat "$REPORTS_DIR/${RUN_ID}_wake.csv"
+        echo '```'
+    else
+        echo "_no wake csv_"
+    fi
+
+    section "Lock contention (top 5)"
+    if file_exists "$REPORTS_DIR/${RUN_ID}_locks_summary.csv"; then
+        echo '```csv'
+        cat "$REPORTS_DIR/${RUN_ID}_locks_summary.csv"
+        echo '```'
+    fi
+    if file_exists "$REPORTS_DIR/${RUN_ID}_locks_top50.txt"; then
+        echo ""
+        echo '```'
+        head -15 "$REPORTS_DIR/${RUN_ID}_locks_top50.txt"
+        echo '```'
+    fi
+
+    section "IO"
+    fio_summary "$REPORTS_DIR/${RUN_ID}_fio.json"
+
+    section "kstat snapshots"
+    echo "- Before: \`${RUN_ID}_kstat_before.txt\`"
+    echo "- After:  \`${RUN_ID}_kstat_after.txt\`"
+
+} > "$OUT"
+
+echo "wrote $OUT"
diff --git a/tests/qos-stress/run_load.sh b/tests/qos-stress/run_load.sh
new file mode 100755
index 0000000000000000000000000000000000000000..7b4fc54f4ab7e3a69a12559340585efddbb403f9
--- /dev/null
+++ b/tests/qos-stress/run_load.sh
@@ -0,0 +1,116 @@
+#!/bin/bash
+# ── Y-patch17 stress harness: launch fio load on a subset of datasets ──
+#
+# Usage:  run_load.sh DURATION [POOL] [RUN_ID]
+#   DURATION  run time in seconds (e.g. 300)
+#   POOL      default: testqos
+#   RUN_ID    stable id for report files (default: run-<UTC>)
+#
+# Env:
+#   QOS_LOAD_PCT  percentage of datasets to load (default: 5)
+#   QOS_RW_MIX    one of: randread, randwrite, randrw (default: randrw)
+#   QOS_BS        block size (default: 4k)
+#   QOS_SIZE      per-file size (default: 64m)
+#
+# Staggered start: fio 'startdelay' ramps from 0 to N * 0.1 s so the
+# wake path sees gradual activation, not a thundering herd.
+#
+# Output:
+#   reports/${RUN_ID}_fio.json      raw fio JSON (per-dataset stats)
+#   reports/${RUN_ID}_fio.log       fio stderr
+#   reports/${RUN_ID}_load_ds.txt   list of datasets that were loaded
+
+set -euo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+# shellcheck source=lib.sh
+source "$SCRIPT_DIR/lib.sh"
+
+if [ $# -lt 1 ]; then
+    echo "usage: $0 DURATION [POOL] [RUN_ID]" >&2
+    exit 2
+fi
+
+DURATION="$1"
+POOL="${2:-testqos}"
+RUN_ID="${3:-$(gen_run_id)}"
+
+LOAD_PCT="${QOS_LOAD_PCT:-5}"
+RW_MIX="${QOS_RW_MIX:-randrw}"
+BS="${QOS_BS:-4k}"
+SIZE="${QOS_SIZE:-64m}"
+
+require_cmd fio
+require_cmd zfs
+require_pool "$POOL"
+
+# ── Enumerate candidate datasets under POOL/stress/ ──
+mapfile -t ALL_DS < <(zfs list -H -o name -r "$POOL/stress" 2>/dev/null \
+                      | grep -E "/stress/ds[0-9]{4}$" | sort)
+TOTAL=${#ALL_DS[@]}
+if [ "$TOTAL" -eq 0 ]; then
+    echo "error: no datasets found under $POOL/stress — run create_datasets.sh first" >&2
+    exit 1
+fi
+
+# ── Select LOAD_PCT % of datasets, deterministic stride ──
+STEP=$(( 100 / LOAD_PCT ))
+(( STEP < 1 )) && STEP=1
+
+LOAD_DS=()
+idx=0
+for ds in "${ALL_DS[@]}"; do
+    if (( idx % STEP == 0 )); then
+        LOAD_DS+=("$ds")
+    fi
+    idx=$((idx+1))
+done
+
+NLOAD=${#LOAD_DS[@]}
+log "loading $NLOAD / $TOTAL datasets (${LOAD_PCT}%, rw=$RW_MIX, bs=$BS, size=$SIZE, dur=${DURATION}s)"
+
+JOBFILE="$LOG_DIR/${RUN_ID}_fio.job"
+: > "$JOBFILE"
+cat > "$JOBFILE" <<EOF
+[global]
+direct=1
+ioengine=libaio
+iodepth=8
+bs=$BS
+size=$SIZE
+rw=$RW_MIX
+rwmixread=70
+runtime=$DURATION
+time_based=1
+group_reporting=0
+thread=1
+
+EOF
+
+printf '%s\n' "${LOAD_DS[@]}" > "$REPORTS_DIR/${RUN_ID}_load_ds.txt"
+
+i=0
+for ds in "${LOAD_DS[@]}"; do
+    mntpt=$(zfs get -H -o value mountpoint "$ds" 2>/dev/null || true)
+    if [ -z "$mntpt" ] || [ "$mntpt" = "-" ] || [ "$mntpt" = "none" ]; then
+        log "skipping $ds (no mountpoint)"
+        continue
+    fi
+    # Spread startdelay 0..N*0.1s
+    delay=$(awk -v x="$i" 'BEGIN{printf "%.1f", x*0.1}')
+    cat >> "$JOBFILE" <<EOF
+[$ds]
+filename=${mntpt}/stress.dat
+startdelay=$delay
+
+EOF
+    i=$((i+1))
+done
+
+log "running fio ($i jobs) — see $LOG_DIR/${RUN_ID}_fio.log"
+fio --output-format=json \
+    --output="$REPORTS_DIR/${RUN_ID}_fio.json" \
+    "$JOBFILE" 2> "$LOG_DIR/${RUN_ID}_fio.log"
+
+log "fio complete: $REPORTS_DIR/${RUN_ID}_fio.json"
+echo "run_id=$RUN_ID jobs=$i json=$REPORTS_DIR/${RUN_ID}_fio.json"
diff --git a/tests/qos-stress/teardown.sh b/tests/qos-stress/teardown.sh
new file mode 100755
index 0000000000000000000000000000000000000000..a97bf33866f1c01fb371459dc698c2cab8259e62
--- /dev/null
+++ b/tests/qos-stress/teardown.sh
@@ -0,0 +1,77 @@
+#!/bin/bash
+# ── Y-patch17 stress harness: destroy all stress datasets under POOL ──
+#
+# Usage:  teardown.sh POOL
+#   POOL  zpool name (e.g. testqos)
+#
+# Destroys every dataset under POOL/stress/ (not POOL/stress itself,
+# unless --purge-parent is passed).  Target: 2000 datasets in < 2 min.
+#
+# Safety:
+#   - Will ONLY touch datasets named POOL/stress/dsNNNN.
+#   - Will refuse to run if the pool is not imported.
+#   - Will NEVER destroy the pool itself.
+
+set -euo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+# shellcheck source=lib.sh
+source "$SCRIPT_DIR/lib.sh"
+
+PURGE_PARENT=0
+if [ "${1:-}" = "--purge-parent" ]; then
+    PURGE_PARENT=1
+    shift
+fi
+
+if [ $# -ne 1 ]; then
+    echo "usage: $0 [--purge-parent] POOL" >&2
+    exit 2
+fi
+
+POOL="$1"
+require_cmd zfs
+require_pool "$POOL"
+
+PARENT="$POOL/stress"
+if ! zfs list -H -o name "$PARENT" >/dev/null 2>&1; then
+    log "$PARENT does not exist — nothing to do"
+    exit 0
+fi
+
+START=$(date +%s)
+
+# ── Enumerate ds* children only ──
+mapfile -t TARGETS < <(zfs list -H -o name -r "$PARENT" \
+                       | grep -E "/stress/ds[0-9]{4}$" || true)
+NT=${#TARGETS[@]}
+log "destroying $NT datasets under $PARENT"
+
+# ── Per-dataset destroy via xargs ──
+# `zfs destroy -f` is used — it only fails on busy datasets (e.g. fio
+# still running).  Callers should run_load.sh to completion before
+# teardown.
+#
+# AW-patch49: one dataset per invocation (-n 1).  `zfs destroy` accepts
+# a single dataset argument; the previous `-n 50` batching produced
+# `zfs destroy ds0 ds1 ...` which fails with "too many arguments" and
+# tore down nothing.  -n 1 keeps the dsNNNN-only safety filter (unlike
+# `zfs destroy -r` on the parent, which would also remove non-ds nodes).
+#
+# Y-patch17 c2: we run xargs sequentially (-P 1).  Parallel destroys
+# (-P 4) were untested and can race on shared metaslab/synctask state
+# under stress; sequential stays well within the <2 min target for
+# 2000 datasets on NVMe.
+if [ "$NT" -gt 0 ]; then
+    printf '%s\n' "${TARGETS[@]}" | xargs -n 1 -P 1 zfs destroy -f
+fi
+
+if [ "$PURGE_PARENT" -eq 1 ]; then
+    log "destroying parent $PARENT"
+    zfs destroy -r -f "$PARENT"
+fi
+
+END=$(date +%s)
+ELAPSED=$((END - START))
+log "done: destroyed=$NT purge_parent=$PURGE_PARENT elapsed=${ELAPSED}s"
+echo "destroyed=$NT purge_parent=$PURGE_PARENT elapsed=${ELAPSED}s"
