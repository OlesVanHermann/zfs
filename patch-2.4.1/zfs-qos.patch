@@ -0,0 +1,142 @@
+#!/bin/sh
+# SPDX-License-Identifier: CDDL-1.0
+#
+# g5_snapshot.sh — gate G5 (robustness), what a read limit does to the data
+# of a snapshot.
+#
+# The documentation says: snapshots are never limited. The read hooks skip a
+# dataset that is a snapshot, and no bucket is ever configured for one. The
+# consequence is that the files of a limited file system can be read without
+# limit through .zfs/snapshot/<name>/. This gate measures it: the same file
+# is read under a read limit from the file system, then through a snapshot,
+# then through the snapshot once a limit has been set on the snapshot itself
+# (user properties can be set on a snapshot).
+#
+#   g5_snapshot.sh --pool POOL --out OUTDIR [--label NAME]
+#
+# File of 6 MiB, limit of 1 MiB/s (the bucket holds 2 MiB): a limited read
+# takes at least 4 s, an unlimited one a fraction of a second. The data is
+# kept out of the cache with primarycache=metadata, so every read goes to
+# the disk and the pool does not have to be exported.
+# OUTDIR/snapshot.tsv: case, seconds, limited (yes, no, unclear), documented,
+# verdict. Exit 0 = every case behaves as documented and nothing hung.
+# The seconds are those of the bounded wait, which has a grain of one second
+# on Linux: an unlimited read shows as about 1 s. The time dd itself reports
+# for each case is kept in OUTDIR/dd-<case>.out.
+
+set -u
+QG_DIR=$(cd "$(dirname "$0")" && pwd)
+. "$QG_DIR/lib.sh"
+
+POOL=; OUT=; LABEL=g5-snapshot
+while [ $# -gt 0 ]; do
+	case "$1" in
+	--pool) POOL=$2; shift 2 ;;
+	--out) OUT=$2; shift 2 ;;
+	--label) LABEL=$2; shift 2 ;;
+	*) qg_die "unknown argument $1" ;;
+	esac
+done
+[ -n "$POOL" ] && [ -n "$OUT" ] || qg_die "--pool and --out are mandatory"
+case "$(date +%s%N)" in
+*[!0-9]*) qg_die "date +%s%N gives no nanoseconds on this system" ;;
+esac
+mkdir -p "$OUT" || qg_die "cannot create $OUT"
+RES=$OUT/RESULT
+: > "$RES"
+say() { printf '%s\n' "$*" | tee -a "$RES"; }
+FAIL=0
+bad() { say "FAIL $*"; FAIL=$((FAIL + 1)); }
+
+say "label=$LABEL date=$(qg_now)"
+say "os=$(uname -sr) ncpu=$(qg_ncpu)"
+say "module_loaded=$(qg_loaded_module_id)"
+qg_dmesg > "$OUT/dmesg.before" 2>/dev/null
+
+MNTP=$(zfs get -H -o value mountpoint "$POOL")
+DS=$POOL/qg-snap
+MNT=$MNTP/qg-snap
+SNAPF=$MNT/.zfs/snapshot/s1/f
+FILE_MIB=6
+RATE=1048576
+
+cleanup() {
+	# a snapshot that was reached through .zfs is mounted: let go of it first
+	sudo umount "$MNT/.zfs/snapshot/s1" >/dev/null 2>&1
+	sudo zfs destroy -r "$DS" >/dev/null 2>&1
+}
+cleanup
+sudo zfs create -o compression=off -o primarycache=metadata "$DS" ||
+    qg_die "cannot create $DS"
+sudo chown "$(id -u)" "$MNT"
+dd if=/dev/urandom of="$MNT/f" bs=1048576 count=$FILE_MIB 2>/dev/null ||
+    qg_die "cannot write the test file of $DS"
+sudo zfs snapshot "$DS@s1" || qg_die "cannot snapshot $DS"
+sudo zpool sync "$POOL"
+say "primarycache=$(zfs get -H -o value primarycache "$DS") snapdir=$(zfs get -H -o value snapdir "$DS")"
+
+# seconds taken to read the file, or HANG / ERROR
+tread() { # tread <file> <case>
+	_s=$(date +%s%N)
+	qg_run_bounded 60 "$OUT/dd-$2.out" dd if="$1" of=/dev/null bs=1048576
+	_rc=$?
+	_e=$(date +%s%N)
+	if [ $_rc -eq 124 ]; then echo HANG; return; fi
+	if [ $_rc -ne 0 ]; then echo ERROR; return; fi
+	echo "$_s $_e" | awk '{printf "%.2f", ($2 - $1) / 1000000000}'
+}
+
+printf 'case\tseconds\tlimited\tdocumented\tverdict\n' > "$OUT/snapshot.tsv"
+run_case() { # run_case <name> <file> <documented: yes|no>
+	_t=$(tread "$2" "$1")
+	case "$_t" in
+	HANG|ERROR) _lim=$_t ;;
+	*) _lim=$(echo "$_t" | awk '{print ($1 >= 3) ? "yes" : (($1 < 1.5) ? "no" : "unclear")}') ;;
+	esac
+	if [ "$_lim" = "$3" ]; then
+		_v=ok
+	else
+		_v=MISMATCH
+		bad "$1: read limited=$_lim (${_t} s), the documentation says $3"
+	fi
+	printf '%s\t%s\t%s\t%s\t%s\n' "$1" "$_t" "$_lim" "$3" "$_v" | tee -a "$OUT/snapshot.tsv"
+}
+
+# Both paths must be readable, and fast, before any limit exists: a path that
+# cannot be read would otherwise look like a read that was not slowed down.
+run_case filesystem_no_limit "$MNT/f" no
+run_case snapshot_no_limit "$SNAPF" no
+[ $FAIL -eq 0 ] || qg_die "the file is not read fast before any limit is set"
+
+sudo zfs set qos:enabled=on qos:max_bw_read=$RATE "$DS" ||
+    qg_die "cannot set the limit on $DS"
+say "limit: $(zfs get -H -o name,property,value,source qos:max_bw_read "$DS" "$DS@s1" | tr '\t\n' ' ;')"
+
+# 1. the file system itself: the control, the limit must hold
+run_case filesystem_limit "$MNT/f" yes
+# 2. the same blocks through the snapshot, which inherits the property
+run_case snapshot_inherited_limit "$SNAPF" no
+# 3. a limit set on the snapshot itself
+if sudo zfs set qos:enabled=on qos:max_bw_read=$RATE "$DS@s1" 2>"$OUT/set-on-snapshot.err"; then
+	say "limit on the snapshot: $(zfs get -H -o property,value,source qos:max_bw_read "$DS@s1" | tr '\t' ' ')"
+	run_case snapshot_own_limit "$SNAPF" no
+else
+	say "limit on the snapshot: refused ($(head -1 "$OUT/set-on-snapshot.err" | cut -c1-120))"
+	printf 'snapshot_own_limit\tNA\trefused\tno\tok\n' | tee -a "$OUT/snapshot.tsv"
+fi
+
+cleanup
+zfs list -H -o name "$DS" >/dev/null 2>&1 && bad "$DS is still there"
+qg_dmesg > "$OUT/dmesg.after" 2>/dev/null
+diff "$OUT/dmesg.before" "$OUT/dmesg.after" | grep '^>' > "$OUT/dmesg.new"
+NBAD=$(grep -c -E "$QG_KERN_BAD" "$OUT/dmesg.new")
+say "dmesg_bad=$NBAD"
+[ "$NBAD" -eq 0 ] || bad "kernel log: $(grep -m1 -E "$QG_KERN_BAD" "$OUT/dmesg.new" | cut -c1-200)"
+say "table=$OUT/snapshot.tsv"
+
+if [ $FAIL -eq 0 ]; then
+	say "RESULT=PASS"
+	exit 0
+fi
+say "RESULT=FAIL ($FAIL)"
+exit 1
diff --git a/tests/qos-gates/g6_zts.sh b/tests/qos-gates/g6_zts.sh
new file mode 100755
index 0000000000000000000000000000000000000000..c60b226f5e95f3a36f230170e55d8d58f3ab1442
--- /dev/null
+++ b/tests/qos-gates/g6_zts.sh
@@ -0,0 +1,111 @@
+#!/bin/sh
+# SPDX-License-Identifier: CDDL-1.0
+#
+# g6_zts.sh — gate G6: the ZFS Test Suite, run from a build tree against the
+# module that is loaded.
+#
+#   g6_zts.sh --tree DIR --out OUTDIR [--runfile sanity] [--label NAME]
+#             [--tags TAGS] [--test PATH]
+#
+# The suite fails on upstream too (environment, flaky tests). The verdict of
+# this script is therefore only "the suite ran to its end": the gate itself
+# is the comparison done by host/compare_zts.sh between this run and the
+# control run of the unmodified tree — no test may fail here that passed
+# there.
+#
+# Must run as a normal user with password-less sudo (the suite refuses root).
+# The loaded module must be the one built in DIR: checked on Linux by
+# srcversion, on FreeBSD by the sha256 of the installed module file.
+
+set -u
+QG_DIR=$(cd "$(dirname "$0")" && pwd)
+. "$QG_DIR/lib.sh"
+
+TREE=; OUT=; RUNFILE=sanity; LABEL=g6; TAGS=; ONE=
+while [ $# -gt 0 ]; do
+	case "$1" in
+	--tree) TREE=$2; shift 2 ;;
+	--out) OUT=$2; shift 2 ;;
+	--runfile) RUNFILE=$2; shift 2 ;;
+	--label) LABEL=$2; shift 2 ;;
+	--tags) TAGS=$2; shift 2 ;;
+	--test) ONE=$2; shift 2 ;;
+	*) qg_die "unknown argument $1" ;;
+	esac
+done
+[ -n "$TREE" ] && [ -x "$TREE/scripts/zfs-tests.sh" ] || qg_die "--tree DIR (a built tree) is mandatory"
+[ -n "$OUT" ] || qg_die "--out is mandatory"
+[ "$(id -u)" -ne 0 ] || qg_die "run as a normal user, not root"
+mkdir -p "$OUT" || qg_die "cannot create $OUT"
+RES=$OUT/RESULT
+: > "$RES"
+say() { printf '%s\n' "$*" | tee -a "$RES"; }
+
+# --- the module under test must be the tree's module --------------------------
+case "$QG_OS" in
+FreeBSD)
+	BUILT=$(qg_sha256 "$TREE/module/openzfs.ko")
+	LOADED=$(qg_loaded_module_id)
+	case "$LOADED" in
+	*"sha256=$BUILT"*) ;;
+	*) qg_die "loaded module ($LOADED) is not $TREE/module/openzfs.ko ($BUILT)" ;;
+	esac
+	;;
+*)
+	BUILT=$(modinfo -F srcversion "$TREE/module/zfs.ko")
+	LOADED=$(cat /sys/module/zfs/srcversion 2>/dev/null)
+	[ "$BUILT" = "$LOADED" ] || qg_die "loaded srcversion $LOADED is not the tree's ($BUILT)"
+	;;
+esac
+
+say "label=$LABEL date=$(qg_now)"
+say "os=$(uname -sr) ncpu=$(qg_ncpu)"
+say "module_loaded=$(qg_loaded_module_id)"
+say "tree=$TREE gitrev=$(sed -n 's/^#define[[:blank:]]ZFS_META_GITREV "\(.*\)"$/\1/p' "$TREE/include/zfs_gitrev.h" 2>/dev/null)"
+say "runfile=$RUNFILE tags=${TAGS:-<default>} single_test=${ONE:-<none>}"
+
+# In-tree helpers (udev rules, zed scripts): idempotent.
+sudo "$TREE/scripts/zfs-helpers.sh" -i > "$OUT/helpers.out" 2>&1
+
+qg_dmesg > "$OUT/dmesg.before" 2>/dev/null
+T0=$(date +%s)
+cd "$TREE" || qg_die "cd $TREE"
+set -- -v -r "$RUNFILE"
+[ -n "$TAGS" ] && set -- "$@" -T "$TAGS"
+[ -n "$ONE" ] && set -- -v -t "$ONE"
+./scripts/zfs-tests.sh "$@" > "$OUT/zfs-tests.out" 2>&1
+RC=$?
+say "zfs_tests_rc=$RC seconds=$(( $(date +%s) - T0 ))"
+
+# The runner prints "Results Summary" and the directory holding the log.
+RDIR=$(sed -n 's/^Log directory:[[:space:]]*//p' "$OUT/zfs-tests.out" | tail -1)
+say "results_dir=${RDIR:-unknown}"
+if [ -n "$RDIR" ] && [ -f "$RDIR/log" ]; then
+	sudo cp "$RDIR/log" "$OUT/zts.log" && sudo chown "$(id -u)" "$OUT/zts.log"
+	# One line per test, with an optional "[timestamp] " in front:
+	#   Test: <tree>/tests/zfs-tests/tests/<group>/<name> (run as <user>) [mm:ss] [RESULT]
+	# The tree prefix is dropped so that runs of two trees can be compared.
+	# host/compare_zts.sh applies the same rule to zts.log if needed.
+	sed -E -e 's/^\[[^]]*\] //' "$OUT/zts.log" |
+	    grep -E '^Test( \([^)]*\))?: ' |
+	    sed -E -e 's/^Test( \([^)]*\))?: //' \
+	        -e 's#^[^ ]*/tests/zfs-tests/tests/##' \
+	        -e 's/^([^ ]+).*\[([A-Z_]+)\][[:space:]]*$/\2 \1/' |
+	    sort -u > "$OUT/per-test.txt"
+	for s in PASS FAIL SKIP KILLED; do
+		say "count_$s=$(grep -c "^$s " "$OUT/per-test.txt")"
+	done
+	grep -E '^(FAIL|KILLED) ' "$OUT/per-test.txt" | awk '{print $2}' | sort -u > "$OUT/failed.txt"
+fi
+sed -n '/^Results Summary/,$p' "$OUT/zfs-tests.out" | head -40 > "$OUT/summary.txt"
+
+qg_dmesg > "$OUT/dmesg.after" 2>/dev/null
+diff "$OUT/dmesg.before" "$OUT/dmesg.after" | grep '^>' > "$OUT/dmesg.new"
+say "dmesg_bad=$(grep -c -E "$QG_KERN_BAD" "$OUT/dmesg.new")"
+
+if [ -s "$OUT/per-test.txt" ]; then
+	say "RESULT=PASS"
+	exit 0
+fi
+say "RESULT=FAIL (the suite did not produce a per-test log)"
+exit 1
diff --git a/tests/qos-gates/g8_noqos_perf.sh b/tests/qos-gates/g8_noqos_perf.sh
new file mode 100755
index 0000000000000000000000000000000000000000..b94366901b73bebb77ef2d5669c40d3dfc5fb1d6
--- /dev/null
+++ b/tests/qos-gates/g8_noqos_perf.sh
@@ -0,0 +1,211 @@
+#!/bin/sh
+# SPDX-License-Identifier: CDDL-1.0
+#
+# g8_noqos_perf.sh — gate G8: with no QoS property set, the fork must cost
+# nothing measurable compared with the unmodified module.
+#
+# One run measures a fixed set of workloads on a dataset of the given pool
+# and writes one line per metric to OUTDIR/metrics.tsv. The verdict is not
+# given here: host/compare_perf.sh compares the medians of several runs of
+# the fork with those of the control, taken alternately on the same machine.
+#
+#   g8_noqos_perf.sh --pool POOL --out OUTDIR [--label NAME] [--secs 15]
+#                    [--files 20000] [--datasets 300]
+#                    [--no-reopen] [--import-args "ARGS"]
+#                    [--set all|disk|cpu|datasets] [--parent-props N]
+#
+# --parent-props N gives the parent of the test datasets N user properties
+# (none of them a qos:* one) before the dataset workloads: loading a dataset
+# reads the properties of its whole lineage, so a parent that carries many
+# properties is the costly case.
+#
+# --set runs one family of workloads only, so that the families that are
+# quick and stable (cpu, datasets) can be repeated many times.
+#
+# Workloads, one for each place where the fork adds code on the path that
+# runs without QoS:
+#   seq_write, seq_read     buffered 1 MiB I/O      (write and read hooks,
+#                           bound by the disk and by memory copies)
+#   buf_write_4k, buf_read_4k   4 KiB I/O on a small cached file: bound by
+#                           the processor, the cost of one call shows here
+#   sync_write              4 KiB writes + fsync    (zil_commit hook)
+#   file_create, file_unlink                        (one transaction each)
+#   ds_create, ds_list3, ds_reopen, ds_destroy      (dataset instantiation:
+#                           the QoS properties are looked up every time a
+#                           dataset is loaded, and a dataset that is not
+#                           mounted is loaded again by every command;
+#                           ds_list3 lists them three times, warm;
+#                           ds_reopen lists every dataset
+#                           right after an export/import of the pool)
+# ds_reopen needs to export the pool: give --no-reopen when this script or
+# OUTDIR live on it, and --import-args when a plain "zpool import POOL" does
+# not find it. Control and fork runs must use the same options.
+#
+# Each metric is tagged primary or secondary, by the nature of its workload
+# and before any comparison. Primary: bound by the processor (4 KiB I/O on a
+# cached file, creation and removal of empty files) — stable to about one
+# percent from run to run, they are the ones that can show the cost of a few
+# instructions per call. Secondary: bound by the disk or by the pace of
+# transaction groups — they vary by tens of percent on a virtual disk and
+# can only show a gross regression.
+#
+# A workload that does not complete gives FAILED instead of a figure, and
+# the run fails: an operation that stops early must never read as a fast one.
+# Nothing else may run on the machine or on the host during a run.
+
+set -u
+QG_DIR=$(cd "$(dirname "$0")" && pwd)
+. "$QG_DIR/lib.sh"
+
+POOL=; OUT=; LABEL=g8; SECS=15; NFILES=20000; NDS=300; REOPEN=yes; IMPARGS=; SET=all; PPROPS=0
+while [ $# -gt 0 ]; do
+	case "$1" in
+	--pool) POOL=$2; shift 2 ;;
+	--out) OUT=$2; shift 2 ;;
+	--label) LABEL=$2; shift 2 ;;
+	--secs) SECS=$2; shift 2 ;;
+	--files) NFILES=$2; shift 2 ;;
+	--datasets) NDS=$2; shift 2 ;;
+	--no-reopen) REOPEN=no; shift ;;
+	--set) SET=$2; shift 2 ;;
+	--parent-props) PPROPS=$2; shift 2 ;;
+	--import-args) IMPARGS=$2; shift 2 ;;
+	*) qg_die "unknown argument $1" ;;
+	esac
+done
+[ -n "$POOL" ] && [ -n "$OUT" ] || qg_die "--pool and --out are mandatory"
+case "$SET" in
+all|disk|cpu|datasets) ;;
+*) qg_die "--set must be all, disk, cpu or datasets" ;;
+esac
+[ "$SET" = datasets ] || command -v fio >/dev/null 2>&1 || qg_die "fio is required"
+case "$(date +%s%N)" in
+*[!0-9]*) qg_die "date +%s%N gives no nanoseconds on this system" ;;
+esac
+mkdir -p "$OUT" || qg_die "cannot create $OUT"
+RES=$OUT/RESULT
+: > "$RES"
+say() { printf '%s\n' "$*" | tee -a "$RES"; }
+FAIL=0
+bad() { say "FAIL $*"; FAIL=$((FAIL + 1)); }
+M=$OUT/metrics.tsv
+: > "$M"
+: > "$OUT/workload.err"
+# metric <name> <value> <higher|lower> <primary|secondary>
+metric() { printf '%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4" | tee -a "$M"; }
+
+DS=$POOL/qg-perf
+MNT=$(zfs get -H -o value mountpoint "$POOL")/qg-perf
+say "label=$LABEL date=$(qg_now)"
+say "os=$(uname -sr) ncpu=$(qg_ncpu)"
+say "module_loaded=$(qg_loaded_module_id)"
+say "pool=$POOL set=$SET secs=$SECS files=$NFILES datasets=$NDS reopen=$REOPEN parent_props=$PPROPS"
+
+sudo zfs destroy -r "$DS" >/dev/null 2>&1
+sudo zfs create -o compression=off -o atime=off "$DS" || qg_die "cannot create $DS"
+sudo chown "$(id -u)" "$MNT"
+if [ "$PPROPS" -gt 0 ]; then
+	# all in one command: one transaction group instead of N
+	_args=; _i=0
+	while [ $_i -lt "$PPROPS" ]; do
+		_args="$_args qgtest:p$_i=value-$_i"; _i=$((_i + 1))
+	done
+	# shellcheck disable=SC2086
+	sudo zfs set $_args "$DS" || qg_die "cannot set $PPROPS user properties on $DS"
+fi
+QP=$(zfs get -H -o name,property,value,source all "$DS" 2>/dev/null | grep -c 'qos:')
+[ "$QP" -eq 0 ] || qg_die "qos:* properties apply to $DS — not a no-QoS run"
+
+# elapsed time of a command in milliseconds, or FAILED when it does not succeed
+ms() {
+	_s=$(date +%s%N)
+	if "$@" >/dev/null 2>>"$OUT/workload.err"; then
+		_e=$(date +%s%N)
+		echo $(( (_e - _s) / 1000000 ))
+	else
+		echo FAILED
+	fi
+}
+# one figure out of fio's terse output (field 7 = read KiB/s, 8 = read IOPS,
+# 48 = write KiB/s, 49 = write IOPS; field 5 = fio's error code), or FAILED
+fio_terse() { # fio_terse <field> <fio args...>
+	_f=$1; shift
+	_o=$(fio --minimal "$@" 2>>"$OUT/workload.err" | head -1)
+	if [ -n "$_o" ] && [ "$(printf '%s' "$_o" | cut -d';' -f5)" = 0 ]; then
+		printf '%s\n' "$_o" | cut -d';' -f"$_f"
+	else
+		echo FAILED
+	fi
+}
+count() { ls "$1" 2>/dev/null | wc -l | tr -d ' '; }
+
+EXPECT=0
+want() { [ "$SET" = all ] || [ "$SET" = "$1" ]; }
+
+BS=1048576
+if want disk; then
+	EXPECT=$((EXPECT + 3))
+	metric seq_write_kib_s "$(fio_terse 48 --name=sw --directory="$MNT" --rw=write --bs=$BS \
+	    --size=4g --time_based --runtime="$SECS" --ioengine=psync --end_fsync=1)" higher secondary
+	metric seq_read_kib_s "$(fio_terse 7 --name=sw --directory="$MNT" --rw=read --bs=$BS \
+	    --size=4g --time_based --runtime="$SECS" --ioengine=psync)" higher secondary
+	metric sync_write_iops "$(fio_terse 49 --name=sy --directory="$MNT" --rw=write --bs=4096 \
+	    --size=256m --time_based --runtime="$SECS" --ioengine=psync --fsync=1)" higher secondary
+fi
+
+if want cpu; then
+	EXPECT=$((EXPECT + 4))
+	# a file small enough to be rewritten and re-read in memory for the whole run
+	metric buf_write_4k_iops "$(fio_terse 49 --name=bw --directory="$MNT" --rw=write --bs=4096 \
+	    --size=64m --time_based --runtime="$SECS" --ioengine=psync)" higher primary
+	metric buf_read_4k_iops "$(fio_terse 8 --name=bw --directory="$MNT" --rw=read --bs=4096 \
+	    --size=64m --time_based --runtime="$SECS" --ioengine=psync)" higher primary
+	# files: one small transaction per operation
+	mkdir -p "$MNT/files" || qg_die "cannot create $MNT/files"
+	metric file_create_ms "$(ms sh -c "cd '$MNT/files' || exit 1; i=0
+	    while [ \$i -lt $NFILES ]; do : > f\$i || exit 1; i=\$((i+1)); done")" lower primary
+	[ "$(count "$MNT/files")" -eq "$NFILES" ] ||
+	    bad "file_create left $(count "$MNT/files") files, expected $NFILES"
+	metric file_unlink_ms "$(ms find "$MNT/files" -type f -name 'f*' -delete)" lower primary
+	[ "$(count "$MNT/files")" -eq 0 ] || bad "file_unlink left $(count "$MNT/files") files"
+fi
+
+if want datasets; then
+	# Datasets that are not mounted: each command that looks at one loads
+	# it again. Creation and destruction follow the pace of the transaction
+	# groups (secondary); listing them three times in a row, warm, is bound
+	# by the processor (primary); listing them once right after an
+	# export/import adds the reads from disk (secondary).
+	EXPECT=$((EXPECT + 3))
+	metric ds_create_ms "$(ms sh -c "i=0
+	    while [ \$i -lt $NDS ]; do
+	        sudo zfs create -o mountpoint=none $DS/d\$i || exit 1; i=\$((i+1))
+	    done")" lower secondary
+	ND=$(zfs list -H -r -o name "$DS" 2>/dev/null | wc -l | tr -d ' ')
+	[ "$ND" -eq $((NDS + 1)) ] || bad "ds_create left $ND datasets, expected $((NDS + 1))"
+	metric ds_list3_ms "$(ms sh -c "for k in 1 2 3; do
+	    sudo zfs list -H -r -o name,used $DS || exit 1; done")" lower primary
+	if [ "$REOPEN" = yes ]; then
+		EXPECT=$((EXPECT + 1))
+		# shellcheck disable=SC2086
+		sudo zpool export "$POOL" && sudo zpool import $IMPARGS "$POOL" ||
+		    qg_die "export/import of $POOL failed — the pool may be left exported"
+		metric ds_reopen_ms "$(ms sh -c "sudo zfs list -H -r -o name,used $DS")" lower secondary
+	fi
+	metric ds_destroy_ms "$(ms sudo zfs destroy -r "$DS")" lower secondary
+	zfs list -H -o name "$DS" >/dev/null 2>&1 && bad "ds_destroy left $DS"
+else
+	sudo zfs destroy -r "$DS" >/dev/null 2>&1
+fi
+
+NM=$(wc -l < "$M" | tr -d ' ')
+UNUSABLE=$(awk -F'\t' '$2 !~ /^[0-9]+(\.[0-9]+)?$/ || $2 + 0 == 0 {printf "%s ", $1}' "$M")
+say "metrics=$NM expected=$EXPECT"
+[ "$NM" -eq "$EXPECT" ] || bad "$NM metrics written, expected $EXPECT"
+[ -z "$UNUSABLE" ] || bad "no usable value for: $UNUSABLE(see workload.err)"
+if [ $FAIL -eq 0 ]; then
+	say "RESULT=PASS"
+	exit 0
+fi
+say "RESULT=FAIL ($FAIL)"
+exit 1
diff --git a/tests/qos-gates/g9_endurance.sh b/tests/qos-gates/g9_endurance.sh
new file mode 100755
index 0000000000000000000000000000000000000000..7ec6a6cd40ea768c2749df4d1c09f39fbbe24c25
--- /dev/null
+++ b/tests/qos-gates/g9_endurance.sh
@@ -0,0 +1,280 @@
+#!/bin/sh
+# SPDX-License-Identifier: CDDL-1.0
+#
+# g9_endurance.sh — gate G9 (endurance): hours of mixed load on limited and
+# unlimited datasets while their limits, their snapshots and the datasets
+# themselves keep changing. Run for a few minutes it is also the "everything
+# at once" case of gate G5.
+#
+#   g9_endurance.sh --pool POOL --out OUTDIR [--minutes N] [--label NAME]
+#                   [--debug-kernel]
+#
+# Datasets, all under POOL/qg-g9: four limited file systems (1, 2, 4 and
+# 8 MiB/s, the last one with operation limits too), two without any limit,
+# one limited volume. Workers, each a loop that runs until the time is over:
+#   write-*   writes of 4 KiB to 17 MiB, confirmed or not, on each file system
+#   read-*    reads of what the writers wrote
+#   mmap      a file read and written through a mapping, and written by
+#             write(2) while it is mapped (needs a C compiler; skipped if none)
+#   zvol      writes and reads on the volume
+#   props     every qos:* property set, changed, disabled, inherited, on the
+#             datasets the other workers are using
+#   snap      snapshot, clone with a limit of its own, read of the clone,
+#             destroy
+#   sendrecv  full send of a limited file system into a new one that is
+#             limited from its first byte, destroy
+#   life      limited datasets created, written and destroyed
+#   mount     a limited file system unmounted and mounted again
+#   kstat     every QoS kstat of the pool read
+# A worker counts its loops and the commands that failed in it.
+#
+# Exit 0 = no worker hung, no command failed, the test datasets could be
+# destroyed, the pool has as many QoS kstats as before, a scrub finds no
+# error, and the kernel logged nothing from the list of lib.sh.
+# OUTDIR/endurance.tsv: worker, loops, failed commands.
+
+set -u
+QG_DIR=$(cd "$(dirname "$0")" && pwd)
+. "$QG_DIR/lib.sh"
+
+POOL=; OUT=; LABEL=g9-endurance; MINUTES=1440; DEBUGK=no
+while [ $# -gt 0 ]; do
+	case "$1" in
+	--pool) POOL=$2; shift 2 ;;
+	--out) OUT=$2; shift 2 ;;
+	--label) LABEL=$2; shift 2 ;;
+	--minutes) MINUTES=$2; shift 2 ;;
+	--debug-kernel) DEBUGK=yes; shift ;;
+	*) qg_die "unknown argument $1" ;;
+	esac
+done
+[ -n "$POOL" ] && [ -n "$OUT" ] || qg_die "--pool and --out are mandatory"
+mkdir -p "$OUT" || qg_die "cannot create $OUT"
+[ "$DEBUGK" = yes ] && qg_require_debug_kernel
+RES=$OUT/RESULT
+: > "$RES"
+say() { printf '%s\n' "$*" | tee -a "$RES"; }
+FAIL=0
+bad() { say "FAIL $*"; FAIL=$((FAIL + 1)); }
+
+say "label=$LABEL date=$(qg_now) minutes=$MINUTES"
+say "os=$(uname -sr) ncpu=$(qg_ncpu)"
+say "module_loaded=$(qg_loaded_module_id)"
+qg_dmesg > "$OUT/dmesg.before" 2>/dev/null
+
+DS=$POOL/qg-g9
+MNT=$(zfs get -H -o value mountpoint "$POOL")/qg-g9
+STOP=$OUT/stop
+END=$(($(date +%s) + MINUTES * 60))
+M=1048576
+
+qos_kstats() { # how many QoS kstats the pool has
+	case "$QG_OS" in
+	FreeBSD) sysctl -N "kstat.zfs.$POOL.qos" 2>/dev/null | grep -c 'config_bw_rate_write$' ;;
+	*) ls "/proc/spl/kstat/zfs/$POOL/" 2>/dev/null | grep -c '^qos-0x' ;;
+	esac
+}
+settle() { # device events of the volume (see g10_compat.sh)
+	case "$QG_OS" in
+	FreeBSD) sysctl -n kern.geom.conftxt > /dev/null 2>&1 ;;
+	*) sudo udevadm settle > /dev/null 2>&1 ;;
+	esac
+}
+K0=$(qos_kstats)
+say "qos_kstats_before=$K0"
+
+sudo zfs destroy -r "$DS" > /dev/null 2>&1
+sudo zfs create -o compression=off "$DS" || qg_die "cannot create $DS"
+_r=1
+for _d in lim1 lim2 lim3 lim4; do
+	sudo zfs create -o qos:enabled=on -o qos:max_bw_read=$((_r * M)) \
+	    -o qos:max_bw_write=$((_r * M)) "$DS/$_d" || qg_die "cannot create $DS/$_d"
+	_r=$((_r * 2))
+done
+sudo zfs set qos:max_iops_read=2000 qos:max_iops_write=2000 qos:boost=2 "$DS/lim4" ||
+    qg_die "cannot set the operation limits"
+for _d in free1 free2 mm; do
+	sudo zfs create "$DS/$_d" || qg_die "cannot create $DS/$_d"
+done
+sudo zfs set qos:enabled=on qos:max_bw_read=$((4 * M)) qos:max_bw_write=$((4 * M)) "$DS/mm" ||
+    qg_die "cannot limit $DS/mm"
+sudo zfs create -V 256M -o qos:enabled=on -o qos:max_bw_read=$((4 * M)) \
+    -o qos:max_bw_write=$((4 * M)) "$DS/vol1" || qg_die "cannot create the volume"
+sudo chown -R "$(id -u)" "$MNT"
+settle
+[ -e "/dev/zvol/$DS/vol1" ] || qg_die "the volume has no device node"
+
+TOOL=
+if command -v cc > /dev/null 2>&1 &&
+    cc -O2 -o "$OUT/mmap_tool" "$QG_DIR/mmap_tool.c" > "$OUT/cc.out" 2>&1; then
+	TOOL=$OUT/mmap_tool
+	dd if=/dev/zero of="$MNT/mm/f" bs=$M count=4 2>/dev/null
+fi
+say "mmap_worker=$([ -n "$TOOL" ] && echo yes || echo "no (no C compiler)")"
+
+# run <command...>: one command of a worker; a failure is counted and its
+# output kept (the first twenty of each worker)
+run() {
+	"$@" > "$OUT/.last.$W" 2>&1 && return 0
+	E=$((E + 1))
+	[ "$E" -le 20 ] && { printf '== %s\n' "$*"; cat "$OUT/.last.$W"; } >> "$OUT/errors-$W.txt"
+	return 1
+}
+# worker <name> <function>: loops until the time is over or stop is asked
+worker() {
+	W=$1; N=0; E=0
+	while [ "$(date +%s)" -lt "$END" ] && [ ! -e "$STOP" ]; do
+		"$2"
+		N=$((N + 1))
+		[ $((N % 50)) -eq 0 ] && echo "$N $E" > "$OUT/progress-$W"
+	done
+	printf '%s\t%s\t%s\n' "$W" "$N" "$E" > "$OUT/result-$W"
+}
+
+# sizes: 4 KiB x 256, 128 KiB x 16, 1 MiB x 4, 4 MiB x 2, one 17 MiB request
+wsize() {
+	case $((N % 5)) in
+	0) BS=4096; CNT=256 ;;
+	1) BS=131072; CNT=16 ;;
+	2) BS=$M; CNT=4 ;;
+	3) BS=$((4 * M)); CNT=2 ;;
+	*) BS=$((17 * M)); CNT=1 ;;
+	esac
+	case $((N % 3)) in 0) HOW=conv=notrunc ;; 1) HOW=conv=notrunc,fsync ;; *) HOW=oflag=sync ;; esac
+}
+w_write() { wsize; run dd if=/dev/zero of="$MNT/$WD/f$((N % 6))" bs=$BS count=$CNT $HOW; }
+w_read() {
+	[ -e "$MNT/$WD/f$((N % 6))" ] || { run dd if=/dev/zero of="$MNT/$WD/f$((N % 6))" bs=$M count=1; return; }
+	run dd if="$MNT/$WD/f$((N % 6))" of=/dev/null bs=$((1 << (12 + N % 9)))
+}
+w_mmap() {
+	case $((N % 3)) in
+	0) run "$TOOL" read "$MNT/mm/f" ;;
+	1) run "$TOOL" write "$MNT/mm/f" ;;
+	*) "$TOOL" hold "$MNT/mm/f" < /dev/null > /dev/null 2>&1
+	    run dd if=/dev/zero of="$MNT/mm/f" bs=$M count=4 conv=notrunc ;;
+	esac
+}
+w_zvol() {
+	if [ $((N % 2)) -eq 0 ]; then
+		run sudo dd if=/dev/zero of="/dev/zvol/$DS/vol1" bs=$M count=8 seek=$((N % 200)) conv=notrunc
+	else
+		run sudo dd if="/dev/zvol/$DS/vol1" of=/dev/null bs=$M count=8 skip=$((N % 200))
+	fi
+}
+w_props() {
+	_t=$DS/lim$((N % 4 + 1))
+	[ $((N % 9)) -eq 8 ] && _t=$DS/vol1
+	case $((N % 11)) in
+	0) run sudo zfs set qos:max_bw_write=$(((N % 7 + 1) * M)) "$_t" ;;
+	1) run sudo zfs set qos:max_bw_read=$(((N % 5 + 1) * M)) "$_t" ;;
+	2) run sudo zfs set qos:enabled=off "$_t" ;;
+	3) run sudo zfs set qos:enabled=on "$_t" ;;
+	4) run sudo zfs set qos:boost=$((N % 5)) "$_t" ;;
+	5) run sudo zfs set qos:boost_pool=$((N % 2)) "$_t" ;;
+	6) run sudo zfs set qos:count_arc_hits=off "$_t" ;;
+	7) run sudo zfs set qos:count_arc_hits=on qos:max_iosize=131072 "$_t" ;;
+	8) run sudo zfs inherit qos:max_iosize "$_t" ;;
+	9) run sudo zfs set qos:max_iops_write=$((N % 3 * 1000)) qos:max_iops_read=$((N % 4 * 1000)) "$_t" ;;
+	*) run sudo zfs set qos:max_bw_write=$M qos:max_bw_read=$M "$_t" ;;
+	esac
+}
+w_snap() {
+	run sudo zfs snapshot "$DS/lim2@s$N" || return
+	if run sudo zfs clone -o qos:enabled=on -o qos:max_bw_read=$((2 * M)) "$DS/lim2@s$N" "$DS/clone$N"; then
+		[ -e "$MNT/clone$N/f0" ] && run dd if="$MNT/clone$N/f0" of=/dev/null bs=$M
+		run sudo zfs destroy "$DS/clone$N"
+	fi
+	run sudo zfs destroy "$DS/lim2@s$N"
+}
+w_sendrecv() {
+	run sudo zfs snapshot "$DS/lim3@t$N" || return
+	run sh -c "sudo zfs send '$DS/lim3@t$N' | sudo zfs recv -o qos:enabled=on -o qos:max_bw_write=$((4 * M)) '$DS/recv$N'"
+	run sudo zfs destroy -r "$DS/recv$N"
+	run sudo zfs destroy "$DS/lim3@t$N"
+}
+w_life() {
+	run sudo zfs create -o qos:enabled=on -o qos:max_bw_write=$((2 * M)) -o qos:max_bw_read=$((2 * M)) "$DS/life$N" || return
+	run sudo dd if=/dev/zero of="$MNT/life$N/f" bs=$M count=2
+	run sudo zfs destroy "$DS/life$N"
+}
+w_mount() {
+	run sudo zfs set qos:enabled=on qos:max_bw_write=$(((N % 4 + 1) * M)) "$DS/free2"
+	run sudo zfs unmount "$DS/free2"
+	run sudo zfs mount "$DS/free2"
+	run sudo dd if=/dev/zero of="$MNT/free2/f" bs=$M count=1
+}
+w_kstat() {
+	case "$QG_OS" in
+	FreeBSD) sysctl "kstat.zfs.$POOL.qos" > /dev/null 2>&1 ;;
+	*) cat "/proc/spl/kstat/zfs/$POOL"/qos-0x* > /dev/null 2>&1 ;;
+	esac
+	return 0
+}
+
+PIDS=
+start() { # start <name> <function> [dataset the worker uses]
+	WD=${3:-}
+	worker "$1" "$2" &
+	PIDS="$PIDS $!:$1"
+}
+for _d in lim1 lim2 lim3 lim4 free1; do
+	start "write-$_d" w_write "$_d"
+	start "read-$_d" w_read "$_d"
+done
+[ -n "$TOOL" ] && start mmap w_mmap
+start zvol w_zvol
+start props w_props
+start snap w_snap
+start sendrecv w_sendrecv
+start life w_life
+start mount w_mount
+start kstat w_kstat
+say "workers=$(echo "$PIDS" | wc -w) end=$(date -u -r "$END" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -d "@$END" +%Y-%m-%dT%H:%M:%SZ)"
+
+# Every worker leaves its loop when the time is over. One that does not come
+# back within ten minutes of that is stuck in the kernel: nothing is destroyed
+# then, the state is left for whoever looks.
+HUNG=
+for _p in $PIDS; do
+	_left=$((END - $(date +%s) + 600))
+	[ "$_left" -lt 60 ] && _left=60
+	qg_wait_pid "${_p%%:*}" "$_left"
+	[ $? -eq 124 ] && HUNG="$HUNG ${_p#*:}"
+done
+: > "$STOP"
+printf 'worker\tloops\tfailed_commands\n' > "$OUT/endurance.tsv"
+cat "$OUT"/result-* >> "$OUT/endurance.tsv" 2>/dev/null
+say "table=$OUT/endurance.tsv"
+if [ -n "$HUNG" ]; then
+	bad "workers that did not return:$HUNG (datasets left in place)"
+else
+	_e=$(awk -F'\t' 'NR > 1 {s += $3} END {print s + 0}' "$OUT/endurance.tsv")
+	_n=$(awk -F'\t' 'NR > 1 {s += $2} END {print s + 0}' "$OUT/endurance.tsv")
+	say "loops=$_n failed_commands=$_e"
+	[ "$_e" -eq 0 ] || bad "$_e commands failed (see errors-*.txt)"
+	awk -F'\t' 'NR > 1 && $2 == 0 {print $1}' "$OUT/endurance.tsv" > "$OUT/idle-workers.txt"
+	[ -s "$OUT/idle-workers.txt" ] && bad "workers that never completed a loop: $(tr '\n' ' ' < "$OUT/idle-workers.txt")"
+	settle
+	sudo zfs destroy -r "$DS" || bad "cannot destroy $DS"
+	K1=$(qos_kstats)
+	say "qos_kstats_after=$K1"
+	[ "$K1" = "$K0" ] || bad "the pool had $K0 QoS kstats before the run and has $K1 after it"
+	sudo zpool scrub -w "$POOL" || bad "scrub did not run"
+	zpool status "$POOL" > "$OUT/zpool-status.txt" 2>&1
+	grep -q 'errors: No known data errors' "$OUT/zpool-status.txt" || bad "pool not clean after the scrub"
+fi
+
+qg_dmesg > "$OUT/dmesg.after" 2>/dev/null
+diff "$OUT/dmesg.before" "$OUT/dmesg.after" | grep '^>' > "$OUT/dmesg.new"
+if [ "$DEBUGK" = yes ]; then _pat=$QG_KERN_BAD_DEBUG; else _pat=$QG_KERN_BAD; fi
+NBAD=$(grep -c -E "$_pat" "$OUT/dmesg.new")
+say "dmesg_bad=$NBAD"
+[ "$NBAD" -eq 0 ] || bad "kernel log: $(grep -m1 -E "$_pat" "$OUT/dmesg.new" | cut -c1-200)"
+
+if [ $FAIL -eq 0 ]; then
+	say "RESULT=PASS"
+	exit 0
+fi
+say "RESULT=FAIL ($FAIL)"
+exit 1
diff --git a/tests/qos-gates/host/boost_cell.sh b/tests/qos-gates/host/boost_cell.sh
new file mode 100755
index 0000000000000000000000000000000000000000..30273632b961c1ac60d87b80015110b82b5477ca
--- /dev/null
+++ b/tests/qos-gates/host/boost_cell.sh
@@ -0,0 +1,159 @@
+#!/bin/bash
+# SPDX-License-Identifier: CDDL-1.0
+#
+# boost_cell.sh — one reduced cell of the local boost scenario (S2), with the
+# counters of the wake thread read before and after each bench, to tell where
+# the boost tokens of a dataset come from.
+#
+#   boost_cell.sh <lnx|bsd> <label> <evroot> [--ds bench1] [--cap 5]
+#       [--boosts "1 4"] [--runtime 30] [--donor bench5:80] [--qos-debug]
+#
+# The module under test must already be loaded (host/vm_module.sh); <label>
+# only names the evidence, the identity of the loaded module is recorded.
+# Every other bench dataset has QoS disabled, exactly like in S2. With
+# --donor NAME:MIB one of them is enabled with that limit and left idle: it
+# is then the only outside source of surplus.
+#
+# The bench is the one of S2 (qos-tests/1-local/lib_emit.sh), so the figures
+# are comparable with the scenario tables. No verdict is given here: the
+# result is <evidence>/cells.tsv, one line per boost factor, with
+#   collected_mib    bytes taken from idle sub-buckets during the bench
+#   distributed_mib  bytes handed out as boost tokens during the bench
+#   donors_seen      idle-donor collections during the bench
+#   qos_kstats       datasets of the pool that have a QoS kstat afterwards
+#   total_bw_mib     the pool total rate last logged by the module (it bounds
+#                    the surplus store: 10 s of it per direction); NA when
+#                    the module logged nothing. Builds that only log it in
+#                    debug mode need --qos-debug (sets zfs_qos_debug=1 for
+#                    the duration of the cell).
+
+set -o pipefail
+QOS_ENV=${QOS_ENV:-/home/ubuntu/qos-tests/0-setup/qos_env.sh}
+QOS_LOCAL=${QOS_LOCAL:-/home/ubuntu/qos-tests/1-local}
+# shellcheck disable=SC1090
+source "$QOS_ENV" >/dev/null 2>&1
+
+usage() {
+	echo "usage: $0 <lnx|bsd> <label> <evroot> [--ds NAME] [--cap MIB]" \
+	    "[--boosts \"1 4\"] [--runtime SECS] [--donor NAME:MIB]" >&2
+	exit 2
+}
+[ $# -ge 3 ] || usage
+VM=$1; LABEL=$2; EVROOT=$3; shift 3
+DSN=bench1; CAP=5; BOOSTS="1 4"; RT=30; DONOR=; QDEBUG=no
+while [ $# -gt 0 ]; do
+	case "$1" in
+	--ds) DSN=$2; shift 2 ;;
+	--cap) CAP=$2; shift 2 ;;
+	--boosts) BOOSTS=$2; shift 2 ;;
+	--runtime) RT=$2; shift 2 ;;
+	--donor) DONOR=$2; shift 2 ;;
+	--qos-debug) QDEBUG=yes; shift ;;
+	*) usage ;;
+	esac
+done
+case "$VM" in
+lnx) SSH=$LNX_SSH; BASE=/home/ubuntu/qos-build ;;
+bsd) SSH=$BSD_SSH; BASE=/scratch/build ;;
+*) usage ;;
+esac
+
+STAMP=$(date -u +%Y%m%dT%H%M%SZ)
+EV=$EVROOT/boost_cell-$VM-$LABEL-$STAMP
+mkdir -p "$EV" || exit 2
+T0=$(cut -d' ' -f1 /proc/uptime)
+export VM RUNTIME=$RT OUT_DIR=$EV
+# shellcheck disable=SC1091
+source "$QOS_LOCAL/lib_emit.sh"
+
+MODID=$($SSH "sh -c '. $BASE/qos-gates/lib.sh >/dev/null 2>&1; qg_loaded_module_id'" 2>/dev/null)
+[ -n "$MODID" ] || { echo "cannot read the identity of the loaded module on $VM" >&2; exit 2; }
+RUN_DS=$POOL/$DSN
+
+# counters of the wake thread and the list of datasets that have a QoS kstat
+snap() { # snap <file>
+	case "$VM" in
+	lnx) $SSH "cat /proc/spl/kstat/zfs/qos-boost-wake 2>/dev/null;
+	    echo '== datasets';
+	    ls /proc/spl/kstat/zfs/$POOL/ 2>/dev/null | grep '^qos';
+	    echo '== dbgmsg';
+	    sudo grep -a total_bw= /proc/spl/kstat/zfs/dbgmsg 2>/dev/null | tail -3" ;;
+	bsd) $SSH "sysctl kstat.zfs.misc 2>/dev/null | grep 'qos-boost-wake';
+	    echo '== datasets';
+	    sysctl -N kstat.zfs.$POOL 2>/dev/null | grep -o 'qos-0x[0-9a-f]*' | sort -u;
+	    echo '== dbgmsg';
+	    sysctl -n kstat.zfs.misc.dbgmsg 2>/dev/null | grep -a total_bw= | tail -3" ;;
+	esac > "$1" 2>&1
+}
+val() { # val <file> <counter> -> value, or NA
+	awk -v k="$2" '$1 ~ (k ":?$") {print $NF; f = 1; exit} END {if (!f) print "NA"}' "$1"
+}
+delta_mib() { # delta_mib <before> <after>
+	awk -v a="$1" -v b="$2" 'BEGIN {
+		if (a == "NA" || b == "NA") print "NA"
+		else printf "%.1f", (b - a) / 1048576 }'
+}
+
+# zfs_qos_debug: Linux module parameter, FreeBSD sysctl
+qdebug() { # qdebug <0|1>
+	case "$VM" in
+	lnx) $SSH "echo $1 | sudo tee /sys/module/zfs/parameters/zfs_qos_debug" ;;
+	bsd) $SSH "sudo sysctl vfs.zfs.qos_debug=$1" ;;
+	esac >/dev/null 2>&1
+}
+[ "$QDEBUG" = yes ] && { qdebug 1 || { echo "cannot set zfs_qos_debug on $VM" >&2; exit 2; }; }
+
+vm_deploy_bench "$VM"
+if [ -n "$DONOR" ]; then
+	DDS=$POOL/${DONOR%%:*}
+	vm_qos_disable_all_others "$VM" "$RUN_DS" "$DDS"
+	vm_qos_set "$VM" "$DDS" "${DONOR##*:}" 0
+else
+	vm_qos_disable_all_others "$VM" "$RUN_DS"
+fi
+
+printf 'label\tmodule\tcap_mib\tboost\truntime\tdonor\tseq_w\tseq_r\trand_w\trand_r\tcollected_mib\tdistributed_mib\tdonors_seen\tqos_kstats\ttotal_bw_mib\n' > "$EV/cells.tsv"
+BAD=0; N=0
+for b in $BOOSTS; do
+	vm_qos_set "$VM" "$RUN_DS" "$CAP" "$b"
+	$SSH "sudo zfs get -H -o name,property,value -r -t filesystem \
+	    qos:enabled,qos:max_bw_read,qos:max_bw_write,qos:boost,qos:boost_pool $POOL" \
+	    > "$EV/props.b$b" 2>&1
+	snap "$EV/kstat.b$b.before"
+	read -r sw sr rw rr <<<"$(vm_run_bench "$VM" "$RUN_DS" "$CAP" "$b")"
+	snap "$EV/kstat.b$b.after"
+	c=$(delta_mib "$(val "$EV/kstat.b$b.before" wake_surplus_collected)" \
+	    "$(val "$EV/kstat.b$b.after" wake_surplus_collected)")
+	d=$(delta_mib "$(val "$EV/kstat.b$b.before" wake_surplus_distributed)" \
+	    "$(val "$EV/kstat.b$b.after" wake_surplus_distributed)")
+	s0=$(val "$EV/kstat.b$b.before" wake_idle_donors_seen)
+	s1=$(val "$EV/kstat.b$b.after" wake_idle_donors_seen)
+	if [ "$s0" = NA ] || [ "$s1" = NA ]; then seen=NA; else seen=$((s1 - s0)); fi
+	nk=$(sed -n '/^== datasets/,/^== dbgmsg/p' "$EV/kstat.b$b.after" | grep -c '^qos')
+	tbw=$(sed -n '/^== dbgmsg/,$p' "$EV/kstat.b$b.after" | grep -o 'total_bw=[0-9]*' | tail -1 |
+	    awk -F= '{printf "%.1f", $2 / 1048576; f = 1} END {if (!f) print "NA"}')
+	printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
+	    "$LABEL" "$MODID" "$CAP" "$b" "$RT" "${DONOR:-none}" \
+	    "$sw" "$sr" "$rw" "$rr" "$c" "$d" "$seen" "$nk" "$tbw" >> "$EV/cells.tsv"
+	N=$((N + 1))
+	case "$sw$sr$rw$rr" in
+	*—*|"") BAD=$((BAD + 1)) ;;
+	esac
+done
+vm_qos_unset "$VM" "$RUN_DS"
+[ -n "$DONOR" ] && vm_qos_unset "$VM" "$DDS"
+[ "$QDEBUG" = yes ] && qdebug 0
+
+T1=$(cut -d' ' -f1 /proc/uptime)
+{
+	echo "vm=$VM label=$LABEL module=$MODID"
+	echo "start=$STAMP"
+	echo "host_seconds=$(awk -v a="$T0" -v b="$T1" 'BEGIN {printf "%.2f", b - a}')"
+} > "$EV/host.txt"
+column -t -s "$(printf '\t')" "$EV/cells.tsv" | cut -c1-200
+if [ $BAD -eq 0 ] && [ $N -gt 0 ]; then
+	echo "RESULT=MEASURED ($N cells) evidence=$EV" | tee "$EV/RESULT"
+	exit 0
+fi
+echo "RESULT=FAIL ($BAD of $N cells gave no figure) evidence=$EV" | tee "$EV/RESULT"
+exit 1
diff --git a/tests/qos-gates/host/compare_lor.sh b/tests/qos-gates/host/compare_lor.sh
new file mode 100755
index 0000000000000000000000000000000000000000..8cab5aec90791264fc05284c7350f873bdaedfe2
--- /dev/null
+++ b/tests/qos-gates/host/compare_lor.sh
@@ -0,0 +1,44 @@
+#!/bin/bash
+# SPDX-License-Identifier: CDDL-1.0
+#
+# compare_lor.sh — part of the verdict of gate G7 (debug kernels): compare
+# the lock order reversals WITNESS reported during a run of the build under
+# test with those of the control run of the unmodified tree.
+#
+#   compare_lor.sh <control-evidence-dir> <fork-evidence-dir> [more fork dirs]
+#
+# Each directory comes from a gate run with --debug-kernel (it contains
+# lor-pairs.txt, at its root or under out/). PASS when every reversal seen
+# with the fork was also seen with the control. A reversal that involves a
+# QoS lock (qb_lock, dp_qos_*) is always reported, even if the control had a
+# pair of the same name.
+
+set -uo pipefail
+[ $# -ge 2 ] || { echo "usage: $0 <control-dir> <fork-dir> [fork-dir...]" >&2; exit 2; }
+find_lor() {
+	for f in "$1/lor-pairs.txt" "$1/out/lor-pairs.txt"; do
+		[ -f "$f" ] && { echo "$f"; return 0; }
+	done
+	return 1
+}
+
+C=$(find_lor "$1") || { echo "no lor-pairs.txt in $1" >&2; exit 2; }
+shift
+ALL=$(for d in "$@"; do
+	F=$(find_lor "$d") || { echo "no lor-pairs.txt in $d" >&2; exit 2; }
+	cat "$F"
+done | sort -u)
+
+NEW=$(comm -13 <(sort -u "$C") <(printf '%s\n' "$ALL" | grep .))
+QOS=$(printf '%s\n' "$ALL" | grep -E 'qb_lock|dp_qos|qos_' || true)
+echo "control: $(sort -u "$C" | wc -l) distinct reversals; fork: $(printf '%s\n' "$ALL" | grep -c .)"
+echo "reversals seen only with the fork: $(printf '%s' "$NEW" | grep -c .)"
+[ -n "$NEW" ] && printf '%s\n' "$NEW" | sed 's/^/  + /'
+echo "reversals involving a QoS lock: $(printf '%s' "$QOS" | grep -c .)"
+[ -n "$QOS" ] && printf '%s\n' "$QOS" | sed 's/^/  ! /'
+if [ -z "$NEW" ] && [ -z "$QOS" ]; then
+	echo "RESULT=PASS"
+	exit 0
+fi
+echo "RESULT=FAIL"
+exit 1
diff --git a/tests/qos-gates/host/compare_perf.sh b/tests/qos-gates/host/compare_perf.sh
new file mode 100755
index 0000000000000000000000000000000000000000..428b5b46463fb823a6f3d40545fa70eb2ed52e08
--- /dev/null
+++ b/tests/qos-gates/host/compare_perf.sh
@@ -0,0 +1,122 @@
+#!/bin/bash
+# SPDX-License-Identifier: CDDL-1.0
+#
+# compare_perf.sh — the verdict of gate G8, on pairs of runs.
+#
+#   compare_perf.sh [--threshold 3] <control-dir>... -- <fork-dir>...
+#
+# The i-th control directory and the i-th fork directory are one pair: two
+# runs of g8_noqos_perf.sh taken one right after the other on the same
+# machine, one with the control module, one with the build under test. Both
+# lists must have the same length.
+#
+# For each metric and each pair: how much worse the fork is than the control
+# in that pair, in percent (negative = better). Then the median of these
+# values and a confidence interval of that median taken from the order
+# statistics (no assumption on the distribution): the narrowest one that
+# covers at least 95 %, or, below six pairs, from the smallest to the largest
+# value (93.75 % with five pairs). The coverage is printed.
+#
+#   ok      the whole interval is at or below the threshold: with that
+#           confidence, the fork does not cost more than the threshold.
+#   WORSE   the whole interval is above the threshold.
+#   noise   the interval straddles the threshold, or there are fewer than
+#           five pairs: the measurement does not resolve it.
+#
+# Each metric is primary or secondary (fourth column of metrics.tsv, written
+# by g8_noqos_perf.sh; primary when absent).
+# Result: FAIL as soon as one metric, primary or secondary, is WORSE;
+# otherwise INCONCLUSIVE when a primary metric is "noise"; PASS when every
+# primary metric is "ok". A secondary metric that is "noise" is shown as such
+# and does not change the result.
+# Exit status: 0 PASS, 1 FAIL, 3 INCONCLUSIVE, 2 usage.
+
+set -uo pipefail
+T=3
+[ "${1:-}" = --threshold ] && { T=$2; shift 2; }
+CONTROL=(); FORK=(); side=c
+for a in "$@"; do
+	if [ "$a" = -- ]; then side=f; continue; fi
+	if [ $side = c ]; then CONTROL+=("$a"); else FORK+=("$a"); fi
+done
+N=${#CONTROL[@]}
+[ "$N" -ge 1 ] && [ "$N" -eq ${#FORK[@]} ] ||
+    { echo "usage: $0 [--threshold N] <control-dir>... -- <fork-dir>...  (same number on each side)" >&2; exit 2; }
+
+val() { # val <dir> <metric> -> the figure, or nothing when the workload failed
+	awk -F'\t' -v m="$2" '$1 == m && $2 ~ /^[0-9]+(\.[0-9]+)?$/ {print $2}' "$1/metrics.tsv" 2>/dev/null
+}
+
+FAIL=0; NOISE=0; NOISE2=0
+printf '%-18s %-9s %5s %12s %12s %8s %8s %8s  %s\n' \
+    metric class pairs control fork worse% ci_low ci_high verdict
+for m in $(awk -F'\t' '{print $1}' "${CONTROL[0]}/metrics.tsv"); do
+	dir=$(awk -F'\t' -v m="$m" '$1 == m {print $3}' "${CONTROL[0]}/metrics.tsv")
+	cls=$(awk -F'\t' -v m="$m" '$1 == m {print ($4 == "secondary") ? "secondary" : "primary"}' "${CONTROL[0]}/metrics.tsv")
+	rows=
+	for i in $(seq 0 $((N - 1))); do
+		c=$(val "${CONTROL[$i]}" "$m"); f=$(val "${FORK[$i]}" "$m")
+		[ -n "$c" ] && [ -n "$f" ] && rows="$rows$c $f"$'\n'
+	done
+	out=$(printf '%s' "$rows" | awk -v d="$dir" -v t="$T" -v want="$N" '
+	    function isort(a, n,   i, j, x) {
+		for (i = 2; i <= n; i++) {
+			x = a[i]
+			for (j = i - 1; j >= 1 && a[j] > x; j--) a[j + 1] = a[j]
+			a[j + 1] = x
+		}
+	    }
+	    function med(a, n) { return (n % 2) ? a[(n + 1) / 2] : (a[n / 2] + a[n / 2 + 1]) / 2 }
+	    NF == 2 && $1 > 0 {
+		n++; c[n] = $1; f[n] = $2
+		w[n] = (d == "higher") ? (1 - $2 / $1) * 100 : ($2 / $1 - 1) * 100
+	    }
+	    END {
+		if (n < want) { printf "MISSING %d\n", n; exit }
+		isort(c, n); isort(f, n); isort(w, n)
+		# largest k with P(Bin(n, 1/2) <= k - 1) <= 0.025; k = 1 when none
+		p = 1; for (i = 1; i <= n; i++) p /= 2
+		k = 1; cum = 0; term = p
+		for (j = 0; j < n; j++) {
+			cum += term
+			if (cum <= 0.025) k = j + 1; else break
+			term = term * (n - j) / (j + 1)
+		}
+		lo = w[k]; hi = w[n - k + 1]
+		if (n < 5) v = "noise"
+		else if (hi <= t) v = "ok"
+		else if (lo > t) v = "WORSE"
+		else v = "noise"
+		printf "%d %.6g %.6g %.1f %.1f %.1f %s\n", n, med(c, n), med(f, n), med(w, n), lo, hi, v
+	    }')
+	set -- $out
+	if [ "${1:-}" = MISSING ] || [ $# -lt 7 ]; then
+		printf '%-18s %-9s %5s %12s %12s %8s %8s %8s  %s\n' "$m" "$cls" "${2:-0}/$N" - - - - - MISSING
+		FAIL=$((FAIL + 1)); continue
+	fi
+	printf '%-18s %-9s %5s %12s %12s %8s %8s %8s  %s\n' "$m" "$cls" "$1" "$2" "$3" "$4" "$5" "$6" "$7"
+	case "$7" in
+	WORSE) FAIL=$((FAIL + 1)) ;;
+	noise) if [ "$cls" = primary ]; then NOISE=$((NOISE + 1)); else NOISE2=$((NOISE2 + 1)); fi ;;
+	esac
+done
+COV=$(awk -v n="$N" 'BEGIN {
+	p = 1; for (i = 1; i <= n; i++) p /= 2
+	k = 1; cum = 0; term = p; tail = p
+	for (j = 0; j < n; j++) {
+		cum += term
+		if (cum <= 0.025) { k = j + 1; tail = cum } else break
+		term = term * (n - j) / (j + 1)
+	}
+	printf "%.2f%% (order statistics %d and %d of %d)", (1 - 2 * tail) * 100, k, n - k + 1, n }')
+echo "pairs=$N threshold=${T}% interval coverage=$COV secondary metrics not resolved: $NOISE2"
+if [ $FAIL -gt 0 ]; then
+	echo "RESULT=FAIL ($FAIL metric(s) worse or missing)"
+	exit 1
+fi
+if [ $NOISE -gt 0 ]; then
+	echo "RESULT=INCONCLUSIVE ($NOISE primary metric(s) not resolved at ${T}%)"
+	exit 3
+fi
+echo "RESULT=PASS"
+exit 0
diff --git a/tests/qos-gates/host/compare_zts.sh b/tests/qos-gates/host/compare_zts.sh
new file mode 100755
index 0000000000000000000000000000000000000000..5361946be177cc63604a111495c65c8c6e8bf973
--- /dev/null
+++ b/tests/qos-gates/host/compare_zts.sh
@@ -0,0 +1,59 @@
+#!/bin/bash
+# SPDX-License-Identifier: CDDL-1.0
+#
+# compare_zts.sh — the verdict of gate G6: compare a ZFS Test Suite run of
+# the build under test with the control run of the unmodified tree.
+#
+#   compare_zts.sh <control-evidence-dir> <fork-evidence-dir>
+#
+# Both directories come from run_gate.sh ... g6_zts.sh: they contain zts.log
+# (the suite's own log) and usually per-test.txt. PASS when no test fails or
+# is killed in the fork run unless it also failed or was killed in the
+# control run, and no test that passed in the control run is missing from
+# the fork run.
+
+set -uo pipefail
+[ $# -eq 2 ] || { echo "usage: $0 <control-dir> <fork-dir>" >&2; exit 2; }
+C=$1; F=$2
+
+# "RESULT group/name" per test. Parsed from zts.log, tree prefix dropped:
+#   [timestamp] Test: <tree>/tests/zfs-tests/tests/<group>/<name> (run as root) [mm:ss] [RESULT]
+per_test() {
+	if [ -s "$1/zts.log" ]; then
+		sed -E -e 's/^\[[^]]*\] //' "$1/zts.log" |
+		    grep -E '^Test( \([^)]*\))?: ' |
+		    sed -E -e 's/^Test( \([^)]*\))?: //' \
+		        -e 's#^[^ ]*/tests/zfs-tests/tests/##' \
+		        -e 's/^([^ ]+).*\[([A-Z_]+)\][[:space:]]*$/\2 \1/' | sort -u
+	else
+		cat "$1/per-test.txt" 2>/dev/null
+	fi
+}
+CT=$(per_test "$C"); FT=$(per_test "$F")
+[ -n "$CT" ] || { echo "no test result in $C" >&2; exit 2; }
+[ -n "$FT" ] || { echo "no test result in $F" >&2; exit 2; }
+
+bad() { printf '%s\n' "$1" | grep -E '^(FAIL|KILLED) ' | awk '{print $2}' | sort -u; }
+ok() { printf '%s\n' "$1" | grep -E '^PASS ' | awk '{print $2}' | sort -u; }
+all() { printf '%s\n' "$1" | awk '{print $2}' | sort -u; }
+count() { printf '%s\n' "$1" | grep -c "^$2 "; }
+
+NEW=$(comm -13 <(bad "$CT") <(bad "$FT"))
+MISSING=$(comm -23 <(ok "$CT") <(all "$FT"))
+FIXED=$(comm -23 <(bad "$CT") <(bad "$FT"))
+
+echo "control: $(count "$CT" PASS) pass, $(bad "$CT" | grep -c .) fail/killed, $(count "$CT" SKIP) skip"
+echo "fork:    $(count "$FT" PASS) pass, $(bad "$FT" | grep -c .) fail/killed, $(count "$FT" SKIP) skip"
+echo "failing only in the fork run: $(printf '%s' "$NEW" | grep -c .)"
+[ -n "$NEW" ] && printf '%s\n' "$NEW" | sed 's/^/  + /'
+echo "passed in control, absent from the fork run: $(printf '%s' "$MISSING" | grep -c .)"
+[ -n "$MISSING" ] && printf '%s\n' "$MISSING" | sed 's/^/  ? /'
+echo "failing only in the control run: $(printf '%s' "$FIXED" | grep -c .)"
+[ -n "$FIXED" ] && printf '%s\n' "$FIXED" | sed 's/^/  - /'
+
+if [ -z "$NEW" ] && [ -z "$MISSING" ]; then
+	echo "RESULT=PASS"
+	exit 0
+fi
+echo "RESULT=FAIL"
+exit 1
diff --git a/tests/qos-gates/host/deploy_tree.sh b/tests/qos-gates/host/deploy_tree.sh
new file mode 100755
index 0000000000000000000000000000000000000000..85797172b28f88e490afecb8533b2b4021702d52
--- /dev/null
+++ b/tests/qos-gates/host/deploy_tree.sh
@@ -0,0 +1,53 @@
+#!/bin/bash
+# SPDX-License-Identifier: CDDL-1.0
+#
+# deploy_tree.sh — send one exact revision of an OpenZFS tree to a test VM,
+# into a directory that did not exist before, together with the gate scripts.
+#
+#   deploy_tree.sh <lnx|bsd> <git-dir> <rev> <label> [subdir]
+#
+# [subdir]: the OpenZFS tree is that directory of the revision (the published
+# repository keeps one tree per upstream base, under zfs-<version>-qos/).
+#
+# The VM gets <base>/<label>/ (sources, no .git) and <base>/qos-gates/.
+# include/zfs_gitrev.h is written here because the archive has no .git:
+# the built module then reports the revision it was built from.
+#
+# VM names, addresses and SSH commands come from qos_env.sh (QOS_ENV).
+
+set -euo pipefail
+HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
+QOS_ENV=${QOS_ENV:-/home/ubuntu/qos-tests/0-setup/qos_env.sh}
+# shellcheck disable=SC1090
+source "$QOS_ENV" >/dev/null 2>&1
+
+[ $# -eq 4 ] || [ $# -eq 5 ] ||
+    { echo "usage: $0 <lnx|bsd> <git-dir> <rev> <label> [subdir]" >&2; exit 2; }
+VM=$1; REPO=$2; REV=$3; LABEL=$4; SUB=${5:-}
+
+case "$VM" in
+lnx) SSH=$LNX_SSH; BASE=/home/ubuntu/qos-build ;;
+bsd) SSH=$BSD_SSH; BASE=/scratch/build ;;
+*) echo "first argument must be lnx or bsd" >&2; exit 2 ;;
+esac
+
+SHA=$(git -C "$REPO" rev-parse --verify "$REV^{commit}")
+DESC=$(git -C "$REPO" describe --always --long "$SHA")
+
+if $SSH "test -e $BASE/$LABEL"; then
+	echo "refused: $BASE/$LABEL already exists on $VM (one fresh directory per build)" >&2
+	exit 3
+fi
+
+$SSH "mkdir -p $BASE"
+git -C "$REPO" archive --prefix="$LABEL/" "$SHA${SUB:+:$SUB}" | $SSH "tar -xf - -C $BASE"
+printf '#define\tZFS_META_GITREV "%s"\n' "$DESC" |
+    $SSH "cat > $BASE/$LABEL/include/zfs_gitrev.h"
+printf 'rev=%s\nsubdir=%s\ndescribe=%s\nlabel=%s\ndeployed=%s\n' "$SHA" "$SUB" "$DESC" "$LABEL" \
+    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" | $SSH "cat > $BASE/$LABEL/DEPLOYINFO"
+
+# Gate scripts travel separately: they also drive trees that do not contain them.
+tar -C "$HERE/.." -cf - --exclude=host . |
+    $SSH "mkdir -p $BASE/qos-gates && tar -xf - -C $BASE/qos-gates && chmod +x $BASE/qos-gates/*.sh"
+
+echo "deployed $DESC ($SHA) to $VM:$BASE/$LABEL"
diff --git a/tests/qos-gates/host/judge_g4_mixed.sh b/tests/qos-gates/host/judge_g4_mixed.sh
new file mode 100755
index 0000000000000000000000000000000000000000..c11ad2db20ea8e8593b979d1f684de45da658e9c
--- /dev/null
+++ b/tests/qos-gates/host/judge_g4_mixed.sh
@@ -0,0 +1,96 @@
+#!/bin/bash
+# SPDX-License-Identifier: CDDL-1.0
+#
+# judge_g4_mixed.sh — verdict on a measurement of run_g4_mixed.sh: while
+# writes run on a dataset, do its reads keep their limit, and is its read
+# limit charged for reads only?
+#
+#   judge_g4_mixed.sh <evidence-dir> [--log yes|no]
+#
+# The chain of scenario S1 judges reads alone and writes alone, with equal
+# limits. A write that is also charged to the read limit goes through it
+# unseen: it only shows when reads and writes run together.
+#
+# Checks, for each repeat of the measurement:
+#   reference  phase "solo": the read alone is within 25 % of the limit and a
+#              byte the client read is charged once (0.95 to 1.05). If not,
+#              the bench is off and nothing is judged: INVALID.
+#   reads      phase "mixed": the sum of the two reads is within 25 % of the
+#              limit (the band of the read check of the chain).
+#   charge     phase "mixed": bytes charged to the read limit per byte read
+#              by the client's block device, 0.95 to 1.05. Not checked over
+#              NFS and CIFS, where the client has no block device.
+#   writes     phases "wdirect" and "wbuffered", when they were measured:
+#              nothing reads, so the read limit is charged at most 1 % of the
+#              bytes written.
+#   errors     any phase: fio reported no I/O error (column fio_errors, when
+#              the measurement has it).
+# The pool must have a dedicated log device: without one the intent log copies
+# almost nothing of these writes, and the checks pass whatever the module
+# does. run_g4_mixed.sh records it in host.txt (dedicated_log=); for a
+# measurement older than that line, give --log yes|no. No dedicated log:
+# INCONCLUSIVE.
+#
+# The bands are a proposal; they are not part of gate G4 until accepted.
+#
+# Exit 0 PASS, 1 FAIL, 2 usage, 3 INVALID or INCONCLUSIVE.
+
+set -uo pipefail
+[ $# -eq 1 ] || [ $# -eq 3 ] || { echo "usage: $0 <evidence-dir> [--log yes|no]" >&2; exit 2; }
+EV=$1; LOGDEV=
+if [ $# -eq 3 ]; then
+	[ "$2" = --log ] || { echo "usage: $0 <evidence-dir> [--log yes|no]" >&2; exit 2; }
+	LOGDEV=$3
+fi
+[ -r "$EV/mixed.tsv" ] || { echo "no mixed.tsv in $EV" >&2; exit 2; }
+if [ -z "$LOGDEV" ]; then
+	LOGDEV=$(sed -n 's/^dedicated_log=\([a-z]*\).*/\1/p' "$EV/host.txt" 2>/dev/null | head -1)
+fi
+case "$LOGDEV" in
+yes|no) ;;
+*) echo "RESULT=INCONCLUSIVE (host.txt does not say whether the pool has a dedicated log: give --log yes|no) evidence=$EV"; exit 3 ;;
+esac
+
+awk -F'\t' -v logdev="$LOGDEV" -v ev="$EV" '
+function col(n) { return (n in C) ? $(C[n]) : "NA" }
+function check(name, val, lo, hi,    ok) {
+	ok = (val + 0 >= lo && val + 0 <= hi)
+	printf "repeat %s  %-9s %-10s %8s  band %.2f to %.2f  %s\n", col("repeat"), col("phase"), name, val, lo, hi, ok ? "ok" : "OUT"
+	return ok
+}
+NR == 1 { for (i = 1; i <= NF; i++) C[$i] = i; next }
+{
+	lim = col("limit_mib_s") + 0; ph = col("phase")
+	# an I/O error returned to the client is a failure whatever the rates
+	if (col("fio_errors") != "NA" && col("fio_errors") + 0 > 0) {
+		printf "repeat %s  %-9s %-10s %8s  the client got I/O errors\n", col("repeat"), ph, "errors", col("fio_errors")
+		fail = 1
+	}
+	if (ph == "solo") {
+		if (!check("rate", col("ra"), 0.75 * lim, 1.25 * lim)) invalid = 1
+		if (col("charged_per_client_read") != "NA" &&
+		    !check("charge", col("charged_per_client_read"), 0.95, 1.05)) invalid = 1
+		nsolo++
+	} else if (ph == "mixed") {
+		if (!check("reads", col("r_sum"), 0.75 * lim, 1.25 * lim)) fail = 1
+		if (col("charged_per_client_read") == "NA")
+			printf "repeat %s  %-9s %-10s %8s  not checked (no block device on the client)\n", col("repeat"), ph, "charge", "NA"
+		else if (!check("charge", col("charged_per_client_read"), 0.95, 1.05)) fail = 1
+		nmixed++
+	} else if (ph == "wdirect" || ph == "wbuffered") {
+		w = (col("client_write_mib") != "NA") ? col("client_write_mib") : col("charged_write_mib")
+		if (w == "NA" || w + 0 == 0 || col("charged_read_mib") == "NA") {
+			printf "repeat %s  %-9s %-10s %8s  not checked (bytes written unknown)\n", col("repeat"), ph, "writes", "NA"
+		} else if (!check("writes", sprintf("%.3f", col("charged_read_mib") / w), 0, 0.01)) fail = 1
+	}
+}
+END {
+	if (nmixed == 0) { printf "RESULT=INCONCLUSIVE (no mixed phase in this measurement) evidence=%s\n", ev; exit 3 }
+	if (invalid) { printf "RESULT=INVALID (the read alone is off: the bench, not the module, is in question) evidence=%s\n", ev; exit 3 }
+	if (logdev == "no") {
+		printf "RESULT=INCONCLUSIVE (pool without a dedicated log: the checks %s, but they do not bite) evidence=%s\n", fail ? "fail" : "pass", ev
+		exit 3
+	}
+	if (fail) { printf "RESULT=FAIL evidence=%s\n", ev; exit 1 }
+	printf "RESULT=PASS (%d mixed phases, dedicated log present) evidence=%s\n", nmixed, ev
+}' "$EV/mixed.tsv"
diff --git a/tests/qos-gates/host/matrix_table.sh b/tests/qos-gates/host/matrix_table.sh
new file mode 100755
index 0000000000000000000000000000000000000000..62b3ee3fd1d35228bd97828d0d23822a78b7d55b
--- /dev/null
+++ b/tests/qos-gates/host/matrix_table.sh
@@ -0,0 +1,129 @@
+#!/bin/bash
+# SPDX-License-Identifier: CDDL-1.0
+#
+# matrix_table.sh — the bench's result table (protocol-test-zfs.md §14) from
+# the files host/run_matrix.sh left, one table per VM: the dataset without
+# limit for the five protocols, then the limited dataset with qos:boost 0 to
+# 4 for each protocol.
+#
+#   matrix_table.sh <evidence-root> <label> [--cap 5] [--vms "lnx bsd"]
+#       [--protos "local nfs cifs iscsi nvmeof"]
+#       [--jobs "2 5 10"] [--jprotos "local ..."] [--donor MIB]
+#
+# For each protocol and VM every <evidence-root>/matrix-<proto>-<vm>-<label>-
+# <stamp>/matrix.tsv is read, oldest first, and each row is taken from the
+# latest pass that has it: a row measured again under the label of the
+# campaign (run_matrix.sh --only-s0, for a row that gave no figure) replaces
+# the earlier one; a repeat made out of curiosity must use another label.
+# A cell is a rate (MB/s, as the bench
+# prints it) only when the bench gave a positive figure, the fio output of
+# that pattern has no error mark, the limits read back before and after the
+# row were the expected ones and fio ran the number of jobs asked for;
+# otherwise the cell is "—", as for a row that was not measured. The
+# directories read are listed above each table.
+#
+#   --jobs "2 5 10"  adds, after the rows above, the same rows of the limited
+#                    dataset measured with N fio threads (run_matrix.sh
+#                    --jobs N, directories <label>-jN-<stamp>), named benchN
+#                    in the Dataset column: N threads on dataset 1, not
+#                    another dataset. --jprotos limits these rows to some
+#                    protocols.
+#   --donor MIB      the rows of the limited dataset measured next to an idle
+#                    neighbour limited to MIB MiB/s (run_matrix.sh --donor,
+#                    directories <label>-dMIB-<stamp> and <label>-jN-dMIB-
+#                    <stamp>); the table then has no row without limit.
+
+set -uo pipefail
+usage() {
+	echo "usage: $0 <evidence-root> <label> [--cap MIB] [--vms \"lnx bsd\"] [--protos LIST]" \
+	    "[--jobs \"2 5 10\"] [--jprotos LIST] [--donor MIB]" >&2
+	exit 2
+}
+[ $# -ge 2 ] || usage
+EVROOT=$1; LABEL=$2; shift 2
+CAP=5; VMS="lnx bsd"; PROTOS="local nfs cifs iscsi nvmeof"; JOBS=; JPROTOS=; DONOR=
+while [ $# -gt 0 ]; do
+	case "$1" in
+	--cap) CAP=$2; shift 2 ;;
+	--vms) VMS=$2; shift 2 ;;
+	--protos) PROTOS=$2; shift 2 ;;
+	--jobs) JOBS=$2; shift 2 ;;
+	--jprotos) JPROTOS=$2; shift 2 ;;
+	--donor) DONOR=$2; shift 2 ;;
+	*) echo "unknown argument $1" >&2; usage ;;
+	esac
+done
+[ -n "$JPROTOS" ] || JPROTOS=$PROTOS
+DSUF=${DONOR:+-d$DONOR}
+
+for vm in $VMS; do
+	FILES=()
+	SRC=
+	add() { # add <directory pattern before the stamp>: its passes, oldest first
+		local d
+		for d in $(ls -d "$1"-2* 2>/dev/null | sort); do
+			if [ -f "$d/matrix.tsv" ]; then
+				FILES+=("$d/matrix.tsv")
+				SRC="$SRC $(basename "$d")"
+			fi
+		done
+	}
+	for p in $PROTOS; do
+		add "$EVROOT/matrix-$p-$vm-$LABEL$DSUF"
+	done
+	for n in $JOBS; do
+		for p in $JPROTOS; do
+			add "$EVROOT/matrix-$p-$vm-$LABEL-j$n$DSUF"
+		done
+	done
+	[ ${#FILES[@]} -gt 0 ] || FILES=(/dev/null)
+	echo "vm=$vm label=$LABEL${DONOR:+ idle neighbour limited to $DONOR MiB/s} sources:${SRC:- none}"
+	# "~" and "@" stand for the dash and the infinity sign while the cells
+	# are padded: both are one column wide but several bytes long
+	awk -F'\t' -v protos="$PROTOS" -v jprotos="$JPROTOS" -v jobs="$JOBS" -v cap="$CAP" -v donor="$DONOR" '
+	function cell(v, e, ok, asked, ran) {
+		return (v ~ /^[0-9.]+$/ && v + 0 > 0 && e == "0" && ok == "yes" && asked == ran) ? v : "~"
+	}
+	function line(test, ds, q, b, qm, k) {
+		printf "│ %-9s │ %-7s │ %-5s │ %-5s │ %-7s │ %-9s │ %-8s │ %-10s │ %-9s │\n",
+		    test, ds, q, b, qm,
+		    (k in have) ? sw[k] : "~", (k in have) ? sr[k] : "~",
+		    (k in have) ? rw[k] : "~", (k in have) ? rr[k] : "~"
+	}
+	function block(list, name, j,    n, i, b, P) {
+		n = split(list, P, " ")
+		for (i = 1; i <= n; i++) {
+			line(P[i], name, cap, "0", cap, P[i] SUBSEP j SUBSEP "s1")
+			for (b = 1; b <= 4; b++)
+				line(P[i], name, cap, "+" b "00%", cap * (1 + b), P[i] SUBSEP j SUBSEP "s2b" b)
+		}
+	}
+	FNR == 1 { next }
+	{
+		# files written before the thread variant have 22 columns: one job
+		asked = (NF >= 24) ? $23 : 1; ran = (NF >= 24) ? $24 : 1
+		k = $1 SUBSEP asked SUBSEP $4; have[k] = 1
+		sw[k] = cell($8, $12, $16, asked, ran); sr[k] = cell($9, $13, $16, asked, ran)
+		rw[k] = cell($10, $14, $16, asked, ran); rr[k] = cell($11, $15, $16, asked, ran)
+	}
+	END {
+		n = split(protos, P, " ")
+		print "┌───────────┬─────────┬───────┬───────┬─────────┬───────────┬──────────┬────────────┬───────────┐"
+		print "│   Test    │ Dataset │  qos  │ boost │ qos max │ seq_write │ seq_read │ rand_write │ rand_read │"
+		print "│           │         │ MiB/s │ %     │ MiB/s   │ MB/s      │ MB/s     │ MB/s       │ MB/s      │"
+		sep = "├───────────┼─────────┼───────┼───────┼─────────┼───────────┼──────────┼────────────┼───────────┤"
+		print sep
+		if (donor == "") {
+			for (i = 1; i <= n; i++)
+				line(P[i], "bench0", "0", "0", "@", P[i] SUBSEP 1 SUBSEP "s0")
+			print sep
+		}
+		block(protos, "bench1", 1)
+		m = split(jobs, J, " ")
+		for (i = 1; i <= m; i++) {
+			print sep
+			block(jprotos, "bench" J[i], J[i])
+		}
+		print "└───────────┴─────────┴───────┴───────┴─────────┴───────────┴──────────┴────────────┴───────────┘"
+	}' "${FILES[@]}" | sed -e 's/~/—/g' -e 's/@/∞/g'
+done
diff --git a/tests/qos-gates/host/run_g10.sh b/tests/qos-gates/host/run_g10.sh
