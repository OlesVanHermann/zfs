#!/bin/bash
# qos_env.sh — Configuration centralisée pour toute la suite QoS
# Source par full_setup.sh, verify_all.sh, chain_*.sh

# ─── Connexions VM ────────────────────────────────────────────────────
LNX_VM_IP=192.168.122.187
BSD_VM_IP=192.168.122.71
LNX_VM_HOST=zfs-qos
BSD_VM_HOST=zfs-qos-bsd
# Chemin absolu, pas $HOME : sous sudo, $HOME=/root et la clé n'y est pas
# (incident 2026-07-05 : 2 runs full_setup en cascade FAIL, SSH refusé partout).
SSH_KEY="${QOS_SSH_KEY:-/home/ubuntu/.ssh/id_ed25519_new}"
SSH_OPTS="-o StrictHostKeyChecking=no -o BatchMode=yes -o ConnectTimeout=10"
LNX_SSH="ssh -i $SSH_KEY $SSH_OPTS ubuntu@$LNX_VM_IP"
BSD_SSH="ssh -i $SSH_KEY $SSH_OPTS freebsd@$BSD_VM_IP"

# ─── Libvirt VM names ─────────────────────────────────────────────────
LNX_VM_NAME="zfs-qos"
BSD_VM_NAME="zfs-qos-bsd"

# ─── Pool ──────────────────────────────────────────────────────────────
POOL=testqos

# ─── Datasets filesystem (shared across LOCAL, NFS, CIFS) ─────────────
DS_BENCH=(bench0 bench1 bench2 bench3 bench4 bench5)

# ─── Datasets zvol — iSCSI (2G each) ──────────────────────────────────
DS_ISCSI=(iscsi0 iscsi1 iscsi2 iscsi3 iscsi4 iscsi5)
ISCSI_ZVOL_SIZE=2G

# ─── Datasets zvol — NVMe-oF ──────────────────────────────────────────
DS_NVME_LNX=(nvme0 nvme1 nvme2 nvme3 nvme4 nvme5)       # 512M on Linux VM
DS_NVME_BSD=(nvmeof0 nvmeof1 nvmeof2 nvmeof3 nvmeof4 nvmeof5)  # on FreeBSD VM
NVME_ZVOL_SIZE=512M

# ─── iSCSI targets ────────────────────────────────────────────────────
LNX_ISCSI_IQN="iqn.2026-04.com.qos:bench"
BSD_ISCSI_IQN="iqn.2026-04.local.zfs-qos-bsd:target0"
ISCSI_PORT=3260

# ─── NVMe-oF ──────────────────────────────────────────────────────────
LNX_NVME_NQN="nqn.2026-04.local.zfs-qos-linux:nvme"
BSD_NVME_NQN="nqn.2026-04.local.zfs-qos-bsd:nvme"
NVME_PORT=4420

# ─── CIFS ──────────────────────────────────────────────────────────────
CIFS_USER=qosuser
CIFS_PASS=CHANGE_ME
CIFS_CREDS=/root/.cifs-qos

# ─── Host mount base paths ────────────────────────────────────────────
MNT_NFS_LNX=/mnt/lnx/nfs
MNT_NFS_BSD=/mnt/bsd/nfs
MNT_CIFS_LNX=/mnt/lnx/cifs
MNT_CIFS_BSD=/mnt/bsd/cifs
MNT_ISCSI_LNX=/mnt/lnx/iscsi
MNT_ISCSI_BSD=/mnt/bsd/iscsi
MNT_NVME_LNX=/mnt/lnx/nvmeof
MNT_NVME_BSD=/mnt/bsd/nvmeof

# ─── NFS mount options ────────────────────────────────────────────────
NFS_LNX_OPTS="rw,soft,timeo=50,retrans=2,noac"
NFS_BSD_OPTS="rw,soft,timeo=50,retrans=3,vers=3"

# ─── CIFS mount options ───────────────────────────────────────────────
CIFS_MOUNT_OPTS="credentials=$CIFS_CREDS,vers=3.0,uid=$(id -u),gid=$(id -g),forceuid,forcegid,rw,noperm,soft,echo_interval=10,handletimeout=60,actimeo=0"

# ─── Test parameters ──────────────────────────────────────────────────
FIO_SIZE_DEFAULT=192M
FIO_SIZE_NVME=128M
DUR_DEFAULT=60

# ─── Colors ────────────────────────────────────────────────────────────
RED=$'\e[31m'; GRN=$'\e[32m'; YEL=$'\e[33m'; CYN=$'\e[36m'; RST=$'\e[0m'

# ─── Helpers ───────────────────────────────────────────────────────────
log_ok()   { echo "  ${GRN}OK${RST}   $*"; }
log_fail() { echo "  ${RED}FAIL${RST} $*"; }
log_warn() { echo "  ${YEL}WARN${RST} $*"; }
log_info() { echo "  ${CYN}INFO${RST} $*"; }

section() {
    echo ""
    echo "══════════════════════════════════════════════════════════════"
    echo "  $*"
    echo "══════════════════════════════════════════════════════════════"
}
